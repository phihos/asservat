+/* One shared session budget, never a per-CPU or per-container allowance.
+ * The loader freezes this map and syscalls before exposing perf namespaces. */
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(max_entries, 1);
+	__type(key, __u32);
+	__type(value, struct asservat_argument_budget);
+} asservat_budget SEC(".maps");
