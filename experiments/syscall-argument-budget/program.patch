+static __always_inline bool asservat_probe_allowed(struct syscall_def_t *def,
+						 bool exiting)
+{
+	__u32 zero = 0;
+	__u64 bytes = 256;
+#pragma unroll
+	for (int n = 0; n < SYSCALL_ARGS; n++) {
+		__u64 len = def->args_len[n];
+		bool at_exit = !!(len & PARAM_PROBE_AT_EXIT_MASK);
+		if (len && at_exit == exiting &&
+		    (exiting || len != USE_RET_AS_PARAM_LENGTH))
+			/* Reserve256 per eligible argument conservatively even
+			 * though the fixed branch below invokes one128-byte helper.
+			 * Observation credit is separate from actual read length. */
+			bytes += 2 * PARAM_LEN;
+	}
+	return asservat_reserve_probe(bpf_map_lookup_elem(&asservat_budget, &zero),
+				     bytes, bpf_ktime_get_boot_ns());
+}
