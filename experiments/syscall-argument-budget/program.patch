+/* Argument object v1 only. CO-RE resolution must find these fields; no
+ * zero identity fallback. Native x86-64 only (IA32 CS differs, x32 numbers
+ * are outside the fixed syscall filter). Kernel reads are not user reads. */
+static __always_inline bool asservat_identity(struct syscall_event_t *sc,
+                                             struct bpf_raw_tracepoint_args *ctx)
+{
+	struct task_struct *task = (void *)bpf_get_current_task();
+	struct task_struct *leader = BPF_CORE_READ(task, group_leader);
+	if (BPF_CORE_READ((struct pt_regs *)ctx->args[0], cs) != 0x33)
+		return false;
+	sc->tid = (__u32)bpf_get_current_pid_tgid();
+	sc->identity_version = 1;
+	sc->task_start_ns = BPF_CORE_READ(task, start_boottime);
+	sc->process_start_ns = BPF_CORE_READ(leader, start_boottime);
+	return sc->tid && sc->task_start_ns && sc->process_start_ns;
+}
