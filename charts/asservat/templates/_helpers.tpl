{{/* Object name prefix: .Values.installation.name (default asservat). */}}
{{- define "asservat.name" -}}
{{- .Values.installation.name -}}
{{- end -}}

{{/* "<name>-<component>"; call with (list $ "component"). */}}
{{- define "asservat.fullname" -}}
{{- $root := index . 0 -}}
{{- printf "%s-%s" (include "asservat.name" $root) (index . 1) -}}
{{- end -}}

{{/* Common labels; call with (list $ "component"). */}}
{{- define "asservat.labels" -}}
{{- $root := index . 0 }}
app.kubernetes.io/name: asservat
app.kubernetes.io/instance: {{ $root.Release.Name | quote }}
app.kubernetes.io/component: {{ index . 1 | quote }}
app.kubernetes.io/part-of: asservat
app.kubernetes.io/managed-by: {{ $root.Release.Service | quote }}
helm.sh/chart: {{ printf "%s-%s" $root.Chart.Name $root.Chart.Version | replace "+" "_" | quote }}
{{- end -}}

{{/* Stable selector labels; call with (list $ "component"). */}}
{{- define "asservat.selectorLabels" -}}
{{- $root := index . 0 }}
app.kubernetes.io/name: asservat
app.kubernetes.io/instance: {{ $root.Release.Name | quote }}
app.kubernetes.io/component: {{ index . 1 | quote }}
{{- end -}}

{{/* The product image, referenced only by digest. */}}
{{- define "asservat.image" -}}
{{- $i := .Values.image -}}
{{- if or (not $i.repository) (not (regexMatch "^sha256:[a-f0-9]{64}$" $i.digest)) -}}
{{- fail "image.repository and image.digest (sha256:<64 hex>) are required" -}}
{{- end -}}
{{- printf "%s@%s" $i.repository $i.digest -}}
{{- end -}}

{{/* Pod-level image settings: pull secrets. */}}
{{- define "asservat.imagePullSecrets" -}}
{{- with .Values.image.pullSecrets }}
imagePullSecrets:
{{- range . }}
  - name: {{ . | quote }}
{{- end }}
{{- end }}
{{- end -}}

{{/* Pod Security restricted, pod level. */}}
{{- define "asservat.podSecurityContext" -}}
runAsNonRoot: true
runAsUser: 65532
runAsGroup: 65532
fsGroup: 65532
seccompProfile:
  type: RuntimeDefault
{{- end -}}

{{/* Pod Security restricted, container level. */}}
{{- define "asservat.securityContext" -}}
allowPrivilegeEscalation: false
readOnlyRootFilesystem: true
capabilities:
  drop: [ALL]
{{- end -}}

{{/* Container resources of a hub component; call with (list $ "hub-api"). */}}
{{- define "asservat.resources" -}}
{{- $root := index . 0 -}}
{{- $c := default dict (index $root.Values.hub (index . 1)) -}}
{{- if $c.resources -}}
{{- toYaml $c.resources -}}
{{- else -}}
{{- include "asservat.jobResources" $root -}}
{{- end -}}
{{- end -}}

{{/* nodeSelector/tolerations of a hub component; call with (list $ "hub-api"). */}}
{{- define "asservat.placement" -}}
{{- $root := index . 0 -}}
{{- $c := default dict (index $root.Values.hub (index . 1)) -}}
{{- with $c.nodeSelector }}
nodeSelector: {{ toYaml . | nindent 2 }}
{{- end }}
{{- with $c.tolerations }}
tolerations: {{ toYaml . | nindent 2 }}
{{- end }}
{{- end -}}

{{/* Small fixed resources for finite Jobs and init containers. */}}
{{- define "asservat.jobResources" -}}
requests:
  cpu: 20m
  memory: 32Mi
limits:
  cpu: "1"
  memory: 256Mi
{{- end -}}

{{/* checksum/config annotation over rendered templates; call with
     (list $ "hub-api-config.yaml" ...) naming files under templates/. */}}
{{- define "asservat.checksum" -}}
{{- $root := index . 0 -}}
{{- $sum := "" -}}
{{- range $file := rest . -}}
{{- $sum = printf "%s%s" $sum (include (print $root.Template.BasePath "/" $file) $root | sha256sum) -}}
{{- end -}}
checksum/config: {{ $sum | sha256sum | quote }}
{{- end -}}

{{/* Name of a generated Secret, or its existingSecret override; call with
     (list $ "ids"), (list $ "sql-hub-api"), (list $ "s3-owner-audit"). */}}
{{- define "asservat.secretName" -}}
{{- $root := index . 0 -}}
{{- $key := index . 1 -}}
{{- $o := default dict (index (default dict $root.Values.secrets) $key) -}}
{{- default (printf "%s-%s" (include "asservat.name" $root) $key) $o.existingSecret -}}
{{- end -}}

{{/* True ("true") when a Secret is generated by the secrets hook. */}}
{{- define "asservat.secretGenerated" -}}
{{- $root := index . 0 -}}
{{- $o := default dict (index (default dict $root.Values.secrets) (index . 1)) -}}
{{- if not $o.existingSecret }}true{{ end -}}
{{- end -}}

{{/* The IDs Secret, mounted by every hub component at /run/asservat/ids. */}}
{{- define "asservat.idsVolume" -}}
- name: ids
  secret:
    secretName: {{ include "asservat.secretName" (list . "ids") | quote }}
    defaultMode: 0440
{{- end -}}

{{- define "asservat.idsMount" -}}
- name: ids
  mountPath: /run/asservat/ids
  readOnly: true
{{- end -}}

{{/* Init container that waits until `asservat setup` has applied the
     current schema: `asservat setup --wait-schema`. Call with (dict "root" $
     "config" "/run/.../config.json" "credential" "/run/.../sql-x.json"
     "ca" "/run/.../postgres-ca.crt" "volumeMounts" (list ...)): the
     component's config (top-level postgres{host,port,database}), one of its
     SQL credentials and the PostgreSQL CA, all from its own mounts. */}}
{{- define "asservat.waitSchema" -}}
{{- $root := .root -}}
- name: wait-schema
  image: {{ include "asservat.image" $root | quote }}
  imagePullPolicy: {{ $root.Values.image.pullPolicy }}
  command: [/asservat, setup, --wait-schema, --config, {{ .config | quote }}, --credential, {{ .credential | quote }}, --ca, {{ .ca | quote }}]
  securityContext: {{ include "asservat.securityContext" $root | nindent 4 }}
  resources: {{ include "asservat.jobResources" $root | nindent 4 }}
  {{- with .volumeMounts }}
  volumeMounts: {{ toYaml . | nindent 4 }}
  {{- end }}
{{- end -}}

{{/* Selected providers as JSON: postgres{host,port,database},
     objectStore{endpoint,region,auditBucket,evidenceBucket},
     openBao{endpoint}; bundled service addresses or services.*.external. */}}
{{- define "asservat.providers" -}}
{{- $n := include "asservat.name" . -}}
{{- $ns := .Release.Namespace -}}
{{- $s := .Values.services -}}
{{- $out := dict -}}
{{- if eq $s.postgres.provider "bundled" -}}
{{- $_ := set $out "postgres" (dict "host" (printf "%s-postgres.%s.svc" $n $ns) "port" 5432 "database" "asservat") -}}
{{- else -}}
{{- $e := $s.postgres.external -}}
{{- $_ := set $out "postgres" (dict "host" (required "services.postgres.external.host is required" $e.host) "port" (int (default 5432 $e.port)) "database" (default "asservat" $e.database)) -}}
{{- end -}}
{{- if eq $s.objectStore.provider "seaweedfs" -}}
{{- $_ := set $out "objectStore" (dict "endpoint" (printf "https://%s-objectstore.%s.svc:8333" $n $ns) "region" "us-east-1" "auditBucket" (printf "%s-audit" $n) "evidenceBucket" (printf "%s-evidence" $n)) -}}
{{- else -}}
{{- $e := $s.objectStore.external -}}
{{- $_ := set $out "objectStore" (dict "endpoint" (required "services.objectStore.external.endpoint is required" $e.endpoint) "region" (required "services.objectStore.external.region is required" $e.region) "auditBucket" (required "services.objectStore.external.bucket is required" $e.bucket) "evidenceBucket" (default $e.bucket $e.evidenceBucket)) -}}
{{- end -}}
{{- if eq $s.keyService.provider "openbao" -}}
{{- $_ := set $out "openBao" (dict "endpoint" (printf "https://%s-openbao.%s.svc:8200" $n $ns)) -}}
{{- else -}}
{{- $_ := set $out "openBao" (dict "endpoint" (required "services.keyService.external.endpoint is required" $s.keyService.external.endpoint)) -}}
{{- end -}}
{{- toJson $out -}}
{{- end -}}

{{/* One projected-volume source with a provider's PEM CA at path. Call with
     (dict "root" $ "provider" "postgres|objectStore|openBao" "path" "x.crt").
     Bundled: the service's `<name>-<service>-state` Secret (ca.crt);
     external: `<name>-provider-roots` (from services.*.external.rootsPEM). */}}
{{- define "asservat.providerRoots" -}}
{{- $root := .root -}}
{{- $n := include "asservat.name" $root -}}
{{- $s := $root.Values.services -}}
{{- $bundled := dict "postgres" (eq $s.postgres.provider "bundled") "objectStore" (eq $s.objectStore.provider "seaweedfs") "openBao" (eq $s.keyService.provider "openbao") -}}
{{- $state := dict "postgres" "postgres" "objectStore" "objectstore" "openBao" "openbao" -}}
{{- if get $bundled .provider }}
- secret:
    name: {{ printf "%s-%s-state" $n (get $state .provider) | quote }}
    items: [{key: ca.crt, path: {{ .path | quote }}}]
{{- else }}
- configMap:
    name: {{ printf "%s-provider-roots" $n | quote }}
    items: [{key: {{ printf "%s.crt" .provider | quote }}, path: {{ .path | quote }}}]
{{- end }}
{{- end -}}

{{/* OpenBao chart constants shared with `asservat setup`
     (contracts.SmallOpenBao*): auth mounts, the static provider token
     audiences and the role name `<name>-<component>-<purpose>`. Key and PKI
     role names derive from the installation ID at runtime
     (providerconfig.OpenBaoNamesFor) and are not rendered. */}}
{{- define "asservat.openBao" -}}
{{- toJson (dict
  "configurationAuthMount" "asservat-configuration"
  "ownerAuthMount" "asservat-owner"
  "auditMount" "asservat-audit"
  "transitMount" "public-transit"
  "ownerPKIMount" "owner-pki"
  "connectorPKIMount" "connector-pki"
  "workerPKIMount" "worker-pki"
  "bootstrapMount" "fleet-bootstrap"
  "hubWorkerAudience" "asservat-configuration-provider"
  "hubAPIAudience" "asservat-owner-provider"
  "federationAudience" "asservat-federation-provider"
  "publisherAudience" "asservat-publisher-provider"
) -}}
{{- end -}}

{{- define "asservat.openBaoRole" -}}
{{- printf "%s-%s-%s" (include "asservat.name" (index . 0)) (index . 1) (index . 2) -}}
{{- end -}}

{{/* The origin's host without scheme; fails for an origin with a port when
     a route must derive its host from it. */}}
{{- define "asservat.originHost" -}}
{{- $u := urlParse (required "origin is required for an Ingress or HTTPRoute" .Values.origin) -}}
{{- if ne $u.scheme "https" }}{{ fail "origin must be an https URL" }}{{ end -}}
{{- if contains ":" $u.host }}{{ fail "origin must not carry a port when exposure.ingress or exposure.httpRoute is enabled" }}{{ end -}}
{{- $u.host -}}
{{- end -}}

{{/* Value checks shared by every template. */}}
{{- define "asservat.validate" -}}
{{- if not (has .Values.mode (list "hub" "cluster" "combined")) }}{{ fail "mode must be hub, cluster or combined" }}{{ end -}}
{{- if and .Values.capacity .Values.federation -}}
{{- with .Values.federation.connector -}}
{{- $backup := $.Values.capacity.backup -}}
{{- $minimum := add 1800 (mul 2 (int64 $backup.horizonSeconds)) (mul 3 (int64 $backup.cleanupBudgetSeconds)) (int64 $backup.proofWindowSeconds) 60 -}}
{{- if lt (int64 .retainedSeconds) $minimum }}{{ fail "federation.connector.retainedSeconds must cover a 1800-second connector process run + 2*capacity.backup.horizonSeconds + 3*capacity.backup.cleanupBudgetSeconds + capacity.backup.proofWindowSeconds + 60" }}{{ end -}}
{{- end -}}
{{- end -}}
{{- $s := .Values.services -}}
{{- if and (eq .Values.mode "cluster") (or (eq $s.postgres.provider "bundled") (eq $s.identity.provider "keycloak") (eq $s.objectStore.provider "seaweedfs") (eq $s.keyService.provider "openbao")) }}{{ fail "bundled hub services require mode hub or combined" }}{{ end -}}
{{- if and (eq .Values.services.objectStore.provider "seaweedfs") .Values.secrets -}}
{{- range $key, $_ := .Values.secrets }}{{ if hasPrefix "s3-" $key }}{{ fail "bundled SeaweedFS generates its own s3-* Secrets; remove the existingSecret override" }}{{ end }}{{ end -}}
{{- end -}}
{{- end -}}

{{/* True for a release that runs the hub (mode hub or combined). */}}
{{- define "asservat.hub" -}}
{{- if ne .Values.mode "cluster" }}true{{ end -}}
{{- end -}}
