+	}
+	f.f.api.mu.Unlock()
+	out, err := f.producer.ReadObservationParticipants(context.Background())
+	if err == nil || out.Owner.Valid() || out.Caller.Pin.Valid() {
+		t.Fatal("final replacement gained original participant provenance")
+	}
