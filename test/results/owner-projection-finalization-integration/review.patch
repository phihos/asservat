+		return zero, err
+	}
+	if err = s.checkLaunch(actual); err != nil {
+		return zero, err
+	}
+	out, err := s.copyRoles(ctx, root)
+	if err == nil {
+		s.phase.Store(2)
+	}
+	return out, err
+}
