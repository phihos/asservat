+
+func (s *ownerInstallationDelayedJoin) Value(any) any { return nil }
+func (s *ownerInstallationDelayedJoin) AfterFunc(f func()) func() bool {
+	s.mu.Lock()
+	first := !s.first
+	s.first = true
+	s.mu.Unlock()
+	stop := context.AfterFunc(s.Context, f)
+	return func() bool {
+		if first {
+			close(s.entered)
+			<-s.release
+		}
+		return stop()
+	}
