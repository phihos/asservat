+	if f.current.retained.resources.State.Objects[0].OperationID == "caller-copy" {
+		t.Fatal("returned state aliases handle")
+	}
+	if _, err = f.OwnerProjectionFinalizationResult(ctx, root); err == nil {
+		t.Fatal("result reusable")
+	}
+}
