+func TestOwnerProjectionFinalizerCloseJoinsAdmittedWork(t *testing.T) {
+	f, root, ctx, _ := projectionFinalizationHandle(t)
+	if err := f.enter(ctx, root, 0, 10); err != nil {
+		t.Fatal(err)
+	}
