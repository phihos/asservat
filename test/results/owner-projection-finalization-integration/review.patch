+// Retained opaque handles cannot let an asynchronous read outlive the owning
+// SQL callback, root/resource borrow, or clearing of reconstructed credentials.
+func (s *OwnerProjectionFinalization) closeAndJoin() {
+	s.mu.Lock()
+	s.closed = true
+	s.cancel()
+	s.mu.Unlock()
+	s.work.Wait()
+}
