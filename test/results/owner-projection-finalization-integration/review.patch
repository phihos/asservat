+	if err != nil || initialHandoverDeadline(ctx, root.resources.now, s.until) != nil {
+		return zero, cfg.ErrUnavailable
+	}
+	out := s.current.roles
+	out.State = state
+	out.ValidUntil = s.until
+	return out, nil
