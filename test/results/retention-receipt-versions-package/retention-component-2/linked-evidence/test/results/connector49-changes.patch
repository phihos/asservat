+CREATE FUNCTION lock_connector_process_current(r uuid,c jsonb,allow_candidate boolean) RETURNS public.connector_identity_profile LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $$
