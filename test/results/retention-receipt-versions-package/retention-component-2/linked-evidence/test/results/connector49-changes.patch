+CREATE FUNCTION admit_connector_credential(r uuid,c jsonb,i jsonb,permit_value jsonb) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,pg_temp AS $$
