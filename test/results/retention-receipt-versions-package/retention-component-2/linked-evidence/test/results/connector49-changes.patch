+	}
+	history := *policy.History
+	policy.History = &history
+	j := &OperationJournal{ledger: l, root: policy.RootID, lane: "identity", recovery: recovery, lifecycle: &policy}
+	return &OperationLifecycles{journal: j, connector: true}, nil
+}
