+	}
+	if _, e := c.snapshot(0); e == nil {
+		t.Fatal("partial pair exposed after close")
+	}
+}
+func TestConnectorPairedCredentialsActualDistinctTLS(t *testing.T) {
+	f := newConnectorPairFixture(t)
+	c := f.owner()
+	if e := c.Reconcile(context.Background()); e != nil {
+		t.Fatal(e)
