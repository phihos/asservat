+		return false
+	}
+	total := len(c.DER)
+	for _, der := range c.ChainDER {
+		total += len(der)
+		if len(der) < 1 || len(der) > 16<<10 || total > 32<<10 {
+			return false
+		}
+	}
+	return true
+}
