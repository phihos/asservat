+	c.Source.Observation.FreshUntil = f.process.now.Add(5 * time.Second)
+	if !f.sourceUntil.IsZero() {
+		c.Source.Observation.FreshUntil = identity.Earlier(c.Source.Observation.FreshUntil, f.sourceUntil)
+	}
