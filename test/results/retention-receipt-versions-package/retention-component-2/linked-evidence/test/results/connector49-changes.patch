+			}
+		},
+		"blocking proof expires original operation": func(f *connectorProcessFixture) {
+			f.proofHook = func(f *connectorProcessFixture) {
+				if f.proofReads == 2 {
+					f.now = f.now.Add(6 * time.Second)
+				}
+			}
+		},
+	}
+	for name, change := range cases {
+		t.Run(name, func(t *testing.T) {
