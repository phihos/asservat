{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/public-runtime-credentials.schema.json",
  "title": "Immutable public runtime role provenance",
  "description": "Protected projection paired with fixed runtime credentials. Original claims are historical role identity only; no source, recovery or operation authority. Startup authenticates each exact SQL role and checks actual identity, ACLs and provenance before any listener bind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "input",
    "rootUID",
    "setupID",
    "roles"
  ],
  "properties": {
    "format": {
      "const": "asservat-public-runtime-credentials/v1"
    },
    "input": {
      "$ref": "https://asservat.io/spec/v1/public-runtime-roles.schema.json"
    },
    "rootUID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "setupID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "roles": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "claim",
          "receipt"
        ],
        "properties": {
          "purpose": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/purpose"
          },
          "claim": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/claim"
          },
          "receipt": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/receipt"
          }
        }
      }
    }
  }
}
