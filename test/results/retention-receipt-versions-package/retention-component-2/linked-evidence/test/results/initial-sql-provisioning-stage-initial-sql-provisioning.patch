+			}
+			if replayErr == nil && got.Secret.UID == "" {
+				t.Fatal("lost original SQL Secret identity")
+			}
+			expected := int32(1)
+			if mode == "claim-after" {
+				expected = 0
+			}
+			if creates.Load() != expected {
+				t.Fatal("unknown SQL effect repeated", mode, creates.Load())
+			}
+		})
+	}
