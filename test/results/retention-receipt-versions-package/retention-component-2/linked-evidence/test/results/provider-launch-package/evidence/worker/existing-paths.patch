+		if v != nil {
+			v.value.destroy()
+		}
+	}
+	s.control.close()
+	s.mu.Lock()
+	s.current, s.draining = nil, nil
+	s.finished, s.closing = true, false
+	s.signalLocked()
+	s.mu.Unlock()
