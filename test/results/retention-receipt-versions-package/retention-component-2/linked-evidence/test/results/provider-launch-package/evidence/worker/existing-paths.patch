+func TestConfigurationWorkerOpaqueLaterPhaseCannotReextendAdmittedDeadline(t *testing.T) {
+	owner, p := configurationWorkerOperationFixture(t)
+	short, stop := context.WithTimeout(p.ctx, 80*time.Millisecond)
+	defer stop()
+	expected, _ := short.Deadline()
+	_, finish, err := p.enterPhase(short, owner.roles, configurationWorkerPhaseUninitialized, configurationWorkerPhaseInitial)
+	if err != nil {
+		t.Fatal(err)
+	}
+	finish(nil)
+	// Use the original context deliberately. It still has nearly five seconds,
+	// but cannot replace the shorter end admitted by the preceding phase.
+	call, finish, err := p.enterPhase(p.ctx, owner.roles, configurationWorkerPhaseInitial, configurationWorkerPhaseIntent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	until, _ := call.Deadline()
+	if !until.Equal(expected) || !p.until.Equal(expected) {
+		finish(context.Canceled)
+		t.Fatal("later phase reextended an earlier admitted deadline")
+	}
+	finish(nil)
+	<-short.Done()
+	if _, done, err := p.enterPhase(p.ctx, owner.roles, configurationWorkerPhaseIntent, configurationWorkerPhasePostLock); err == nil || done != nil {
+		if done != nil {
+			done(context.Canceled)
+		}
+		t.Fatal("expired shorter phase acquired a fresh effect interval")
+	}
+}
