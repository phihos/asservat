+		t.Fatal("qualified zero-history admission rejected")
+	}
+	p.WALReservedBytes--
+	if p.Valid() {
+		t.Fatal("under-backed verifier transitions accepted")
+	}
+	p.WALReservedBytes++
+	q.Layout = "operation-audit-history/v4"
