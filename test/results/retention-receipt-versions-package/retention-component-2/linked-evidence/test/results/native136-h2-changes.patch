+	f.calls++
+	f.until = until
+	if f.finished != 1 || f.notified != 1 || f.status != DownloadContentReady || f.batches != 1 || f.begins != 0 || f.emitted != 0 {
+		return errors.New("body setup outside acknowledged phase boundary")
