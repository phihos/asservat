+// Test-only phase diagnostics: frame kind, duration and fixed errors, no bytes,
+// credentials or authority changes. The underlying actual reader/stream is used.
+type nativeSQLReadDiagnostic struct {
+	test *testing.T
+	next evidence.NativeContextRead
+}
+
+func (d nativeSQLReadDiagnostic) ReadNativeContext(ctx context.Context, source evidence.NativeContextSource, o value.NativeOperation, window string, until time.Time) ([]byte, error) {
+	started := time.Now()
+	d.test.Log("native read entered", time.Until(until))
+	body, err := d.next.ReadNativeContext(ctx, source, o, window, until)
+	d.test.Log("native read returned", time.Since(started), time.Until(until), err, ctx.Err())
+	return body, err
+}
+
+type nativeSQLStreamDiagnostic struct {
+	native.Stream
+	test *testing.T
+}
+
+func (d nativeSQLStreamDiagnostic) Receive(ctx context.Context) (contracts.NativeFrame, error) {
+	started := time.Now()
+	f, err := d.Stream.Receive(ctx)
+	d.test.Log("native frame received", f.Kind, time.Since(started), err, ctx.Err())
+	return f, err
+}
+func (d nativeSQLStreamDiagnostic) Send(ctx context.Context, f contracts.NativeFrame) error {
+	started := time.Now()
+	err := d.Stream.Send(ctx, f)
+	d.test.Log("native frame sent", f.Kind, time.Since(started), err, ctx.Err())
+	return err
+}
