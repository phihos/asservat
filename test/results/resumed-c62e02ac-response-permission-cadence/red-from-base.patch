+func TestContextNativeResponseCheckedMetadataDoesNotReconstructAuthority(t *testing.T) {
+	f, sql, runtime, expected := warmContextRuntimeFixture(t)
+	source, err := NewContextNativeResponse(t.Context(), runtime)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer source.Close()
