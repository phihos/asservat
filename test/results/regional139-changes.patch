+	standby, stop := context.WithTimeout(ctx, 30*time.Second)
+	exchange, e := s.client.OpenDiscovered(standby, s.owner, candidates)
+	if e != nil {
+		stop()
+		t.Fatalf("actual shared NativePort standby elapsed=%s error=%v", time.Since(n), e)
