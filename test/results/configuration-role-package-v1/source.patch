+		}
+		r.value.State.Roles = append(r.value.State.Roles, contracts.PublicRuntimeRoleMaterial{Purpose: p, Password: base64.RawURLEncoding.EncodeToString(b)})
+		clear(b)
+	}
+	return r
+}
