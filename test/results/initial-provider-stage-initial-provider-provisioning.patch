+	}
+	names := []string{p.IssuerPolicy, p.WrapRole, p.WrapPolicy, p.UnwrapRole, p.UnwrapPolicy}
+	seen := map[string]bool{}
+	for _, name := range names {
+		if !initialProviderName.MatchString(name) || seen[name] || name == "root" || name == "default" {
+			return false
+		}
+		seen[name] = true
+	}
+	return true
+}
