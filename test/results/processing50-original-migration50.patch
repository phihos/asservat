+ retire_by timestamptz NOT NULL CHECK(isfinite(retire_by) AND retire_by>valid_until),
+ outcome_json jsonb NOT NULL CHECK(jsonb_typeof(outcome_json)='object' AND octet_length(outcome_json::text)<=2048),
