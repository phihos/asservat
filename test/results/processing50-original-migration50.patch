+	snapshot, p, e := readProcessingSnapshot(ctx, q, a.Scope.RootID, a.Environment.InstallationID, a.Environment.RecoveryEpoch, a.Scope.ArtifactID, expected.ObservedAt, expected.ValidUntil)
