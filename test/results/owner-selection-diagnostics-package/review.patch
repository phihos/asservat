+type ownerDiagnosticBridgeEffects struct {
+	*rootPinEffectFixture
+	after bool
+	cause error
+	calls int
+}
+
+func (s *ownerDiagnosticBridgeEffects) WithInitialRuntimeBridge(ctx context.Context, run func(context.Context) error) error {
+	s.calls++
+	if s.after {
+		if err := run(ctx); err != nil {
+			return err
+		}
+	}
+	return s.cause
+}
