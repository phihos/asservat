+	RootsPEM   string `json:"rootsPEM"`
+}
+
+func DecodeInitialBootstrapInput(r io.Reader) (InitialBootstrapInput, error) {
+	return decodeClosedRPC[InitialBootstrapInput](r, InitialBootstrapMaxBytes)
+}
