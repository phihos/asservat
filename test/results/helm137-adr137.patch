+
+type helmBootstrapOutput struct{ bytes.Buffer }
+
+func (b *helmBootstrapOutput) Write(p []byte) (int, error) {
+	n := len(p)
+	if b.Len() < 32<<10 {
+		p = p[:min(len(p), (32<<10)-b.Len())]
+		_, _ = b.Buffer.Write(p)
+	}
+	return n, nil
+}
