+	if e = f.admin.QueryRow(ctx, "SELECT count(*),COALESCE(sum(used_roles),0) FROM download_native_key WHERE worker_id=$1", target.WorkerID).Scan(&windows, &used); e != nil || windows != 1 || used != 7 {
