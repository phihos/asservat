+func TestContextStreamDiagnosticOriginalHubIdentityAndJoinedAttachment(t *testing.T) {
+	w, _ := identityFixture()
+	router, e := NewRouter(RouterLimits{Standby: 1, Captures: 1, Clusters: []ClusterLimit{{ClusterID: w.Work.Target.ClusterID, Standby: 1, Captures: 1}}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	ctx, cancel := context.WithDeadline(context.Background(), w.ValidUntil)
+	defer cancel()
+	ctx, record := NewStreamDiagnosticContext(ctx)
+	receiver := fleet.APIContextReceiver{Channel: w.Work.Channel, ObservedAt: w.VerifiedAt, ValidUntil: w.ValidUntil}
+	check := func(context.Context) (fleet.APIContextReceiver, error) { return receiver, nil }
+	standby, e := router.RegisterStandby(ctx, receiver, check)
+	if e != nil {
+		t.Fatal(e)
+	}
+	attachment, e := router.Attach(ctx, w.Work.Target.ClusterID, w.Work.CaptureID)
+	if e != nil {
+		t.Fatal(e)
+	}
+	reader, writer := io.Pipe()
+	defer writer.Close()
+	s := diagnosticStream(t, standby.Context(), check, reader, io.Discard, nil, nil, nil, func() { _ = reader.Close() })
+	served := make(chan error, 1)
+	finish := make(chan struct{})
+	go func() { err := standby.Serve(s, time.Now); served <- err; <-finish; s.Close(); standby.Finish() }()
+	q, e := contracts.EncodeAPIContextIdentityRequest(contracts.APIContextIdentityRequest{Format: contracts.APIContextExchangeFormat, ExchangeID: w.Work.Channel.ExchangeID, CaptureID: w.Work.CaptureID, Sequence: 1, Challenge: "33000000-0000-4000-8000-000000000001"})
+	if e != nil {
+		t.Fatal(e)
+	}
+	written := make(chan error, 1)
+	go func() {
+		written <- contracts.WriteAPIContextFrame(writer, contracts.APIContextFrame{Kind: contracts.APIContextIdentityRequestFrame, Payload: q})
+	}()
+	calls := 0
+	private := &streamPrivateError{}
+	_, e = attachment.Dispatch(w.Work, []byte("signed"), currentFunc(func(context.Context) (identity.Identity, error) {
+		calls++
+		return identity.Identity{}, private
+	}))
+	close(finish)
+	attachment.Close()
+	router.Close()
+	if err := <-written; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-served; err != private {
+		t.Fatal("original hub error was replaced")
+	}
+	if e != private || calls != 1 {
+		t.Fatal("original identity normalization/call count changed")
+	}
+	got := record.Interruption()
+	if got.stage != streamHubIdentity || got.reason != streamOther {
+		t.Fatal("joined hub deciding failure lost", got.Stage(), got.Reason())
+	}
+}
