{
  "schemaVersion": "collection-scope/v1",
  "source": {
    "clusterID": "00000000-0000-4000-8000-000000000001",
    "namespaceUID": "namespace-payments-uid",
    "resourceUID": "policy-trigger-lifecycles-uid"
  },
  "executor": {
    "issuer": "urn:asservat:installation:00000000-0000-4000-8000-000000000098",
    "subject": "policy:policy-trigger-lifecycles-uid",
    "clientID": "policy-executor",
    "identityType": "workload"
  },
  "collection": {
    "kind": "DebugPolicy",
    "spec": {
      "target": {
        "workloadRef": {
          "kind": "Deployment",
          "name": "api",
          "apiVersion": "apps/v1"
        },
        "namespace": "payments",
        "maxPods": 1,
        "selection": "triggeringPod",
        "adoption": "followName"
      },
      "detectors": [
        {
          "id": "panic-log",
          "kind": "log",
          "options": {
            "stream": "stderr",
            "pattern": "panic|fatal error|connection reset",
            "match": "regexp",
            "maxRecordBytes": 65536
          }
        },
        {
          "id": "memory-high",
          "kind": "resource",
          "options": {
            "metric": "memoryLimitRatio",
            "operator": "gte",
            "threshold": 0.85,
            "sampleInterval": "5s"
          }
        },
        {
          "id": "probe-failed",
          "kind": "probe",
          "options": {
            "probeType": "Liveness",
            "minimumFailures": 1,
            "window": "30s",
            "source": "auto"
          }
        }
      ],
      "when": {
        "any": [
          {
            "detector": "panic-log"
          },
          {
            "for": {
              "expression": {
                "detector": "memory-high"
              },
              "duration": "20s"
            }
          },
          {
            "detector": "probe-failed"
          }
        ]
      },
      "recipeRef": {
        "name": "trigger-lifecycles",
        "digest": "04448c6faf2374ef3097ace4526fded6dcd152a15f62f74f35656551acf2f4a7"
      },
      "budgets": {
        "cooldown": "5m",
        "burst": 2,
        "maxConcurrentActions": 3
      },
      "retention": "72h",
      "evaluation": {
        "scope": "pod",
        "fireOnActivation": true,
        "rearmFor": "10s"
      },
      "recordingSaves": {
        "enabled": true
      }
    }
  },
  "dependencies": [
    {
      "role": "collectionCeiling",
      "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "role": "recipe",
      "digest": "04448c6faf2374ef3097ace4526fded6dcd152a15f62f74f35656551acf2f4a7"
    },
    {
      "role": "retention",
      "digest": "386340546d83b24bbfc3e7a823c0eb42b79554c7b20438e7e3ce237de62ca36b"
    }
  ],
  "policyAuthority": {
    "mode": "team",
    "installationID": "00000000-0000-4000-8000-000000000098",
    "delegation": {
      "uid": "binding-payments-automation",
      "generation": 1,
      "digest": "ac64b349471ddc2a142ef66c507dde8ec05005a91eb6dc43a55a553bf3a7f676"
    },
    "ownerAssignments": [
      {
        "subject": {
          "kind": "Group",
          "issuer": "https://identity.example.invalid/realms/company",
          "id": "team-payments"
        },
        "role": "workload-maintainer",
        "basisKind": "AccessBinding",
