{
  "apiVersion": "asservat.io/v1alpha1",
  "kind": "EvidenceRecipe",
  "metadata": {
    "name": "builtin-pod-status-v1",
    "namespace": "asservat-system"
  },
  "spec": {
    "description": "Bounded pod status without workload configuration or free-text messages.",
    "actions": [
      {
        "id": "pod-status",
        "kind": "kubernetesSnapshot",
        "parameters": {
          "include": [
            "pod"
          ]
        },
        "dependsOn": [],
        "required": true,
        "impact": "observe",
        "limits": {
          "maxBytes": 4096,
          "timeout": "5s"
        },
        "executionMode": "onTrigger"
      }
    ],
    "maxTotalBytes": 4096,
    "maxDuration": "5s"
  }
}
