{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/common.schema.json",
  "title": "Asservat common v1",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$",
      "maxLength": 16
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        }
      },
      "required": [
        "name",
        "namespace"
      ]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "clientID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identityType": {
          "type": "string",
          "enum": [
            "human",
            "workload"
          ]
        }
      },
      "required": [
        "issuer",
        "subject",
        "clientID",
        "identityType"
      ]
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "User",
            "Group"
          ]
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "issuer",
        "id"
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactID": {
          "type": "string",
          "format": "uuid"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifactID",
        "digest"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$",
          "maxLength": 16
        }
      },
      "required": [
        "maxBytes",
        "timeout"
      ]
    }
  }
}
