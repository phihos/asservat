{
  "name": "create_share",
  "description": "Share one stored pod-status artifact (its exact digest from get_case) with up to eight users or groups of your identity provider until expires_at (at most seven days, never past the artifact's retention). Recipients can read it with get_case; download, inspection of other artifacts and capture rights are not shared. Needs the evidence-owner role on the workload and the evidence:share scope. Repeat an uncertain request with the same idempotency key.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "type": "string",
        "format": "uuid"
      },
      "artifacts": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/d0"
        },
        "maxItems": 1,
        "minItems": 1
      },
      "recipients": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/d1"
        },
        "maxItems": 8,
        "minItems": 1
      },
      "data_classes": {
        "const": [
          "metadata"
        ]
      },
      "operations": {
        "const": [
          "get_case"
        ]
      },
      "expires_at": {
        "type": "string",
        "format": "date-time"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "case_id",
      "artifacts",
      "recipients",
      "data_classes",
      "operations",
      "expires_at",
      "reason",
      "idempotency_key"
    ],
    "$defs": {
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "User",
              "Group"
            ]
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "kind",
          "issuer",
          "id"
        ]
      }
    }
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "share_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "phase": {
                    "const": "Active"
                  }
                },
                "required": [
                  "share_id",
                  "phase"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ]
  }
}
