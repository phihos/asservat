{
  "name": "list_reviews",
  "description": "List approval requests (ADR-249): view pending is the approver inbox, the reviewable requests of other people for workloads where you hold the action-approver role now; view requested lists your own requests in every phase. Newest first, at most limit (default 20, maximum 100). Approvals are decided in the console.",
  "transports": [
    "browser"
  ],
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "view": {
        "enum": [
          "pending",
          "requested"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "view"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "approvals": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "grant_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "phase": {
                          "enum": [
                            "Pending",
                            "Approved",
                            "Denied",
                            "Revoked",
                            "Expired",
                            "Exhausted"
                          ]
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3
                        },
                        "kind": {
                          "enum": [
                            "adHocCapture",
                            "policy"
                          ]
                        },
                        "capture_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "preview_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "execution_digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "review_digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "target": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "cluster_id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "namespace": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63
                            },
                            "workload_kind": {
                              "enum": [
                                "Deployment",
                                "StatefulSet",
                                "Pod"
                              ]
                            },
                            "workload_name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253
                            },
                            "pod_name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253
                            },
                            "namespace_uid": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            "workload_uid": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            }
                          },
                          "required": [
                            "cluster_id",
                            "namespace",
                            "workload_kind",
                            "workload_name"
                          ]
                        },
                        "data_class": {
                          "enum": [
                            "metadata",
                            "extract",
                            "raw"
                          ]
                        },
                        "reasons": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 16,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "action_id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "code": {
                                "enum": [
                                  "rawBytePredicate",
                                  "recordingApprovalRequired",
                                  "policyCollection"
                                ]
                              }
                            },
                            "required": [
                              "action_id",
                              "code"
                            ]
                          }
                        },
                        "observation_limits": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "max_session_seconds": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 3600
                            },
                            "max_observed_bytes": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 1099511627776
                            },
                            "max_bytes_per_second": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 1073741824
                            },
                            "max_concurrent_sessions": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 1000
                            }
                          },
                          "required": [
                            "max_session_seconds",
                            "max_observed_bytes",
                            "max_bytes_per_second",
                            "max_concurrent_sessions"
                          ]
                        },
                        "requested_by": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "issuer": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2048
                            },
                            "subject": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "client_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          },
                          "required": [
                            "issuer",
                            "subject",
                            "client_id"
                          ]
                        },
                        "requested_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "review_until": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "lifetime_seconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 31536000
                        },
                        "decision": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "decision": {
                              "enum": [
                                "approved",
                                "denied"
                              ]
                            },
                            "decided_by": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "issuer": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048
                                },
                                "subject": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                },
                                "client_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                }
                              },
                              "required": [
                                "issuer",
                                "subject",
                                "client_id"
                              ]
                            },
                            "decided_at": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            },
                            "authentication_context": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "acr": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128
                                },
                                "authenticated_at": {
                                  "type": "string",
                                  "format": "date-time"
                                }
                              },
                              "required": [
                                "acr",
                                "authenticated_at"
                              ]
                            }
                          },
                          "required": [
                            "decision",
                            "decided_by",
                            "decided_at",
                            "reason"
                          ]
                        },
                        "not_after": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "revoked_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "revoked_by": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "issuer": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2048
                            },
                            "subject": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "client_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          },
                          "required": [
                            "issuer",
                            "subject",
                            "client_id"
                          ]
                        },
                        "can_decide": {
                          "type": "boolean"
                        },
                        "can_revoke": {
                          "type": "boolean"
                        },
                        "approval_navigation_uri": {
                          "type": "string",
                          "format": "uri",
                          "maxLength": 2048
                        },
                        "preview_deadline": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Original passive preview expiry; bounds opening a new approval review, and also start for legacy previewDeadline plans."
                        },
                        "capture_deadline_rule": {
                          "enum": [
                            "previewDeadline",
                            "acceptanceWithinGrant",
                            "policyAuthority"
                          ],
                          "description": "Manual preview/acceptance window, or the separately accepted team-policy authority bound by original request-anchored grant expiry."
                        },
                        "capture_window_seconds": {
                          "type": "integer",
                          "const": 300,
                          "description": "Maximum window fixed once at acceptance, never beyond original approval expiry."
                        },
                        "policy": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "uid": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            "executor": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "issuer": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048
                                },
                                "subject": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                },
                                "client_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                }
                              },
                              "required": [
                                "issuer",
                                "subject",
                                "client_id"
                              ]
                            },
                            "authority_issued_at": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "authority_not_after": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "max_executions": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10000
                            },
                            "executions_used": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 10000
                            },
                            "max_collected_bytes": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 1099511627776
                            },
                            "max_observed_bytes": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 1099511627776
                            },
                            "collected_bytes_used": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 1099511627776
                            },
                            "observed_bytes_used": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 1099511627776
                            }
                          },
                          "required": [
                            "uid",
                            "executor",
                            "authority_issued_at",
                            "authority_not_after",
                            "max_executions",
                            "executions_used",
                            "max_collected_bytes",
                            "max_observed_bytes",
                            "collected_bytes_used",
                            "observed_bytes_used"
                          ]
                        }
                      },
                      "required": [
                        "grant_id",
                        "phase",
                        "revision",
                        "kind",
                        "execution_digest",
                        "review_digest",
                        "target",
                        "data_class",
                        "reasons",
                        "requested_by",
                        "requested_at",
                        "review_until",
                        "lifetime_seconds",
                        "can_decide",
                        "can_revoke",
                        "approval_navigation_uri",
                        "capture_deadline_rule"
                      ],
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "capture_deadline_rule": {
                                "const": "acceptanceWithinGrant"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "capture_window_seconds"
                            ]
                          },
                          "else": {
                            "not": {
                              "required": [
                                "capture_window_seconds"
                              ]
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "kind": {
                                "const": "adHocCapture"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "capture_id",
                              "preview_id",
                              "preview_deadline"
                            ],
                            "properties": {
                              "lifetime_seconds": {
                                "minimum": 60,
                                "maximum": 28800
                              },
                              "target": {
                                "required": [
                                  "pod_name"
                                ],
                                "not": {
                                  "anyOf": [
                                    {
                                      "required": [
                                        "namespace_uid"
                                      ]
                                    },
                                    {
                                      "required": [
                                        "workload_uid"
                                      ]
                                    }
                                  ]
                                }
                              },
                              "capture_deadline_rule": {
                                "enum": [
                                  "previewDeadline",
                                  "acceptanceWithinGrant"
                                ]
                              }
                            },
                            "not": {
                              "anyOf": [
                                {
                                  "required": [
                                    "policy"
                                  ]
                                }
                              ]
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "kind": {
                                "const": "policy"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "policy",
                              "not_after"
                            ],
                            "properties": {
                              "target": {
                                "required": [
                                  "namespace_uid",
                                  "workload_uid"
                                ],
                                "not": {
                                  "anyOf": [
                                    {
                                      "required": [
                                        "pod_name"
                                      ]
                                    }
                                  ]
                                }
                              },
                              "capture_deadline_rule": {
                                "const": "policyAuthority"
                              },
                              "can_resume": {
                                "const": false
                              },
                              "can_resolve": {
                                "const": false
                              },
                              "resume_requires_original_client": {
                                "const": false
                              }
                            },
                            "not": {
                              "anyOf": [
                                {
                                  "required": [
                                    "capture_id"
                                  ]
                                },
                                {
                                  "required": [
                                    "preview_id"
                                  ]
                                },
                                {
                                  "required": [
                                    "preview_deadline"
                                  ]
                                },
                                {
                                  "required": [
                                    "result_access"
                                  ]
                                },
                                {
                                  "required": [
                                    "remaining_bytes"
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "approvals"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "query_handle",
                  "retry_after_seconds"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ]
  }
}
