{
  "name": "transfer_share",
  "description": "Replace the owner teams managing a share you currently manage (an audited transfer). Name owner teams you belong to now (mode teams), or, as the share's creator, only yourself (mode creator). Creator, recipients, artifact and expiry stay unchanged; the share is suspended when no new manager keeps the evidence-owner role. Managing grants no read. Repeating with the same idempotency key is harmless.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "share_id": {
        "type": "string",
        "format": "uuid"
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000000
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "management": {
        "$ref": "#/$defs/d0"
      }
    },
    "required": [
      "share_id",
      "expected_revision",
      "idempotency_key",
      "management"
    ],
    "$defs": {
      "d0": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "const": "creator"
              }
            },
            "required": [
              "mode"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "const": "teams"
              },
              "teams": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "Group"
                    },
                    "issuer": {
                      "type": "string",
                      "format": "uri"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "issuer",
                    "id"
                  ]
                },
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true
              }
            },
            "required": [
              "mode",
              "teams"
            ]
          }
        ]
      }
    }
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "share_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "phase": {
                    "const": "Active"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 1000000000
                  },
                  "managed_by": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/d0"
                    },
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "share_id",
                  "phase",
                  "revision",
                  "managed_by"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "User",
              "Group"
            ]
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "kind",
          "issuer",
          "id"
        ]
      }
    }
  }
}
