{
  "name": "get_capture",
  "description": "Read authorized pod-status capture progress. No evidence bytes. Finalizing is not publication; Indeterminate must not be automatically recaptured.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "capture_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "capture_id"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
