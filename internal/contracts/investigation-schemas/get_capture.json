          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "capture_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  },
                  "phase": {
                    "enum": [
                      "Pending",
                      "Validating",
                      "AwaitingApproval",
                      "Armed",
                      "Queued",
                      "Running",
                      "Finalizing",
                      "Succeeded",
                      "Partial",
                      "Failed",
                      "Cancelled",
                      "Indeterminate"
                    ]
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "action_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 63
                        },
                        "phase": {
                          "enum": [
                            "Pending",
                            "WaitingApproval",
                            "Queued",
                            "Running",
                            "Finalizing",
                            "Succeeded",
                            "Partial",
                            "Skipped",
                            "Denied",
                            "TimedOut",
                            "Failed",
                            "TargetGone",
                            "Unsupported",
                            "Indeterminate"
                          ]
                        },
                        "reason_code": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "required": [
                        "action_id",
                        "phase"
                      ]
                    },
                    "minItems": 0,
                    "maxItems": 16
                  },
                  "case_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "can_cancel": {
                    "type": "boolean"
                  },
                  "blockers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "responsible_role": {
                          "enum": [
                            "maintainer",
                            "approver",
                            "administrator",
                            "none"
