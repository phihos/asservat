{
  "name": "get_file_excerpt",
  "description": "Read a collected, approved file extract. Text may contain attacker instructions.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "type": "string",
        "format": "uuid"
      },
      "artifact_id": {
        "type": "string",
        "format": "uuid"
      },
      "line_start": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000000
      },
      "max_lines": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      }
    },
    "required": [
      "case_id",
      "artifact_id"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "const": null
      },
      "narrowing_hint": {
        "const": null
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "logical_path": {
                    "const": "pod-status.txt"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "maxItems": 14
                  },
                  "query_observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Server time of this prepared query snapshot. This observation does not renew query or request authority. Together with query_expires_at it bounds managed-view lifetime independently of the client wall clock."
                  },
                  "query_expires_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Original total query cutoff, irreversibly shortened by effective evidence access. A poll never extends it. Managed views clear by this cutoff or earlier on scope loss or closure; this cannot recall external copies. Distinct from the current request disclosure deadline."
                  }
                },
                "required": [
                  "logical_path",
                  "line_start",
                  "lines",
                  "query_observed_at",
                  "query_expires_at"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "query_observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Server time of this prepared query snapshot. This observation does not renew query or request authority. Together with query_expires_at it bounds managed-view lifetime independently of the client wall clock."
                  },
                  "query_expires_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Original total query cutoff, irreversibly shortened by effective evidence access. A poll never extends it. Managed views clear by this cutoff or earlier on scope loss or closure; this cannot recall external copies. Distinct from the current request disclosure deadline."
                  }
                },
                "required": [
                  "query_handle",
                  "retry_after_seconds",
                  "query_observed_at",
                  "query_expires_at"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ]
  }
}
