          },
          "continuesAfterCreatorLeaves": {
            "const": true
          },
          "notAfter": {
            "$ref": "#/$defs/d6"
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxExecutions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "maxBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1099511627776
              },
              "maxObservedBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1099511627776
              }
            },
            "required": [
              "maxExecutions",
              "maxBytes",
              "maxObservedBytes"
            ]
          },
          "state": {
            "enum": [
              "Ready",
              "DelegationRequired",
              "Revoked",
              "Expired",
              "OwnerAssignmentChanged",
              "ReapprovalRequired",
              "Unavailable"
