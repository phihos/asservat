              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 16,
            "uniqueItems": true
          },
          "ownerTeams": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "Group"
                },
                "issuer": {
                  "type": "string",
                  "format": "uri"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "issuer",
                "id"
              ]
            }
          }
        },
        "required": [
          "mode",
          "executor",
          "continuesAfterCreatorLeaves",
          "notAfter",
          "limits",
          "state",
          "reasonCodes",
          "ownerTeams"
        ]
      },
      "d2": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recording_handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "policy_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "policy_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "pod_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "pod_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
