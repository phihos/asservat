              "human",
              "workload"
            ]
          }
        },
        "required": [
          "issuer",
          "subject",
          "clientID",
          "identityType"
        ]
      },
      "d6": {
        "type": "string",
        "format": "date-time"
      },
      "d4": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
