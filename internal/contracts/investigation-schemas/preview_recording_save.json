{
  "name": "preview_recording_save",
  "description": "Plan a snapshot-only save of existing packet/syscall recordings. No new recording, future window, dump or command. Preview does not reserve buffers or authority. Submit this typed preview through request_capture.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "recording_handles": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true
      },
      "before": {
        "$ref": "#/$defs/d0"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "Optional 1\u2013512 Unicode scalars, preserved verbatim. Omit when absent; an explicit empty string is invalid. Descriptive metadata is not restored on repeat."
      },
      "sharing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          },
          "notAfter": {
            "$ref": "#/$defs/d2"
          }
        },
        "required": [
          "recipients"
        ]
      },
      "repeated_from_capture_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "recording_handles"
    ],
    "$defs": {
      "d0": {
        "type": "string",
        "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$",
        "maxLength": 16
      },
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "User",
              "Group"
            ]
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "kind",
          "issuer",
          "id"
        ]
      },
      "d2": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "$ref": "#/$defs/d0"
              },
              "data_class": {
                "const": "metadata"
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "d3": {
        "type": "string",
        "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$",
        "maxLength": 16
      },
      "d5": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "clientID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "identityType": {
            "type": "string",
