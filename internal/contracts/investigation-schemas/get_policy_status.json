{
  "name": "get_policy_status",
  "description": "Explain an activated restart-trigger policy without content (REQ-TRG-005): state, expiry, execution spend, watched Pod count, recent occurrences with their captures and suppression counts by reason. Reading status collects nothing.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "policy_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      }
    },
    "required": [
      "policy_name"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "policy_uid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "acceptance_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "state": {
                    "enum": [
                      "active",
                      "suspended",
                      "changed",
                      "expired",
                      "deleted"
                    ]
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "executor": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "policy"
                      },
                      "policy_uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "kind",
                      "policy_uid"
                    ]
                  },
                  "executions_spent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "max_executions": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "watched_pods": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "occurrences": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "captured": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "recent": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "occurrence_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "capture_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "outcome": {
                          "enum": [
                            "captured",
                            "refused",
                            "pending"
                          ]
                        },
                        "restarts": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483648
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "occurrence_id",
                        "outcome",
                        "restarts",
                        "created_at"
                      ]
                    }
                  },
                  "suppressions": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "reason": {
                          "enum": [
                            "cooldown",
                            "budget",
                            "coalesced",
                            "capacity",
                            "authority",
                            "unavailable"
                          ]
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483647
                        },
                        "first_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "last_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "reason",
                        "count",
                        "first_at",
                        "last_at"
                      ]
                    }
                  }
                },
                "required": [
                  "policy_uid",
                  "acceptance_id",
                  "state",
                  "generation",
                  "expires_at",
                  "executor",
                  "executions_spent",
                  "max_executions",
                  "watched_pods",
                  "occurrences",
                  "captured",
                  "recent",
                  "suppressions"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ]
  }
}
