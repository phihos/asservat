{
  "name": "get_policy_status",
  "description": "Explain an activated or deactivated restart-, probe-, alert-, log- or resource-trigger policy (ADR-228/230/231/241) without content (REQ-TRG-005): state, expiry, execution spend, watched Pod count, recent occurrences with their captures and suppression counts by reason. Reading status collects nothing. With recurring sharing (ADR-239) it also reports the sharing state, recipients count, captures shared so far, the limit and the end.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "policy_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      }
    },
    "required": [
      "policy_name"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "policy_uid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "acceptance_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "state": {
                    "enum": [
                      "active",
                      "deactivated",
                      "suspended",
                      "changed",
                      "expired",
                      "deleted"
                    ]
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "executor": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "policy"
                      },
                      "policy_uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "kind",
                      "policy_uid"
                    ]
                  },
                  "executions_spent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "max_executions": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "watched_pods": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "occurrences": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "captured": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "recent": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "occurrence_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "capture_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "outcome": {
                          "enum": [
                            "captured",
                            "refused",
                            "pending"
                          ]
                        },
                        "restarts": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483648
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "detector": {
                          "enum": [
                            "exit",
                            "probe",
                            "alert",
                            "log",
                            "resource"
                          ]
                        },
                        "failed_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "occurrence_id",
                        "outcome",
                        "detector",
                        "created_at"
                      ],
                      "if": {
                        "properties": {
                          "detector": {
                            "enum": [
                              "probe",
                              "alert",
                              "log",
                              "resource"
                            ]
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "failed_at"
                        ],
                        "not": {
                          "required": [
                            "restarts"
                          ]
                        }
                      },
                      "else": {
                        "required": [
                          "restarts"
                        ],
                        "not": {
                          "required": [
                            "failed_at"
                          ]
                        }
                      }
                    }
                  },
                  "suppressions": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "reason": {
                          "enum": [
                            "cooldown",
                            "budget",
                            "coalesced",
                            "capacity",
                            "authority",
                            "unavailable",
                            "overlong"
                          ]
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483647
                        },
                        "first_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "last_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "reason",
                        "count",
                        "first_at",
                        "last_at"
                      ]
                    }
                  },
                  "detector": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "The current DebugPolicy's detector configuration (no observed content).",
                    "properties": {
                      "kind": {
                        "enum": [
                          "exit",
                          "probe",
                          "alert",
                          "log",
                          "resource"
                        ]
                      },
                      "reasons": {
                        "type": "array",
                        "maxItems": 3,
                        "items": {
                          "enum": [
                            "CrashLoopBackOff",
                            "Error",
                            "OOMKilled"
                          ]
                        }
                      },
                      "exit_codes": {
                        "type": "array",
                        "maxItems": 16,
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      },
                      "probe_type": {
                        "enum": [
                          "Liveness",
                          "Readiness",
                          "Startup"
                        ]
                      },
                      "minimum_failures": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "window_seconds": {
                        "type": "integer",
                        "minimum": 30,
                        "maximum": 300
                      },
                      "match": {
                        "enum": [
                          "literal",
                          "regexp"
                        ]
                      },
                      "json_field": {
                        "type": "boolean"
                      },
                      "metric": {
                        "enum": [
                          "cpuCores",
                          "cpuQuotaRatio",
                          "memoryBytes",
                          "memoryLimitRatio"
                        ]
                      },
                      "operator": {
                        "enum": [
                          "gt",
                          "gte",
                          "lt",
                          "lte"
                        ]
                      },
                      "threshold": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000000000
                      },
                      "sample_interval_seconds": {
                        "type": "integer",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "sharing": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Recurring sharing of the acceptance (ADR-239). stopped: a manager stopped future sharing (stop_future_sharing; already claimed captures still publish); policyChanged: the DebugPolicy changed after acceptance, activate the new revision to share again. Existing shares stay until they expire or are revoked (revoke_share with sharing_intent_id = acceptance_id and expected_revision = revision).",
                    "properties": {
                      "state": {
                        "enum": [
                          "active",
                          "limitReached",
                          "expired",
                          "stopped",
                          "policyChanged",
                          "revoked"
                        ]
                      },
                      "recipients": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8
                      },
                      "shared_captures": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "max_captures": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "not_after": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "revoked_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "stopped_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "state",
                      "recipients",
                      "shared_captures",
                      "max_captures",
                      "not_after",
                      "revision"
                    ]
                  },
                  "collected_bytes_spent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776,
                    "description": "Conservative native-output reservations shared by this acceptance; uncertain spend remains charged. Not measured bytes."
                  },
                  "max_collected_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776,
                    "description": "Original accepted cumulative native-output ceiling, shared across grant replacements and controls."
                  },
                  "observed_bytes_spent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776,
                    "description": "Conservative pre-filter observation charges shared by this acceptance, including uncertain legacy spend. Not collected output."
                  },
                  "max_observed_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776,
                    "description": "Original accepted cumulative pre-filter observation ceiling; zero permits no continuing acquisition."
                  },
                  "collection_kind": {
                    "enum": [
                      "podStatus",
                      "packetCapture"
                    ],
                    "description": "Accepted collection action; controls available approval commands, not acquisition authority."
                  },
                  "attached_grant_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Grant named by the current attachment pointer; does not assert that its authority, budget or recorder readiness currently permits collection."
                  }
                },
                "required": [
                  "policy_uid",
                  "acceptance_id",
                  "state",
                  "generation",
                  "expires_at",
                  "executor",
                  "executions_spent",
                  "max_executions",
                  "watched_pods",
                  "occurrences",
                  "captured",
                  "recent",
                  "suppressions",
                  "collected_bytes_spent",
                  "max_collected_bytes",
                  "observed_bytes_spent",
                  "max_observed_bytes",
                  "collection_kind"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ]
  }
}
