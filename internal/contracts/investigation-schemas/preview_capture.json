          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "kind",
          "issuer",
          "id"
        ]
      },
      "d1": {
        "type": "string",
        "format": "date-time"
      }
    }
