{
  "name": "preview_capture",
  "description": "Review a bounded whole-pod Kubernetes status snapshot, selected Pod, impact and data handling. No collection; only pod-status/v1 is supported by this runtime. Optional sharing shares the published result with up to eight users or groups of your identity provider (needs evidence-owner and the evidence:share scope; default 24 hours, at most seven days); get_capture reports sharing separately. Collect again: pass history_capture_id from list_capture_history (optionally with sharing) to restore its target and requested retention into a fresh preview with every current check.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster_id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet",
              "Pod"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "required": [
          "cluster_id",
          "namespace",
          "kind",
          "name"
        ]
      },
      "preset_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "pod-status"
          },
          "version": {
            "const": "v1"
          }
        },
        "required": [
          "name",
          "version"
        ]
      },
      "requested_retention_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 315360000,
        "description": "Requested evidence-access lifetime in seconds. Omission uses the administrator default; effective access and managed deletion remain bounded by current retention policy and its deletion budget. History restoration preserves its original request; use a normal edited preview to change it."
      },
      "sharing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d0"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          },
          "notAfter": {
            "$ref": "#/$defs/d1"
          }
        },
        "required": [
          "recipients"
        ]
      },
      "history_capture_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [],
    "oneOf": [
      {
        "required": [
          "target_ref",
          "preset_ref"
        ],
        "not": {
          "required": [
            "history_capture_id"
          ]
        }
      },
      {
        "required": [
          "history_capture_id"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "target_ref"
              ]
            },
            {
              "required": [
                "preset_ref"
              ]
            },
            {
              "required": [
                "requested_retention_seconds"
              ]
            }
          ]
        }
      }
    ],
    "$defs": {
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
