{
  "name": "revoke_share",
  "description": "Revoke a share you created or currently manage through a pinned owner team; installation administrators may revoke any share. Each transfer and the revocation add one revision (list_shares shows the current one). With sharing_intent_id (a policy's acceptance_id, expected_revision 1) revoke every share of that policy acceptance's recurring sharing and its future sharing. Recipients lose access at their next read; independent rights are unchanged and revoking never grants a read. Repeating with the same idempotency key is harmless.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "share_id": {
        "type": "string",
        "format": "uuid"
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000000
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "sharing_intent_id": {
        "$ref": "#/$defs/d0"
      }
    },
    "required": [
      "expected_revision",
      "idempotency_key"
    ],
    "oneOf": [
      {
        "required": [
          "share_id"
        ]
      },
      {
        "required": [
          "sharing_intent_id"
        ]
      }
    ],
    "$defs": {
      "d0": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "share_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "phase": {
                    "const": "Revoked"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 1000000000
                  },
                  "sharing_intent_id": {
                    "$ref": "#/$defs/d0"
                  }
                },
                "required": [
                  "phase",
                  "revision"
                ],
                "oneOf": [
                  {
                    "required": [
                      "share_id"
                    ]
                  },
                  {
                    "required": [
                      "sharing_intent_id"
                    ]
                  }
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d0": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
