{
  "name": "request_raw_access",
  "description": "Request independent approval for whole-file downloads, bounded saved-packet queries, or both over selected existing raw artifacts. This creates no collection or disclosure. Current runtime operations are download_artifact and pcap_query. Exact verified sizes, targets and requester/client are reviewed; the selection is bounded only by the request body. Query-only output budgets need not cover the whole native file; each returned query page is charged at most 24 KiB and one operation. Retry an uncertain reply with the same selection and idempotency key; original expiry and spend do not reset. Operation identifiers name the raw query_artifact operations (pcap_query = packets, syscall_query = syscalls, read_memory = memory, debugger_command = debugger), get_logs and download_artifact. Callers with the equivalent Kubernetes right need no grant.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "type": "string",
        "format": "uuid"
      },
      "artifact_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "artifact_digests": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "minItems": 1,
        "uniqueItems": true,
        "description": "Optional provenance pin of the exact artifact versions."
      },
      "operations": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "backtrace",
            "download_artifact",
            "frame_variables",
            "get_logs",
            "heap_statistics",
            "managed_stack",
            "pcap_query",
            "read_memory",
            "registers",
            "syscall_query",
            "threads"
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "Optional; defaults to the verified sizes of the selected artifacts (download) or the query allowance."
      },
      "expires_in_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "Optional; defaults to the artifacts' access end (AccessUntil), capped by the administrator maximum."
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "case_id",
      "operations",
      "reason",
      "idempotency_key"
    ],
    "anyOf": [
      {
        "required": [
          "artifact_ids"
        ]
      },
      {
        "required": [
          "artifact_digests"
        ]
      }
    ]
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "grant_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "phase": {
                    "type": "string",
                    "enum": [
                      "Pending",
                      "Approved",
                      "Denied",
                      "Expired",
                      "Revoked"
                    ]
                  },
                  "approval_uri": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "grant_id",
                  "phase"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "query_handle",
                  "revision"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
