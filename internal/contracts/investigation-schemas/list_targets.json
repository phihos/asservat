        "maximum": 9007199254740991
      },
      "cluster": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "description": "Cluster name as configured in the hub (ADR-335 D4)."
      },
      "namespace": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      },
