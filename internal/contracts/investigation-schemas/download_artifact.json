{
  "name": "download_artifact",
  "description": "Prepare, follow or cancel a native download or core bundle (action = prepare, status or cancel). Returns metadata, the verified size and SHA-256, and for Ready sessions content_path and browser_url, never bytes. status waits server-side with after_revision (at most 30 s); cancel stays available after access loss. Local copies are outside Asservat's automatic deletion.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "prepare",
          "status",
          "cancel"
        ],
        "description": "Selects the action; each value has its own strict argument set."
      },
      "artifact_id": {
        "type": "string",
        "format": "uuid"
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1
      },
      "representation": {
        "enum": [
          "bundle",
          "file"
        ],
        "default": "bundle",
        "description": "Core artifacts only: bundle (default) is the debugger-ready tar with executable, libraries, debug files and gdb.cmd/dlv.sh; file is the bare core. Ignored for other kinds."
      },
      "download_id": {
        "type": "string",
        "format": "uuid"
      },
      "after_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "Wait server-side until the state revision differs from this value or 30 seconds pass, then return the current state. Omit for an immediate read. Status reads are never charged."
      }
    },
    "required": [
      "action"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "prepare"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "prepare"
            },
            "artifact_id": {
              "type": "string",
              "format": "uuid"
            },
            "idempotency_key": {
              "type": "string",
              "minLength": 1
            },
            "representation": {
              "enum": [
                "bundle",
                "file"
              ],
              "default": "bundle",
              "description": "Core artifacts only: bundle (default) is the debugger-ready tar with executable, libraries, debug files and gdb.cmd/dlv.sh; file is the bare core. Ignored for other kinds."
            }
          },
          "required": [
            "action",
            "artifact_id",
            "idempotency_key"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "status"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "status"
            },
            "download_id": {
              "type": "string",
              "format": "uuid"
            },
            "after_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Wait server-side until the state revision differs from this value or 30 seconds pass, then return the current state. Omit for an immediate read. Status reads are never charged."
            }
          },
          "required": [
            "action",
            "download_id"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "cancel"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "cancel"
            },
            "download_id": {
              "type": "string",
              "format": "uuid"
            },
            "idempotency_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "action",
            "download_id",
            "idempotency_key"
          ]
        }
      }
    ]
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/d2"
                  },
                  {
                    "$ref": "#/$defs/d3"
                  }
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "description": "RawApprovalRequired is returned only for a fresh preparation whose ordinary access checks passed but neither the equivalent Kubernetes right nor a current grant covers the raw file; navigation_uri opens the prefilled review. Other failures must not open approval."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "d2": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "download_id": {
            "type": "string",
            "format": "uuid"
          },
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "Preparing",
              "Ready",
              "Completed",
              "Failed",
              "Cancelled"
            ],
            "description": "Preparing while the regional reader verifies the file; status with after_revision waits for the next state. An interrupted connection leaves the session Ready; resume with HTTP Range until access_until. Completed, Failed and Cancelled are terminal."
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Changes whenever the session state or transfer generation changes; pass it as after_revision to wait for the next change."
          },
          "filename": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
            "description": "<workload>-<pod>-<time>.<ext> from recorded provenance (core bundle: .core.tar)."
          },
          "native_format": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Verified size; present once the session was Ready."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Verified full-file SHA-256; present once the session was Ready."
          },
          "content_path": {
            "type": "string",
            "pattern": "^/api/v1/downloads/[0-9a-f-]{36}/content$"
          },
          "emitted_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "local_copy_managed": {
            "const": false
          },
          "handling_notice": {
            "type": "string",
            "minLength": 1
          },
          "coverage_notice": {
            "type": "string"
          },
          "etag": {
            "type": "string",
            "pattern": "^\"[A-Za-z0-9_-]{1,120}\"$",
            "description": "Strong opaque native-representation version; use with If-Match when resuming."
          },
          "failure_reason": {
            "enum": [
              "Expired",
              "Denied",
              "Integrity",
              "Deleted",
              "Unavailable"
            ]
          },
          "representation": {
            "enum": [
              "bundle",
              "file"
            ]
          },
          "browser_url": {
            "type": "string",
            "pattern": "^/downloads/[0-9a-f-]{36}$",
            "description": "Console page that downloads this session in the signed-in browser of the same human without another consent or approval."
          },
          "access_until": {
            "type": "string",
            "format": "date-time",
            "description": "AccessUntil: the artifact's access end (retention, share or grant end), never extended by status reads. Resumes are allowed until then; the caller's token lifetime does not shorten a started response (ADR-312)."
          }
        },
        "required": [
          "download_id",
          "artifact_id",
          "state",
          "revision",
          "access_until",
          "emitted_bytes",
          "local_copy_managed",
          "handling_notice"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "Ready"
                }
              }
            },
            "then": {
              "required": [
                "content_path",
                "browser_url",
                "filename",
                "native_format",
                "etag",
                "coverage_notice"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "content_path"
                    ]
                  },
                  {
                    "required": [
                      "browser_url"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "Failed"
                }
              }
            },
            "then": {
              "required": [
                "failure_reason"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "failure_reason"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "Ready",
                    "Completed"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "size_bytes",
                "sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "Preparing"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "size_bytes"
                    ]
                  },
                  {
                    "required": [
                      "sha256"
                    ]
                  },
                  {
                    "required": [
                      "filename"
                    ]
                  }
                ]
              }
            }
          }
        ],
        "dependentRequired": {
          "filename": [
            "native_format",
            "etag",
            "coverage_notice"
          ],
          "native_format": [
            "filename",
            "etag",
            "coverage_notice"
          ],
          "etag": [
            "filename",
            "native_format",
            "coverage_notice"
          ],
          "coverage_notice": [
            "filename",
            "native_format",
            "etag"
          ],
          "size_bytes": [
            "sha256"
          ],
          "sha256": [
            "size_bytes"
          ]
        },
        "description": "Current authorized transfer status. Prepare returns Ready, or Preparing while the regional reader verifies the file. Ready carries content_path and browser_url; other states carry neither. Size and SHA-256 are kept from Ready on. Completed records the server transfer outcome, not local file persistence. Status reads never decrypt a file."
      },
      "d3": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "download_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "Cancelled",
              "AlreadyTerminal"
            ]
          }
        },
        "required": [
          "download_id",
          "state"
        ],
        "description": "A minimal receipt for stopping the original caller/client download, even after evidence access is lost. AlreadyTerminal hides the finer prior state. No artifact or native metadata. The audit row is written in the same transaction (ADR-330 D6)."
      }
    }
  }
}
