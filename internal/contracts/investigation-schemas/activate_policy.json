{
  "name": "activate_policy",
  "description": "Activate the current revision of a hub-held restart-trigger DebugPolicy for your team (ADR-228). Requires whole-pod collection rights and membership in a sponsoring group of the workload's automation AccessBinding. The policy then captures pod status automatically on Pod restarts within the team's finite envelope. Retry an uncertain result with the same idempotency key. A DebugPolicy with spec.sharing (ADR-239) also shares each of its next maxCaptures captures until notAfter with the named recipients: this needs the evidence:share scope and an evidence-owner group of the automation AccessBinding: the first call returns SharingReviewRequired with the review (repeated collections will be shared, recipients, maximum captures, end); activate again with sharing_reviewed true to accept it.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "policy_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "sharing_reviewed": {
        "type": "boolean",
        "description": "Accept the reviewed recurring sharing of a DebugPolicy with spec.sharing (ADR-239). Without it such a policy is not activated; the reply SharingReviewRequired states that repeated collections will be shared, with whom, how many captures and until when."
      }
    },
    "required": [
      "policy_name",
      "idempotency_key"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "policy_uid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "acceptance_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "state": {
                    "enum": [
                      "active",
                      "pendingAudit"
                    ]
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "max_executions": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "replay": {
                    "type": "boolean"
                  },
                  "sharing": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Recurring sharing of this acceptance (ADR-239): repeated collections will be shared with these recipients, at most max_captures captures, until not_after.",
                    "properties": {
                      "statement": {
                        "const": "Repeated collections will be shared"
                      },
                      "recipients": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8
                      },
                      "max_captures": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "not_after": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "statement",
                      "recipients",
                      "max_captures",
                      "not_after"
                    ]
                  }
                },
                "required": [
                  "policy_uid",
                  "acceptance_id",
                  "state",
                  "expires_at",
                  "max_executions",
                  "replay"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ]
  }
}
