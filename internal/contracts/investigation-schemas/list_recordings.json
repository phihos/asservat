{
  "name": "list_recordings",
  "description": "List running and stopped policy and manual packet/syscall sources of one workload: history, save eligibility (recording saves) and the live projections each supports (watch_live). Passive; opens nothing and acquires nothing.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "policy": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
        "description": "Policy name in the target namespace."
      },
      "cursor": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "target_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "description": "Cluster name as configured in the hub (ADR-335 D4)."
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet",
              "Pod"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "required": [
          "cluster",
          "namespace",
          "kind",
          "name"
        ]
      }
    },
    "required": [
      "target_ref"
    ]
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "$ref": "#/$defs/d2"
              },
              "data_class": {
                "const": "metadata"
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "query_handle",
                  "revision"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "d4": {
        "type": "string",
        "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$"
      },
      "d5": {
        "enum": [
          "packetMetadata",
          "httpHeaders",
          "syscallMetadata"
        ]
      },
      "d7": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "description": "OIDC Core: sub is at most 255 ASCII characters."
          },
          "clientID": {
            "type": "string",
            "minLength": 1
          },
          "identityType": {
            "type": "string",
            "enum": [
              "human",
              "workload"
            ]
          }
        },
        "required": [
          "issuer",
          "subject",
          "clientID",
          "identityType"
        ]
      },
      "d8": {
        "type": "string",
        "format": "date-time"
      },
      "d6": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "const": "team"
          },
          "executor": {
            "$ref": "#/$defs/d7"
          },
          "continuesAfterCreatorLeaves": {
            "const": true
          },
          "notAfter": {
            "$ref": "#/$defs/d8",
            "description": "Absent for an envelope without a lifetime ceiling (ADR-335 D6)."
          },
          "state": {
            "enum": [
              "Ready",
              "DelegationRequired",
              "Revoked",
              "Expired",
              "OwnerAssignmentChanged",
              "ReapprovalRequired",
              "Unavailable"
            ]
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "ownerTeams": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "Group"
                },
                "issuer": {
                  "type": "string",
                  "format": "uri"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "issuer",
                "id"
              ]
            }
          }
        },
        "required": [
          "mode",
          "executor",
          "continuesAfterCreatorLeaves",
          "state",
          "reasonCodes",
          "ownerTeams"
        ]
      },
      "d3": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recording_handle": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque, principal-bound handle for preview_capture(recording_handles) and watch_live(action=open, source_handles)."
          },
          "owner_kind": {
            "enum": [
              "policy",
              "manualSession"
            ]
          },
          "policy_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "capture_id": {
            "type": "string",
            "format": "uuid",
            "description": "Manual-session source: the capture that owns it."
          },
          "pod_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "packetCapture",
              "syscallTrace"
            ]
          },
          "state": {
            "enum": [
              "Unavailable",
              "Warming",
              "Ready",
              "Degraded",
              "Stopped"
            ],
            "description": "Shared source states (REQ-LIF-002)."
          },
          "history": {
            "enum": [
              "Unknown",
              "Full",
              "Partial",
              "None"
            ]
          },
          "maximum_before": {
            "anyOf": [
              {
                "$ref": "#/$defs/d4"
              },
              {
                "const": "0s"
              }
            ]
          },
          "save_eligible": {
            "type": "boolean"
          },
          "save_via": {
            "enum": [
              "recordingSave",
              "captureOutcome",
              "unavailable"
            ]
          },
          "live_projections": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d5"
            },
            "minItems": 0,
            "uniqueItems": true,
            "description": "Live projections watch_live can open on this source; empty when live viewing is unavailable."
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "Actionable blocker codes, for example NotSaveEnabled, LiveViewDisabled or SourceStopped."
          },
          "incident_pod_cap": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "available_before_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "hard_end": {
            "type": "string",
            "format": "date-time",
            "description": "Source hard end; watches and saves end by then."
          },
          "execution_authority": {
            "$ref": "#/$defs/d6"
          },
          "policy_uid": {
            "type": "string",
            "minLength": 1,
            "description": "Provenance only."
          },
          "pod_uid": {
            "type": "string",
            "minLength": 1,
            "description": "Provenance only."
          }
        },
        "required": [
          "recording_handle",
          "owner_kind",
          "pod_name",
          "action_id",
          "kind",
          "state",
          "history",
          "maximum_before",
          "save_eligible",
          "save_via",
          "live_projections",
          "blockers",
          "incident_pod_cap"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "owner_kind": {
                  "const": "policy"
                }
              },
              "required": [
                "owner_kind"
              ]
            },
            "then": {
              "required": [
                "policy_name"
              ]
            },
            "else": {
              "required": [
                "capture_id"
              ],
              "properties": {
                "save_eligible": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "save_eligible": {
                  "const": true
                }
              },
              "required": [
                "save_eligible"
              ]
            },
            "then": {
              "properties": {
                "save_via": {
                  "const": "recordingSave"
                }
              }
            }
          }
        ]
      },
      "d2": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "recordingPage"
          },
          "recordings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d3"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "capture_enabled": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "recordings",
          "capture_enabled",
          "expires_at"
        ]
      }
    }
  }
}
