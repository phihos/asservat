{
  "name": "list_recordings",
  "description": "List authorized policy recordings and available history without reading payload, pinning buffers or starting a source. Handles require current collection rights and expire; shares alone give no inventory access.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "policy_uid": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "target_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster_id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet",
              "Pod"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "required": [
          "cluster_id",
          "namespace",
          "kind",
          "name"
        ]
      }
    },
    "required": [
      "target_ref"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          {
            "type": "null"
          }
        ]
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "$ref": "#/$defs/d0"
              },
              "data_class": {
                "const": "metadata"
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d2": {
        "type": "string",
        "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$",
        "maxLength": 16
      },
      "d4": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "clientID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "identityType": {
            "type": "string",
            "enum": [
              "human",
              "workload"
            ]
          }
        },
        "required": [
          "issuer",
          "subject",
          "clientID",
          "identityType"
        ]
      },
      "d5": {
        "type": "string",
        "format": "date-time"
      },
      "d3": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "const": "team"
          },
          "executor": {
            "$ref": "#/$defs/d4"
          },
          "continuesAfterCreatorLeaves": {
            "const": true
          },
          "notAfter": {
            "$ref": "#/$defs/d5"
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxExecutions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "maxBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1099511627776
              },
              "maxObservedBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1099511627776
              }
            },
            "required": [
              "maxExecutions",
              "maxBytes",
              "maxObservedBytes"
            ]
          },
          "state": {
            "enum": [
              "Ready",
              "DelegationRequired",
              "Revoked",
              "Expired",
              "OwnerAssignmentChanged",
              "ReapprovalRequired",
              "Unavailable"
            ]
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 16,
            "uniqueItems": true
          },
          "ownerTeams": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "Group"
                },
                "issuer": {
                  "type": "string",
                  "format": "uri"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "issuer",
                "id"
              ]
            }
          }
        },
        "required": [
          "mode",
          "executor",
          "continuesAfterCreatorLeaves",
          "notAfter",
          "limits",
          "state",
          "reasonCodes",
          "ownerTeams"
        ]
      },
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recording_handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "policy_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "policy_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "pod_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "pod_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "packetCapture",
              "syscallTrace"
            ]
          },
          "state": {
            "enum": [
              "Unknown",
              "Ready",
              "Armed",
              "Warming",
              "Degraded",
              "Stopped",
              "Expired",
              "Unavailable"
            ]
          },
          "history": {
            "enum": [
              "Unknown",
              "Full",
              "Partial",
              "None"
            ]
          },
          "maximum_before": {
            "anyOf": [
              {
                "$ref": "#/$defs/d2"
              },
              {
                "const": "0s"
              }
            ]
          },
          "save_eligible": {
            "type": "boolean"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 16,
            "uniqueItems": true
          },
          "incident_pod_cap": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "handle_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "available_before_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "execution_authority": {
            "$ref": "#/$defs/d3"
          }
        },
        "required": [
          "policy_uid",
          "pod_uid",
          "pod_name",
          "action_id",
          "kind",
          "state",
          "history",
          "maximum_before",
          "save_eligible",
          "blockers",
          "incident_pod_cap"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "save_eligible": {
                  "const": true
                }
              },
              "required": [
                "save_eligible"
              ]
            },
            "then": {
              "required": [
                "recording_handle"
              ]
            }
          }
        ]
      },
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "recordingPage"
          },
          "recordings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "capture_enabled": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "recordings",
          "capture_enabled",
          "expires_at"
        ]
      }
    }
  }
}
