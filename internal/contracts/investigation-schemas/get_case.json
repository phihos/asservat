{
  "name": "get_case",
  "description": "Read an authorized case projection: case, artifacts, evidence gaps and one cursor page of the time-ordered timeline.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "type": "string",
        "format": "uuid"
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "description": "Continues the timeline."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "Timeline events per page."
      }
    },
    "required": [
      "case_id"
    ]
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "case": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "case_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "type": "string",
                        "minLength": 1
                      },
                      "access": {
                        "type": "string",
                        "enum": [
                          "ordinary",
                          "shared"
                        ]
                      },
                      "updated_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "cluster_id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    },
                    "required": [
                      "case_id",
                      "status",
                      "access"
                    ]
                  },
                  "artifacts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "artifact_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$",
                          "description": "Immutable verified artifact version. For the current pod-status artifact this is SHA-256 of the existing serialized verified ciphertext copy receipts, not the native file checksum. The prepared download supplies the native SHA-256 separately."
                        },
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "data_class": {
                          "type": "string",
                          "enum": [
                            "metadata",
                            "extract",
                            "raw"
                          ]
                        },
                        "completeness": {
                          "type": "string",
                          "minLength": 1
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "handling_notice": {
                          "$ref": "#/$defs/d2"
                        },
                        "native_format": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Verified native format, when supplied; used to choose a compatible saved-evidence view. It grants no download or analysis authority."
                        },
                        "verified_native_bytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "target": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "cluster_id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "namespace_uid": {
                              "type": "string",
                              "minLength": 1
                            },
                            "workload_uid": {
                              "type": "string",
                              "minLength": 1
                            },
                            "pod_uid": {
                              "type": "string",
                              "minLength": 1
                            },
                            "namespace": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63,
                              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                            },
                            "workload_kind": {
                              "enum": [
                                "Deployment",
                                "StatefulSet"
                              ]
                            },
                            "workload_name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253,
                              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                            },
                            "pod_name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253,
                              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                            }
                          },
                          "required": [
                            "cluster_id",
                            "namespace_uid",
                            "workload_uid",
                            "pod_uid"
                          ]
                        },
                        "profile_acquisition": {
                          "type": "object",
                          "additionalProperties": false,
                          "description": "Accepted request parameters and authenticated HTTP acquisition timing, not the sample interval or cumulative history. Legacy timing, clock uncertainty and serving-process attribution may be unknown.",
                          "properties": {
                            "requested_type": {
                              "type": "string",
                              "enum": [
                                "cpu",
                                "heap",
                                "allocs",
                                "goroutine",
                                "block",
                                "mutex",
                                "threadcreate",
                                "runtimeTrace"
                              ]
                            },
                            "mode": {
                              "type": "string",
                              "enum": [
                                "interval",
                                "snapshot",
                                "cumulative",
                                "delta"
                              ]
                            },
                            "requested_duration_ms": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 1000,
                              "maximum": 9007199254740991,
                              "multipleOf": 1000
                            },
                            "force_gc": {
                              "type": "boolean"
                            },
                            "execution_mode": {
                              "const": "onTrigger"
                            },
                            "started_at": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "format": "date-time",
                              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
                            },
                            "completed_at": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "format": "date-time",
                              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
                            },
                            "clock_uncertainty_ms": {
                              "type": "null"
                            },
                            "process_attribution": {
                              "const": "unknown"
                            },
                            "window_kind": {
                              "const": "httpAcquisition"
                            },
                            "timestamp_precision": {
                              "const": "microsecond"
                            }
                          },
                          "required": [
                            "requested_type",
                            "mode",
                            "requested_duration_ms",
                            "force_gc",
                            "execution_mode",
                            "started_at",
                            "completed_at",
                            "clock_uncertainty_ms",
                            "process_attribution",
                            "window_kind",
                            "timestamp_precision"
                          ],
                          "allOf": [
                            {
                              "oneOf": [
                                {
                                  "properties": {
                                    "requested_type": {
                                      "enum": [
                                        "cpu"
                                      ]
                                    },
                                    "mode": {
                                      "const": "interval"
                                    },
                                    "requested_duration_ms": {
                                      "type": "integer",
                                      "minimum": 1000,
                                      "maximum": 9007199254740991,
                                      "multipleOf": 1000
                                    },
                                    "force_gc": {
                                      "const": false
                                    }
                                  }
                                },
                                {
                                  "properties": {
                                    "requested_type": {
                                      "enum": [
                                        "runtimeTrace"
                                      ]
                                    },
                                    "mode": {
                                      "const": "interval"
                                    },
                                    "requested_duration_ms": {
                                      "type": "integer",
                                      "minimum": 1000,
                                      "maximum": 9007199254740991,
                                      "multipleOf": 1000
                                    },
                                    "force_gc": {
                                      "const": false
                                    }
                                  }
                                },
                                {
                                  "properties": {
                                    "requested_type": {
                                      "enum": [
                                        "heap"
                                      ]
                                    },
                                    "mode": {
                                      "const": "snapshot"
                                    },
                                    "requested_duration_ms": {
                                      "type": "null"
                                    }
                                  }
                                },
                                {
                                  "properties": {
                                    "requested_type": {
                                      "enum": [
                                        "goroutine"
                                      ]
                                    },
                                    "mode": {
                                      "const": "snapshot"
                                    },
                                    "requested_duration_ms": {
                                      "type": "null"
                                    },
                                    "force_gc": {
                                      "const": false
                                    }
                                  }
                                },
                                {
                                  "properties": {
                                    "requested_type": {
                                      "enum": [
                                        "allocs",
                                        "block",
                                        "mutex",
                                        "threadcreate"
                                      ]
                                    },
                                    "mode": {
                                      "const": "cumulative"
                                    },
                                    "requested_duration_ms": {
                                      "type": "null"
                                    },
                                    "force_gc": {
                                      "const": false
                                    }
                                  }
                                },
                                {
                                  "properties": {
                                    "requested_type": {
                                      "enum": [
                                        "heap",
                                        "allocs",
                                        "goroutine",
                                        "block",
                                        "mutex",
                                        "threadcreate"
                                      ]
                                    },
                                    "mode": {
                                      "const": "delta"
                                    },
                                    "requested_duration_ms": {
                                      "type": "integer",
                                      "minimum": 1000,
                                      "maximum": 9007199254740991,
                                      "multipleOf": 1000
                                    },
                                    "force_gc": {
                                      "const": false
                                    }
                                  }
                                }
                              ]
                            },
                            {
                              "oneOf": [
                                {
                                  "properties": {
                                    "started_at": {
                                      "type": "null"
                                    },
                                    "completed_at": {
                                      "type": "null"
                                    }
                                  }
                                },
                                {
                                  "properties": {
                                    "started_at": {
                                      "type": "string"
                                    },
                                    "completed_at": {
                                      "type": "string"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "artifact_id",
                        "digest",
                        "kind",
                        "data_class",
                        "completeness",
                        "expires_at",
                        "handling_notice"
                      ],
                      "allOf": [
                        {
                          "if": {
                            "required": [
                              "profile_acquisition"
                            ]
                          },
                          "then": {
                            "properties": {
                              "kind": {
                                "const": "profile"
                              },
                              "data_class": {
                                "const": "raw"
                              },
                              "native_format": {
                                "enum": [
                                  "pprof",
                                  "go-trace"
                                ]
                              }
                            },
                            "required": [
                              "native_format"
                            ]
                          }
                        }
                      ]
                    },
                    "description": "First 100 artifacts (page size); list_artifacts pages through all of them."
                  },
                  "timeline": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "time": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "summary": {
                          "type": "string",
                          "minLength": 1
                        },
                        "clock_uncertainty_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "time",
                        "kind",
                        "summary"
                      ]
                    }
                  }
                },
                "required": [
                  "case",
                  "artifacts",
                  "timeline"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "query_handle",
                  "revision"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "d3": {
        "type": "string",
        "enum": [
          "unknown",
          "potentialPersonalData",
          "personalData",
          "specialCategoryPossible",
          "verifiedNonPersonal"
        ]
      },
      "d2": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "classification": {
            "$ref": "#/$defs/d3"
          },
          "mayContain": {
            "type": "array",
            "items": {
              "enum": [
                "userContent",
                "credentials",
                "personalIdentifiers",
                "networkAddresses",
                "paths",
                "profileLabels",
                "unknownApplicationData"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "deleteBy": {
            "type": "string",
            "format": "date-time"
          },
          "deletionState": {
            "enum": [
              "pending",
              "verified",
              "overdue",
              "restrictedPreservation"
            ]
          },
          "automaticDeletion": {
            "const": true
          },
          "managedCopiesOnly": {
            "const": true
          },
          "externalCopiesRecallable": {
            "const": false
          },
          "handlingCodes": {
            "type": "array",
            "items": {
              "enum": [
                "minimizeCapture",
                "restrictAccess",
                "preferApprovedExtracts",
                "reviewBeforeSharing",
                "approvedClientsOnly",
                "externalCopiesNotRecalled"
              ]
            },
            "minItems": 6,
            "uniqueItems": true
          },
          "preservationException": {
            "type": "boolean"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "handlingPolicyRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "classification",
          "mayContain",
          "expiresAt",
          "deleteBy",
          "deletionState",
          "automaticDeletion",
          "managedCopiesOnly",
          "externalCopiesRecallable",
          "handlingCodes",
          "preservationException",
          "asOf"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "verifiedNonPersonal"
                }
              }
            },
            "then": {
              "properties": {
                "mayContain": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
