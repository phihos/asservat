{
  "name": "list_shares",
  "description": "List shares managed personally or through current owner-team membership (view owned), or received concrete shares; optionally include managed sharing instructions. Installation administrators may list every share management-only (view administration: opaque IDs, phase, expiry, revision, creator and managers; never recipients or evidence).",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "view": {
        "type": "string",
        "enum": [
          "owned",
          "received",
          "administration"
        ]
      },
      "include_intents": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "view"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "view": {
              "enum": [
                "received",
                "administration"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "include_intents": {
              "const": false
            }
          }
        }
      }
    ]
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "shares": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "share_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "case_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "artifact_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "phase": {
                          "type": "string",
                          "minLength": 1
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "created_by": {
                          "$ref": "#/$defs/d2"
                        },
                        "managed_by": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/d2"
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "origin": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "sharingIntentID": {
                              "$ref": "#/$defs/d3"
                            },
                            "captureUID": {
                              "type": "string",
                              "minLength": 1
                            },
                            "selectionID": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]{0,62}$"
                            }
                          },
                          "required": [
                            "sharingIntentID",
                            "captureUID",
                            "selectionID"
                          ]
                        }
                      },
                      "required": [
                        "share_id",
                        "case_id",
                        "phase",
                        "expires_at"
                      ]
                    }
                  },
                  "intents": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "sharing_intent_id": {
                          "$ref": "#/$defs/d3"
                        },
                        "source_kind": {
                          "enum": [
                            "DebugCapture",
                            "DebugPolicy"
                          ]
                        },
                        "phase": {
                          "enum": [
                            "PendingApproval",
                            "Active",
                            "Draining",
                            "Completed",
                            "Revoked",
                            "Expired",
                            "Denied"
                          ]
                        },
                        "expires_at": {
                          "$ref": "#/$defs/d4"
                        },
                        "registered_captures": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max_captures": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "sharing_intent_id",
                        "source_kind",
                        "phase",
                        "expires_at",
                        "registered_captures",
                        "max_captures"
                      ]
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "shares"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "query_handle",
                  "revision"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
