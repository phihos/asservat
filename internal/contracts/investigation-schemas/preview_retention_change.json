          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "create"
                },
                "source_cluster_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "spec": {
                  "$ref": "#/$defs/d0"
                }
              },
              "required": [
                "action",
                "spec"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "update"
                },
                "source_cluster_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "uid": {
                  "type": "string",
                  "minLength": 1
                },
                "spec": {
                  "$ref": "#/$defs/d0"
                }
              },
              "required": [
                "action",
                "uid",
                "spec"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "delete"
                },
                "source_cluster_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "uid": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "action",
                "uid"
              ]
            }
          ]
        }
      },
      "cursor": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "changes"
    ],
