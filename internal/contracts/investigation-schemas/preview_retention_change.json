                  },
                  "artifacts_scanned": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "scan_limited": {
                    "type": "boolean"
                  },
                  "affected_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
