                  "read_closed_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "deletion_due_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "unknown_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "earliest_expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "earliest_delete_by": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "baseline_changed": {
                    "type": "boolean"
