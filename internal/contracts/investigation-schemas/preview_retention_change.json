                        "scanned": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "affected": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "read_closed": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "deletion_due": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "unknown": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "earliest_expires_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "earliest_delete_by": {
