                      "properties": {
                        "action": {
                          "enum": [
                            "create",
                            "update",
                            "delete"
                          ]
                        },
                        "source_cluster_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
