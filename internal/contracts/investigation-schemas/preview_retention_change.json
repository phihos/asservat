{
  "name": "preview_retention_change",
  "description": "Preview how proposed EvidenceRetentionPolicy changes would shorten the retention of evidence already stored, before applying them through Kubernetes (ADR-240). Applies the proposal to the latest accepted policies of the hub (no source_cluster_id) or of one cluster's local source exactly as reconciliation will after acceptance, over at most 10,000 retained artifacts whose deletion is not yet due: affected artifacts per cluster and class, how many would become unreadable or due for deletion at once, and the earliest new access end and deletion dates. A longer limit never moves an already bound date. Artifacts for which a newly selected label selector would need historical labels are Unknown, never assumed; clusters whose policy source is not current are listed as incomplete. For fleet operators; it changes nothing: apply the change with kubectl or GitOps.",
  "transports": [
    "browser"
  ],
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "changes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "create"
                },
                "source_cluster_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "spec": {
                  "$ref": "#/$defs/d0"
                }
              },
              "required": [
                "action",
                "spec"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "update"
                },
                "source_cluster_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "spec": {
                  "$ref": "#/$defs/d0"
                }
              },
              "required": [
                "action",
                "uid",
                "spec"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "delete"
                },
                "source_cluster_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "action",
                "uid"
              ]
            }
          ]
        }
      }
    },
    "required": [
      "changes"
    ],
    "$defs": {
      "d1": {
        "type": "string",
        "format": "uuid"
      },
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clusterIDs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/d1"
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "namespaceSelector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 16,
                    "propertyNames": {
                      "maxLength": 253
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63
                    }
                  }
                },
                "required": [
                  "matchLabels"
                ]
              },
              "workloadSelector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 16,
                    "propertyNames": {
                      "maxLength": 253
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63
                    }
                  }
                },
                "required": [
                  "matchLabels"
                ]
              }
            },
            "required": []
          },
          "purposeRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "defaults": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidenceSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 315360000
              },
              "caseMetadataSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 315360000
              },
              "auditMetadataSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 315360000
              }
            },
            "required": [
              "evidenceSeconds",
              "caseMetadataSeconds",
              "auditMetadataSeconds"
            ]
          },
          "maxima": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidenceSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 315360000
              },
              "caseMetadataSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 315360000
              },
              "auditMetadataSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 315360000
              }
            },
            "required": [
              "evidenceSeconds",
              "caseMetadataSeconds",
              "auditMetadataSeconds"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63
                },
                "privacyClasses": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "unknown",
                      "potentialPersonalData",
                      "personalData",
                      "specialCategoryPossible",
                      "verifiedNonPersonal"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 5,
                  "uniqueItems": true
                },
                "evidenceTypes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "coreDump",
                      "heapDump",
                      "packetCapture",
                      "logs",
                      "files",
                      "profile",
                      "commandOutput",
                      "context",
                      "other",
                      "syscallTrace"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 10,
                  "uniqueItems": true
                },
                "maxAgeSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 315360000
                }
              },
              "required": [
                "name",
                "maxAgeSeconds"
              ]
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "deletionBudgetSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "legalExceptions": {
            "type": "string",
            "enum": [
              "disabled",
              "reviewed"
            ]
          }
        },
        "required": [
          "scope",
          "purposeRef",
          "defaults",
          "maxima",
          "rules",
          "deletionBudgetSeconds",
          "legalExceptions"
        ]
      }
    }
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
