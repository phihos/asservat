                            "verifiedNonPersonal"
                          ]
                        },
                        "evidence_type": {
                          "enum": [
                            "coreDump",
                            "heapDump",
                            "packetCapture",
                            "syscallTrace",
                            "logs",
                            "files",
                            "profile",
                            "commandOutput",
                            "context",
                            "other"
                          ]
