{
  "name": "search_processing_evidence",
  "description": "Privacy operators search retained published evidence by an exact case ID or immutable workload identity and acquisition interval, optionally with an exact accepted purpose. Each page includes effective custody dates and recorded direct parents. An empty filtered page may have a continuation. The search grants no evidence access and does not discover user content.",
  "transports": [
    "browser"
  ],
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
