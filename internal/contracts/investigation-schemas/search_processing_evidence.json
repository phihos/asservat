{
  "name": "search_processing_evidence",
  "description": "Privacy operators search retained published evidence by an exact case ID or immutable workload identity and acquisition interval, optionally with an exact accepted purpose. Each page includes effective custody dates and recorded direct parents. An empty filtered page may have a continuation. The search grants no evidence access and does not discover user content.",
  "transports": [
    "browser"
  ],
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "type": "string",
        "format": "uuid"
      },
      "purpose_ref": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "default": 12
      },
      "after": {
        "oneOf": [
          {
            "$ref": "#/$defs/d0"
          },
          {
            "$ref": "#/$defs/d1"
          }
        ]
      },
      "cluster": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "description": "Cluster name as configured in the hub (ADR-335 D4)."
      },
      "namespace": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      },
      "workload": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
        "description": "Workload (Deployment, StatefulSet, DaemonSet or Pod) name."
      },
      "acquired_from": {
        "type": "string",
        "format": "date-time"
      },
      "acquired_until": {
        "type": "string",
        "format": "date-time"
      }
    },
    "oneOf": [
      {
        "$ref": "#/$defs/d2"
      },
      {
        "$ref": "#/$defs/d3"
      }
    ],
    "$defs": {
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "artifact_id"
        ]
      },
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "anchor_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "artifact_id",
          "anchor_at"
        ]
      },
      "d2": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "format": "uuid"
          },
          "purpose_ref": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "default": 12
          },
          "after": {
            "$ref": "#/$defs/d0"
          }
        },
        "required": [
          "case_id"
        ]
      },
      "d3": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster_id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace_uid": {
            "type": "string",
            "minLength": 1
          },
          "workload_uid": {
            "type": "string",
            "minLength": 1
          },
          "acquired_from": {
            "type": "string",
            "format": "date-time"
          },
          "acquired_until": {
            "type": "string",
            "format": "date-time"
          },
          "purpose_ref": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "default": 12
          },
          "after": {
            "$ref": "#/$defs/d1"
          }
        },
        "required": [
          "cluster_id",
          "namespace_uid",
          "workload_uid",
          "acquired_from",
          "acquired_until"
        ]
      }
    }
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "$ref": "#/$defs/d2"
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "d3": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "capture_id": {
            "type": "string",
            "format": "uuid"
          },
          "case_id": {
            "type": "string",
            "format": "uuid"
          },
          "cluster_id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace_uid": {
            "type": "string",
            "minLength": 1
          },
          "workload_uid": {
            "type": "string",
            "minLength": 1
          },
          "purpose_ref": {
            "type": "string",
            "minLength": 1
          },
          "native_type": {
            "type": "string",
            "minLength": 1
          },
          "data_class": {
            "enum": [
              "metadata",
              "raw",
              "extract"
            ]
          },
          "origin": {
            "enum": [
              "capture",
              "derived"
            ]
          },
          "anchor_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "delete_by": {
            "type": "string",
            "format": "date-time"
          },
          "custody_state": {
            "enum": [
              "stored_unpublished",
              "deleting"
            ]
          },
          "parents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "artifact_id",
          "capture_id",
          "case_id",
          "cluster_id",
          "namespace_uid",
          "workload_uid",
          "purpose_ref",
          "native_type",
          "data_class",
          "origin",
          "anchor_at",
          "expires_at",
          "delete_by",
          "custody_state",
          "parents"
        ]
      },
      "d4": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "artifact_id"
        ]
      },
      "d5": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "anchor_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "artifact_id",
          "anchor_at"
        ]
      },
      "d2": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d3"
            }
          },
          "next": {
            "oneOf": [
              {
                "$ref": "#/$defs/d4"
              },
              {
                "$ref": "#/$defs/d5"
              }
            ]
          }
        },
        "required": [
          "candidates"
        ]
      }
    }
  }
}
