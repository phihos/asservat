    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sharing_intent_id": {
                    "$ref": "#/$defs/d0"
                  },
                  "state": {
                    "const": "Stopped"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 1000000000
                  }
                },
                "required": [
