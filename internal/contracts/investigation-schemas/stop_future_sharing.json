{
  "name": "stop_future_sharing",
  "description": "Stop the future sharing of a recurring policy sharing (sharing_intent_id = the policy's acceptance_id from get_policy_status, expected_revision 1). No further capture is shared; captures already selected for sharing still publish their shares before the end, and existing shares stay until they expire or are revoked (revoke_share with the same sharing_intent_id revokes them). For its creator, a current member of a managing owner team or an installation administrator; it changes no collection authority.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sharing_intent_id": {
        "$ref": "#/$defs/d0"
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000000
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "sharing_intent_id",
      "expected_revision",
      "idempotency_key"
    ],
    "$defs": {
      "d0": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
