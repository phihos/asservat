{
  "name": "explain_access",
  "description": "Explain your own current access to one named workload for one operation (capture, read or download), evaluated by the same rules as the operation itself (ADR-234): Allow, Deny or Indeterminate, the unmet condition, and your own contributing AccessBinding assignments with their revisions. Never evaluates another principal and never reveals evidence. Without any assignment of yours on the workload, or for a workload that does not resolve, the answer is uniformly Deny/NoMatchingAllow.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster_id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet",
              "Pod"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "required": [
          "cluster_id",
          "namespace",
          "kind",
          "name"
        ]
      },
      "operation": {
        "enum": [
          "capture",
          "read",
          "download"
        ]
      }
    },
    "required": [
      "target_ref",
      "operation"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "decision": {
                    "enum": [
                      "Allow",
                      "Deny",
                      "Indeterminate"
                    ]
                  },
                  "operation": {
                    "enum": [
                      "capture",
                      "read",
                      "download"
                    ]
                  },
                  "unmet": {
                    "enum": [
                      "NoMatchingAllow",
                      "ExplicitDeny",
                      "ClientScopeMissing",
                      "PermissionObservationStale",
                      "IdentityUnavailable",
                      "AudienceOverflow",
                      "ServiceUnavailable"
                    ]
                  },
                  "missing_scope": {
                    "enum": [
                      "evidence:read",
                      "evidence:capture",
                      "evidence:download"
                    ]
                  },
                  "required_roles": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "evidence-reader",
                        "workload-maintainer",
                        "evidence-owner",
                        "action-approver"
                      ]
                    }
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "target": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cluster_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "namespace_uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "workload_uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "pod_uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "cluster_id",
                      "namespace_uid",
                      "workload_uid",
                      "pod_uid"
                    ]
                  },
                  "assignments": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "effect": {
                          "enum": [
                            "allow",
                            "deny"
                          ]
                        },
                        "assignment_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "role": {
                          "enum": [
                            "evidence-reader",
                            "workload-maintainer",
                            "evidence-owner",
                            "action-approver"
                          ]
                        },
                        "subject_kind": {
                          "enum": [
                            "User",
                            "Group",
                            "Workload"
                          ]
                        },
                        "basis_kind": {
                          "enum": [
                            "AccessBinding",
                            "PermissionSource"
                          ]
                        },
                        "basis_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "revision": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "effect",
                        "assignment_id",
                        "role",
                        "subject_kind",
                        "basis_kind",
                        "basis_uid",
                        "revision"
                      ]
                    }
                  },
                  "assignments_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 256
                  },
                  "valid_until": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "decision",
                  "operation",
                  "required_roles",
                  "message",
                  "assignments",
                  "assignments_total"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ]
  }
}
