{
  "name": "explain_access",
  "description": "Explain your own current access to one named workload for one operation (capture, read or download), evaluated by the same rules as the operation itself (ADR-234): Allow, Deny or Indeterminate, the unmet condition, and your own contributing assignments and their configuration revisions. Never evaluates another principal and never reveals evidence. Without any assignment of yours on the workload, or for a workload that does not resolve, the answer is uniformly Deny/NoMatchingAllow.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "description": "Cluster name as configured in the hub (ADR-335 D4)."
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet",
              "Pod"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "required": [
          "cluster",
          "namespace",
          "kind",
          "name"
        ]
      },
      "operation": {
        "enum": [
          "capture",
          "read",
          "download"
        ]
      }
    },
    "required": [
      "target_ref",
      "operation"
    ]
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "decision": {
                    "enum": [
                      "Allow",
                      "Deny",
                      "Indeterminate"
                    ]
                  },
                  "operation": {
                    "enum": [
                      "capture",
                      "read",
                      "download"
                    ]
                  },
                  "unmet": {
                    "enum": [
                      "NoMatchingAllow",
                      "ExplicitDeny",
                      "ClientScopeMissing",
                      "ClusterNotObserved",
                      "IdentityUnavailable",
                      "ServiceUnavailable"
                    ]
                  },
                  "missing_scope": {
                    "enum": [
                      "evidence:read",
                      "evidence:capture",
                      "evidence:download"
                    ]
                  },
                  "required_roles": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "evidence-reader",
                        "workload-maintainer",
                        "evidence-owner",
                        "action-approver"
                      ]
                    }
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cluster_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "namespace_uid": {
                        "type": "string",
                        "minLength": 1
                      },
                      "workload_uid": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pod_uid": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "cluster_id",
                      "namespace_uid",
                      "workload_uid",
                      "pod_uid"
                    ]
                  },
                  "assignments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "effect": {
                          "enum": [
                            "allow",
                            "deny"
                          ]
                        },
                        "assignment_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "role": {
                          "enum": [
                            "evidence-reader",
                            "workload-maintainer",
                            "evidence-owner",
                            "action-approver"
                          ]
                        },
                        "subject_kind": {
                          "enum": [
                            "User",
                            "Group",
                            "Workload"
                          ]
                        },
                        "basis_kind": {
                          "enum": [
                            "AccessBinding",
                            "ClusterAccessBinding",
                            "PermissionSource"
                          ]
                        },
                        "basis_uid": {
                          "type": "string",
                          "minLength": 1
                        },
                        "revision": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "effect",
                        "assignment_id",
                        "role",
                        "subject_kind",
                        "basis_kind",
                        "basis_uid",
                        "revision"
                      ]
                    },
                    "description": "The caller's contributing assignments from AccessBinding, ClusterAccessBinding and PermissionSource objects: the first 64, which fit one result frame; assignments_total counts all."
                  },
                  "assignments_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "decision",
                  "operation",
                  "required_roles",
                  "message",
                  "assignments",
                  "assignments_total"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
