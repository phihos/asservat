{
  "name": "preview_access_change",
  "description": "Preview the effect of proposed AccessBinding and PermissionSource changes before applying them through Kubernetes (ADR-237). For each workload scope of the affected namespaces (at most 1,000) within your administration, reports which users, groups or workloads named by the added or removed assignments would change between Allow, Deny and Indeterminate for capture, read and download, with the assignment revisions that decide each side, evaluated by the same rules as the operations themselves over the current accepted permission data. Targets whose permission data is unavailable or outside the enrolled clusters, and PermissionSource creations or edits whose namespace metadata the accepted observation lacks, are Indeterminate. Namespace-metadata sources are evaluated against the accepted namespace observation (ADR-242). The result is bounded to 256 KiB and delivered in pages: repeat the same request with next_cursor. Group members are never listed and no evidence is read. An AccessBinding change names the cluster and namespace it lives in (ADR-329). For fleet operators; it changes nothing: apply the change with kubectl or GitOps.",
  "transports": [
    "browser"
  ],
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "changes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "create"
                },
                "kind": {
                  "const": "AccessBinding"
                },
                "spec": {
                  "$ref": "#/$defs/d0"
                },
                "clusterID": {
                  "type": "string",
                  "format": "uuid"
                },
                "namespace": {
                  "$ref": "#/$defs/d5"
                }
              },
              "required": [
                "action",
                "kind",
                "spec",
                "clusterID",
                "namespace"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "update"
                },
                "kind": {
                  "const": "AccessBinding"
                },
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "spec": {
                  "$ref": "#/$defs/d0"
                },
                "clusterID": {
                  "type": "string",
                  "format": "uuid"
                },
                "namespace": {
                  "$ref": "#/$defs/d5"
                }
              },
              "required": [
                "action",
                "kind",
                "uid",
                "spec",
                "clusterID",
                "namespace"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "create"
                },
                "kind": {
                  "const": "PermissionSource"
                },
                "spec": {
                  "$ref": "#/$defs/d6"
                }
              },
              "required": [
                "action",
                "kind",
                "spec"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "update"
                },
                "kind": {
                  "const": "PermissionSource"
                },
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "spec": {
                  "$ref": "#/$defs/d6"
                }
              },
              "required": [
                "action",
                "kind",
                "uid",
                "spec"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "delete"
                },
                "kind": {
                  "enum": [
                    "AccessBinding",
                    "PermissionSource"
                  ]
                },
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "action",
                "kind",
                "uid"
              ]
            }
          ]
        }
      },
      "cursor": {
        "type": "string",
        "pattern": "^[0-9]{1,7}:[0-9a-f]{32}$"
      }
    },
    "required": [
      "changes"
    ],
    "$defs": {
      "d1": {
        "description": "Authored subject (ADR-335 D4): a user by username, a group by the name the provider emits (for example /payments) or a workload identity. issuer defaults to the installation's issuer.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "User",
              "Group",
              "Workload"
            ]
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id"
        ]
      },
      "d2": {
        "type": "string",
        "enum": [
          "evidence-reader",
          "workload-maintainer",
          "evidence-owner",
          "action-approver"
        ]
      },
      "d3": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Deployment",
              "StatefulSet"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Kubernetes object name (DNS subdomain)."
          },
          "uid": {
            "type": "string",
            "minLength": 1,
            "description": "Kubernetes UID (a UUID; 64 characters leaves room for its textual forms)."
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "description": "Workload by kind and name; a recreated workload of the same name keeps its access. Optional uid pins one instance."
      },
      "d4": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowedActions": {
            "type": "array",
            "items": {
              "enum": [
                "kubernetesSnapshot",
                "logs",
                "processSnapshot",
                "fileRead",
                "packetCapture",
                "networkSnapshot",
                "runtimeDiagnostic",
                "kernelCore",
                "liveCore",
                "command",
                "httpDiagnostic",
                "artifactCollect",
                "profile",
                "syscallTrace"
              ],
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 14,
            "uniqueItems": true
          },
          "maxLifetimeSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31536000
          },
          "maxExecutions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1099511627776
          },
          "maxObservedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1099511627776
          },
          "maxObservedEvents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        },
        "required": [
          "allowedActions",
          "maxLifetimeSeconds",
          "maxExecutions",
          "maxBytes",
          "maxObservedBytes"
        ]
      },
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "effect": {
            "type": "string",
            "enum": [
              "Allow",
              "Deny"
            ]
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d2"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "workloads": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d3"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "notAfter": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Optional."
          },
          "automation": {
            "$ref": "#/$defs/d4"
          }
        },
        "required": [
          "effect",
          "subjects",
          "roles"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "automation"
              ]
            },
            "then": {
              "properties": {
                "effect": {
                  "const": "Allow"
                },
                "subjects": {
                  "items": {
                    "properties": {
                      "kind": {
                        "const": "Group"
                      }
                    }
                  }
                },
                "roles": {
                  "contains": {
                    "const": "workload-maintainer"
                  }
                }
              }
            }
          }
        ],
        "description": "Lists are not capped: the Kubernetes object size limit (about 1.5 MiB) bounds them; roles are bounded by their enum and uniqueItems."
      },
      "d5": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "description": "Kubernetes namespace name (DNS label)."
          },
          "uid": {
            "type": "string",
            "minLength": 1,
            "description": "Kubernetes UID (a UUID; 64 characters leaves room for its textual forms)."
          }
        },
        "required": [
          "name",
          "uid"
        ]
      },
      "d7": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "matchLabels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "description": "Label values are at most 63 characters (Kubernetes label syntax). Not capped: the Kubernetes object size limit (about 1.5 MiB in etcd) bounds this list."
          }
        },
        "required": [
          "matchLabels"
        ]
      },
      "d8": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "administratorManaged",
              "admissionEnforced"
            ]
          },
          "reviewRef": {
            "type": "string",
            "minLength": 1
          },
          "guardRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "mode"
        ],
        "description": "administratorManaged: the source itself is the administrator's statement. admissionEnforced: the Helm-rendered label ValidatingAdmissionPolicy protects the keys. reviewRef and guardRef are optional notes."
      },
      "d9": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "annotation",
              "label"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "Kubernetes label or annotation key (at most 253 characters)."
          },
          "mode": {
            "type": "string",
            "enum": [
              "groupName",
              "valueMap"
            ]
          },
          "issuer": {
            "type": "string",
            "format": "uri",
            "description": "Defaults to the installation's issuer."
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "prefix": {
            "description": "groupName mode: prepended to the value (label values cannot contain /).",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "key",
          "mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "valueMap"
                }
              }
            },
            "then": {
              "required": [
                "values"
              ],
              "properties": {
                "values": {
                  "minProperties": 1
                }
              },
              "not": {
                "required": [
                  "prefix"
                ]
              }
            },
            "else": {
              "not": {
                "required": [
                  "values"
                ]
              }
            }
          }
        ]
      },
      "d6": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "cluster": {
            "description": "Name of the cluster the source derives access in (ADR-335 D4).",
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "type": {
            "type": "string",
            "enum": [
              "namespaceMetadata",
              "workloadMetadata",
              "kubernetesExec",
              "kubernetesAccessReview"
            ]
          },
          "namespaceSelector": {
            "$ref": "#/$defs/d7"
          },
          "excludedNamespaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "uniqueItems": true,
            "description": "Namespace names (DNS label, 63 characters). Not capped: the Kubernetes object size limit (about 1.5 MiB in etcd) bounds this list."
          },
          "role": {
            "$ref": "#/$defs/d2"
          },
          "protection": {
            "$ref": "#/$defs/d8"
          },
          "metadataMapping": {
            "$ref": "#/$defs/d9"
          },
          "workloadSelector": {
            "$ref": "#/$defs/d7"
          },
          "identityMappingRef": {
            "type": "string",
            "minLength": 1
          },
          "admissionParity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "noAdditionalRestrictions",
                  "qualifiedAdapter"
                ]
              },
              "reviewRef": {
                "type": "string",
                "minLength": 1
              },
              "adapterRef": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "mode"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "qualifiedAdapter"
                    }
                  }
                },
                "then": {
                  "required": [
                    "adapterRef"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "adapterRef"
                    ]
                  }
                }
              }
            ]
          },
          "accessReview": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "check": {
                "type": "string",
                "enum": [
                  "namespaceCaptureCreate",
                  "workloadGet",
                  "workloadPatch",
                  "workloadUpdate"
                ]
              }
            },
            "required": [
              "check"
            ]
          }
        },
        "required": [
          "enabled",
          "cluster",
          "type",
          "role"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "namespaceMetadata",
                    "workloadMetadata"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "protection",
                "metadataMapping"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "identityMappingRef"
                    ]
                  },
                  {
                    "required": [
                      "admissionParity"
                    ]
                  },
                  {
                    "required": [
                      "accessReview"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "identityMappingRef",
                "admissionParity"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "protection"
                    ]
                  },
                  {
                    "required": [
                      "metadataMapping"
                    ]
                  },
                  {
                    "required": [
                      "workloadSelector"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "workloadMetadata"
                }
              }
            },
            "then": {
              "required": [
                "workloadSelector"
              ],
              "properties": {
                "protection": {
                  "properties": {
                    "mode": {
                      "const": "admissionEnforced"
                    }
                  }
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "workloadSelector"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "kubernetesExec"
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "const": "workload-maintainer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "kubernetesAccessReview"
                }
              }
            },
            "then": {
              "required": [
                "accessReview"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "accessReview"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9]{1,7}:[0-9a-f]{32}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "complete": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "targets_evaluated": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "fresh_until": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "deltas_total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unavailable_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "listed_rows": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "page_offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unavailable": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cluster_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "namespace_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "workload_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "other_workloads": {
                          "type": "boolean"
                        },
                        "decision": {
                          "const": "Indeterminate"
                        },
                        "unmet": {
                          "enum": [
                            "PermissionObservationStale",
                            "ServiceUnavailable",
                            "ClusterUnavailable"
                          ]
                        }
                      },
                      "required": [
                        "cluster_id",
                        "namespace_uid",
                        "workload_uid",
                        "other_workloads",
                        "decision",
                        "unmet"
                      ]
                    }
                  },
                  "deltas": {
                    "type": "array",
                    "maxItems": 4096,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cluster_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "namespace_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "workload_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "other_workloads": {
                          "type": "boolean"
                        },
                        "subject": {
                          "$ref": "#/$defs/d0"
                        },
                        "operation": {
                          "enum": [
                            "capture",
                            "read",
                            "download"
                          ]
                        },
                        "before": {
                          "enum": [
                            "Allow",
                            "Deny",
                            "Indeterminate"
                          ]
                        },
                        "after": {
                          "enum": [
                            "Allow",
                            "Deny",
                            "Indeterminate"
                          ]
                        },
                        "before_unmet": {
                          "enum": [
                            "NoMatchingAllow",
                            "ExplicitDeny",
                            "PermissionObservationStale",
                            "AudienceOverflow",
                            "ServiceUnavailable",
                            "DecisionTimeSource"
                          ]
                        },
                        "after_unmet": {
                          "enum": [
                            "NoMatchingAllow",
                            "ExplicitDeny",
                            "PermissionObservationStale",
                            "AudienceOverflow",
                            "ServiceUnavailable",
                            "DecisionTimeSource"
                          ]
                        },
                        "before_basis": {
                          "type": "array",
                          "maxItems": 8,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "effect": {
                                "enum": [
                                  "allow",
                                  "deny"
                                ]
                              },
                              "role": {
                                "$ref": "#/$defs/d1"
                              },
                              "subject_kind": {
                                "enum": [
                                  "User",
                                  "Group",
                                  "Workload"
                                ]
                              },
                              "basis_kind": {
                                "enum": [
                                  "AccessBinding",
                                  "PermissionSource"
                                ]
                              },
                              "basis_uid": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "revision": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              "proposed": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "effect",
                              "role",
                              "subject_kind",
                              "basis_kind",
                              "basis_uid",
                              "revision",
                              "proposed"
                            ]
                          }
                        },
                        "after_basis": {
                          "type": "array",
                          "maxItems": 8,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "effect": {
                                "enum": [
                                  "allow",
                                  "deny"
                                ]
                              },
                              "role": {
                                "$ref": "#/$defs/d1"
                              },
                              "subject_kind": {
                                "enum": [
