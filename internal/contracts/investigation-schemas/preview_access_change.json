{
  "name": "preview_access_change",
  "description": "Preview the effect of proposed AccessBinding changes before applying them through Kubernetes (ADR-237). For each workload scope of the affected namespaces (at most 1,000), reports which users, groups or workloads named by the added or removed assignments would change between Allow, Deny and Indeterminate for capture, read and download, evaluated by the same rules as the operations themselves over the current accepted permission data. Targets whose permission data is unavailable or outside the enrolled clusters are reported Indeterminate. Group members are never listed and no evidence is read. Only for fleet operators; it changes nothing: apply the change with kubectl or GitOps.",
  "transports": [
    "browser"
  ],
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "changes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "create"
                },
                "kind": {
                  "const": "AccessBinding"
                },
                "spec": {
                  "$ref": "#/$defs/d0"
                }
              },
              "required": [
                "action",
                "kind",
                "spec"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "update"
                },
                "kind": {
                  "const": "AccessBinding"
                },
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "spec": {
                  "$ref": "#/$defs/d0"
                }
              },
              "required": [
                "action",
                "kind",
                "uid",
                "spec"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "delete"
                },
                "kind": {
                  "enum": [
                    "AccessBinding",
                    "PermissionSource"
                  ]
                },
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "action",
                "kind",
                "uid"
              ]
            }
          ]
        }
      }
    },
    "required": [
      "changes"
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "User",
              "Group",
              "Workload"
            ]
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "kind",
          "issuer",
          "id"
        ]
      },
      "d2": {
        "type": "string",
        "enum": [
          "evidence-reader",
          "workload-maintainer",
          "evidence-owner",
          "action-approver"
        ]
      },
      "d4": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "name",
          "uid"
        ]
      },
      "d5": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Deployment",
              "StatefulSet"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "kind",
          "name",
          "uid"
        ]
      },
      "d3": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clusterID": {
            "type": "string",
            "format": "uuid"
          },
          "namespaceRef": {
            "$ref": "#/$defs/d4"
          },
          "workloads": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d5"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "clusterID",
          "namespaceRef"
        ]
      },
      "d6": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowedActions": {
            "type": "array",
            "items": {
              "enum": [
                "kubernetesSnapshot",
                "logs",
                "processSnapshot",
                "fileRead",
                "packetCapture",
                "networkSnapshot",
                "runtimeDiagnostic",
                "kernelCore",
                "liveCore",
                "command",
                "httpDiagnostic",
                "artifactCollect",
                "profile",
                "syscallTrace"
              ],
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 14,
            "uniqueItems": true
          },
          "maxLifetimeSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31536000
          },
          "maxExecutions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1099511627776
          },
          "maxObservedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1099511627776
          }
        },
        "required": [
          "allowedActions",
          "maxLifetimeSeconds",
          "maxExecutions",
          "maxBytes",
          "maxObservedBytes"
        ]
      },
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "effect": {
            "type": "string",
            "enum": [
              "Allow",
              "Deny"
            ]
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d2"
            },
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true
          },
          "scope": {
            "$ref": "#/$defs/d3"
          },
          "notAfter": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "automation": {
            "$ref": "#/$defs/d6"
          }
        },
        "required": [
          "effect",
          "subjects",
          "roles",
          "scope",
          "reason"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "automation"
              ]
            },
            "then": {
              "properties": {
                "effect": {
                  "const": "Allow"
                },
                "subjects": {
                  "items": {
                    "properties": {
                      "kind": {
                        "const": "Group"
                      }
                    }
                  }
                },
                "roles": {
                  "contains": {
                    "const": "workload-maintainer"
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "complete": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "targets_evaluated": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "deltas_total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "deltas": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cluster_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "namespace_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "workload_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "other_workloads": {
                          "type": "boolean"
                        },
                        "subject": {
                          "$ref": "#/$defs/d0"
                        },
                        "operation": {
                          "enum": [
                            "capture",
                            "read",
                            "download"
                          ]
                        },
                        "before": {
                          "enum": [
                            "Allow",
                            "Deny",
                            "Indeterminate"
                          ]
                        },
                        "after": {
                          "enum": [
                            "Allow",
                            "Deny",
                            "Indeterminate"
                          ]
                        },
                        "after_unmet": {
                          "enum": [
                            "NoMatchingAllow",
                            "ExplicitDeny",
                            "PermissionObservationStale",
                            "AudienceOverflow",
                            "ServiceUnavailable"
                          ]
                        }
                      },
                      "required": [
                        "cluster_id",
                        "namespace_uid",
                        "workload_uid",
                        "other_workloads",
                        "subject",
                        "operation",
                        "before",
                        "after"
                      ]
                    }
                  },
                  "unavailable_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "unavailable": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cluster_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "namespace_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "workload_uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "other_workloads": {
                          "type": "boolean"
                        },
                        "decision": {
                          "const": "Indeterminate"
                        },
                        "unmet": {
                          "enum": [
                            "PermissionObservationStale",
                            "ServiceUnavailable",
                            "ClusterUnavailable"
                          ]
                        }
                      },
                      "required": [
                        "cluster_id",
                        "namespace_uid",
                        "workload_uid",
                        "other_workloads",
                        "decision",
                        "unmet"
                      ]
                    }
                  },
                  "unmatched": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "enum": [
                            "AccessBinding",
                            "PermissionSource"
                          ]
                        },
                        "uid": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "required": [
                        "kind",
                        "uid"
                      ]
                    }
                  }
                },
                "required": [
                  "complete",
                  "message",
                  "targets_evaluated",
                  "deltas_total",
                  "deltas",
                  "unavailable_total",
                  "unavailable",
                  "unmatched"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "User",
              "Group",
              "Workload"
            ]
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "kind",
          "issuer",
          "id"
        ]
      }
    }
  }
}
