{
  "name": "list_artifacts",
  "description": "List permitted artifact descriptors without storage credentials.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "type": "string",
        "format": "uuid"
      },
      "cursor": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "case_id"
    ]
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "artifacts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "artifact_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$",
                          "description": "Immutable verified artifact version. For the current pod-status artifact this is SHA-256 of the existing serialized verified ciphertext copy receipts, not the native file checksum. The prepared download supplies the native SHA-256 separately."
                        },
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "data_class": {
                          "type": "string",
                          "enum": [
                            "metadata",
                            "extract",
                            "raw"
                          ]
                        },
                        "completeness": {
                          "type": "string",
                          "minLength": 1
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "handling_notice": {
                          "$ref": "#/$defs/d2"
                        }
                      },
                      "required": [
                        "artifact_id",
                        "digest",
                        "kind",
                        "data_class",
                        "completeness",
                        "expires_at",
                        "handling_notice"
                      ]
                    }
                  }
                },
                "required": [
                  "artifacts"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "query_handle",
                  "revision"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "d3": {
        "type": "string",
        "enum": [
          "unknown",
          "potentialPersonalData",
          "personalData",
          "specialCategoryPossible",
          "verifiedNonPersonal"
        ]
      },
      "d2": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "classification": {
            "$ref": "#/$defs/d3"
          },
          "mayContain": {
            "type": "array",
            "items": {
              "enum": [
                "userContent",
                "credentials",
                "personalIdentifiers",
                "networkAddresses",
                "paths",
                "profileLabels",
                "unknownApplicationData"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "deleteBy": {
            "type": "string",
            "format": "date-time"
          },
          "deletionState": {
            "enum": [
              "pending",
              "verified",
              "overdue",
              "restrictedPreservation"
            ]
          },
          "automaticDeletion": {
            "const": true
          },
          "managedCopiesOnly": {
            "const": true
          },
          "externalCopiesRecallable": {
            "const": false
          },
          "handlingCodes": {
            "type": "array",
            "items": {
              "enum": [
                "minimizeCapture",
                "restrictAccess",
                "preferApprovedExtracts",
                "reviewBeforeSharing",
                "approvedClientsOnly",
                "externalCopiesNotRecalled"
              ]
            },
            "minItems": 6,
            "uniqueItems": true
          },
          "preservationException": {
            "type": "boolean"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "handlingPolicyRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "classification",
          "mayContain",
          "expiresAt",
          "deleteBy",
          "deletionState",
          "automaticDeletion",
          "managedCopiesOnly",
          "externalCopiesRecallable",
          "handlingCodes",
          "preservationException",
          "asOf"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "verifiedNonPersonal"
                }
              }
            },
            "then": {
              "properties": {
                "mayContain": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
