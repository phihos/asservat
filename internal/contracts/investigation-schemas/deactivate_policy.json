{
  "name": "deactivate_policy",
  "description": "Stop a DebugPolicy named by cluster, namespace and name. Requires the policy's workload-maintainer rights. No further occurrence is admitted once it commits; existing captures and evidence stay. Repeating it is harmless; re-applying the policy resumes it.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "cluster": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "description": "Cluster name as configured in the hub (ADR-335 D4)."
      },
      "namespace": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      },
      "policy_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "cluster",
      "namespace",
      "policy_name",
      "idempotency_key"
    ]
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "policy_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  },
                  "policy_uid": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Provenance only."
                  },
                  "acceptance_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "state": {
                    "const": "deactivated"
                  },
                  "replay": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "policy_name",
                  "namespace",
                  "acceptance_id",
                  "state",
                  "replay"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
