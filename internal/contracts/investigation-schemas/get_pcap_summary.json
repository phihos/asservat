{
  "name": "get_pcap_summary",
  "description": "Read a bounded numeric summary of saved network-header or raw packet recordings. Raw originals stay raw; the fixed projection omits payload, names and comments. Saved records without usable headers are explicit; reported exclusions are not measured network loss. Raw queries and native downloads retain their separate authority.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "type": "string",
        "format": "uuid"
      },
      "artifact_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "case_id",
      "artifact_id"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "enum": [
          "metadata",
          "extract"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/d0"
        },
        "maxItems": 1,
        "minItems": 0,
        "uniqueItems": true
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "capture_mode": {
                    "type": "string",
                    "enum": [
                      "networkHeaders",
                      "rawPackets"
                    ]
                  },
                  "packets": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000,
                    "description": "Retained packet records in the authenticated saved file; this is not a count of unique network datagrams."
                  },
                  "drops": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000000,
                    "description": "Producer-reported exclusions with the exact meaning given by drop_reporting; null means unavailable. This is not measured network loss."
                  },
                  "conversations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "source": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "destination": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "protocol": {
                          "enum": [
                            "TCP",
                            "UDP",
                            "ICMPv4",
                            "ICMPv6"
                          ]
                        },
                        "packets": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000000000
                        }
                      },
                      "required": [
                        "source",
                        "destination",
                        "protocol",
                        "packets"
                      ]
                    },
                    "maxItems": 100,
                    "description": "Top100 directional numeric endpoint/protocol aggregates, ordered by record count descending then protocol/source/destination; never DNS, comments or payload."
                  },
                  "drop_reporting": {
                    "enum": [
                      "captureExclusions",
                      "snapshotOutputLimit",
                      "unavailable"
                    ]
                  },
                  "conversations_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "conversations_truncated": {
                    "type": "boolean"
                  },
                  "query_observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Server time of this prepared query snapshot. This observation does not renew query or request authority. Together with query_expires_at it bounds managed-view lifetime independently of the client wall clock."
                  },
                  "query_expires_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Original total query cutoff, irreversibly shortened by effective evidence access. A poll never extends it. Managed views clear by this cutoff or earlier on scope loss or closure; this cannot recall external copies. Distinct from the current request disclosure deadline."
                  },
                  "unclassified_packets": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000,
                    "description": "Saved raw packet records without usable complete headers. These records remain in packets but not conversations; this is not a drop or network-loss count. Required for rawPackets and omitted for networkHeaders."
                  }
                },
                "required": [
                  "capture_mode",
                  "packets",
                  "drops",
                  "conversations",
                  "drop_reporting",
                  "conversations_total",
                  "conversations_truncated",
                  "query_observed_at",
                  "query_expires_at"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "capture_mode": {
                          "const": "rawPackets"
                        }
                      },
                      "required": [
                        "capture_mode"
                      ]
                    },
                    "then": {
                      "required": [
                        "unclassified_packets"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "unclassified_packets"
                        ]
                      }
                    }
                  }
                ]
              },
              "data_class": {
                "const": "extract"
              },
              "provenance": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "query_observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Server time of this prepared query snapshot. This observation does not renew query or request authority. Together with query_expires_at it bounds managed-view lifetime independently of the client wall clock."
                  },
                  "query_expires_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Original total query cutoff, irreversibly shortened by effective evidence access. A poll never extends it. Managed views clear by this cutoff or earlier on scope loss or closure; this cannot recall external copies. Distinct from the current request disclosure deadline."
                  }
                },
                "required": [
                  "query_handle",
                  "retry_after_seconds",
                  "query_observed_at",
                  "query_expires_at"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d0": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      }
    }
  }
}
