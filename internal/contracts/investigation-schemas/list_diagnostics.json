                                "Pod",
                                "Deployment",
                                "StatefulSet",
                                "Service"
                              ]
                            },
                            "namespace": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253
                            },
                            "serviceMode": {
                              "enum": [
                                "backends",
                                "virtualIP",
                                "both"
                              ]
                            },
                            "readyOnly": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "kind",
                            "namespace",
                            "name"
                          ],
                          "allOf": [
                            {
                              "if": {
                                "properties": {
                                  "kind": {
