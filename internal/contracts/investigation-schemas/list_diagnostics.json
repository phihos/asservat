                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "rawPackets"
                  },
                  "snaplen": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "protocolSnaplen": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "protocol": {
                          "enum": [
                            "tcp",
                            "udp",
                            "icmp"
