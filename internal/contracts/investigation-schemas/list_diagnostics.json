                              "additionalProperties": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 63
                              }
                            }
                          },
                          "required": [
                            "namespace",
                            "matchLabels"
                          ]
                        }
                      },
                      "required": [
                        "podSelector"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "resourceRef": {
                          "type": "object",
                          "additionalProperties": false,
