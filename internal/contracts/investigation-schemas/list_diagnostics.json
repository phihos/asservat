                              "code": {
                                "type": "string",
                                "minLength": 1
                              },
                              "message": {
                                "type": "string",
                                "minLength": 1
                              },
                              "responsible_role": {
                                "enum": [
                                  "maintainer",
                                  "approver",
                                  "administrator",
                                  "none"
                                ]
                              },
                              "retryable": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "code",
                              "message",
                              "responsible_role",
                              "retryable"
                            ]
                          },
                          "minItems": 0
                        },
                        "preset_ref": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "name": {
                              "enum": [
                                "incident-context",
                                "pod-status"
                              ]
                            },
                            "version": {
                              "const": "v1"
                            }
                          },
                          "required": [
                            "name",
                            "version"
                          ]
                        },
                        "kind": {
                          "enum": [
                            "preset",
                            "recipe",
                            "captureProfile",
                            "discovery"
                          ]
                        },
                        "profile_ref": {
                          "$ref": "#/$defs/d2"
                        },
                        "deprecated": {
                          "type": "boolean"
                        },
                        "display_name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "execution_modes": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "onTrigger",
                              "ongoing"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "kind",
                        "name",
                        "version",
                        "description",
                        "approval_required",
                        "available",
                        "blockers",
                        "execution_modes"
                      ],
                      "oneOf": [
                        {
                          "required": [
                            "diagnostic_handle"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "preset_ref"
                                ]
                              },
                              {
                                "required": [
                                  "profile_ref"
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "required": [
                            "preset_ref"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "diagnostic_handle"
                                ]
                              },
                              {
                                "required": [
                                  "profile_ref"
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "required": [
                            "profile_ref"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "diagnostic_handle"
                                ]
                              },
                              {
                                "required": [
                                  "preset_ref"
                                ]
                              }
                            ]
                          }
                        }
                      ],
                      "allOf": [
                        {
                          "if": {
                            "required": [
                              "preset_ref"
                            ]
                          },
                          "then": {
                            "properties": {
                              "version": {
                                "const": "v1"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "kind": {
                                "const": "captureProfile"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "profile_ref"
                            ]
                          }
                        },
                        {
                          "if": {
                            "required": [
                              "profile_ref"
                            ]
                          },
                          "then": {
                            "properties": {
                              "kind": {
                                "const": "captureProfile"
                              }
                            }
                          }
                        }
                      ]
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "diagnostics"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "$ref": "#/$defs/d3"
              },
              "data_class": {
                "const": "extract"
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
