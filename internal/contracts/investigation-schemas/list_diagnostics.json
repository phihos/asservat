{
  "name": "list_diagnostics",
  "description": "List the supported pod-status preset for a currently authorized named workload. No evidence collection.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster_id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet",
              "Pod"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "required": [
          "cluster_id",
          "namespace",
          "kind",
          "name"
        ]
      }
    },
    "required": [
      "target_ref"
    ]
  },
  "outputSchema": {
    "title": "Asservat mcp-result v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "mcp-result/v1"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "data_class": {
        "const": "metadata"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "error"
        ]
      },
      "data": {
        "type": "object"
      },
      "truncated": {
        "const": false
      },
      "next_cursor": {
        "type": "null"
      },
      "narrowing_hint": {
        "type": "null"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "maxItems": 32,
        "minItems": 0,
        "uniqueItems": true
      },
      "provenance": {
        "type": "array",
        "maxItems": 0
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "data_class",
      "status",
      "data",
      "truncated",
      "next_cursor",
      "narrowing_hint",
      "warnings",
      "provenance"
    ],
    "allOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "diagnostics": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "approval_required": {
                          "type": "boolean"
                        },
                        "available": {
                          "type": "boolean"
                        },
                        "blockers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "code": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "message": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              },
                              "responsible_role": {
                                "enum": [
                                  "maintainer",
                                  "approver",
                                  "administrator",
                                  "none"
                                ]
                              },
                              "retryable": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "code",
                              "message",
                              "responsible_role",
                              "retryable"
                            ]
                          },
                          "minItems": 0,
                          "maxItems": 16
                        },
                        "preset_ref": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "name": {
                              "const": "pod-status"
                            },
                            "version": {
                              "const": "v1"
                            }
                          },
                          "required": [
                            "name",
                            "version"
                          ]
                        }
                      },
                      "required": [
                        "name",
                        "version",
                        "description",
                        "approval_required",
                        "available",
                        "blockers",
                        "preset_ref"
                      ]
                    },
                    "minItems": 0,
                    "maxItems": 1
                  }
                },
                "required": [
                  "diagnostics"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ]
  }
}
