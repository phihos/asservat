      },
      "d8": {
        "title": "Bounded packet action parameters",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "networkHeaders"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
