                                "not": {
                                  "anyOf": [
                                    {
                                      "required": [
                                        "serviceMode"
                                      ]
                                    },
                                    {
                                      "required": [
                                        "readyOnly"
                                      ]
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      },
                      "required": [
                        "resourceRef"
                      ]
                    }
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "protocol": {
                "enum": [
                  "tcp",
                  "udp",
                  "icmp",
                  "any"
                ]
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "resolution": {
                "enum": [
                  "frozen",
                  "follow"
                ]
              }
            },
            "required": [
              "entries",
              "protocol",
              "resolution"
            ],
            "description": "Peer generations are bounded only by the compiled program limit (BPF_MAXINSNS 4096)."
          }
        },
        "required": [
