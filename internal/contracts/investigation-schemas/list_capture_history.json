{
  "name": "list_capture_history",
  "description": "List bounded accepted capture history for the same currently authorized selector. Default manual origin; retained audience and current rights required. Does not acquire evidence or expose shared-only request settings.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_handle": {
        "type": "string",
        "minLength": 1
      },
      "target_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "description": "Cluster name as configured in the hub (ADR-335 D4)."
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet",
              "Pod"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "required": [
          "cluster",
          "namespace",
          "kind",
          "name"
        ]
      },
      "cluster": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "description": "Cluster name as configured in the hub (ADR-335 D4)."
      },
      "target": {
        "$ref": "#/$defs/d0"
      },
      "origin": {
        "enum": [
          "manual",
          "policy",
          "discovery",
          "all"
        ]
      },
      "cursor": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "required": [],
    "oneOf": [
      {
        "required": [
          "target_handle"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "cluster"
              ]
            },
            {
              "required": [
                "target"
              ]
            },
            {
              "required": [
                "target_ref"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "target_ref"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "target_handle"
              ]
            },
            {
              "required": [
                "cluster"
              ]
            },
            {
              "required": [
                "target"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "cluster",
          "target"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "target_handle"
              ]
            },
            {
              "required": [
                "target_ref"
              ]
            }
          ]
        }
      }
    ],
    "$defs": {
      "d0": {
        "title": "Asservat target v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "description": "Defaults to the object's own namespace; must equal it when given."
          },
          "workloadRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "apiVersion": {
                "type": "string",
                "enum": [
                  "apps/v1",
                  "v1"
                ],
                "description": "Optional; derived from the kind."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "Deployment",
                  "StatefulSet",
                  "Pod"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "uid": {
                "type": "string",
                "minLength": 1,
                "description": "Optional pin with adoption: pinUID; otherwise provenance only."
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "Pod"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "apiVersion": {
                      "const": "v1"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "apiVersion": {
                      "const": "apps/v1"
                    }
                  }
                }
              }
            ]
          },
          "podSelector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "matchLabels": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63
                }
              }
            },
            "required": [
              "matchLabels"
            ]
          },
          "maxPods": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Maximum pods collected per occurrence; never the monitoring coverage limit.",
            "default": 1
          },
          "selection": {
            "type": "string",
            "enum": [
              "oldestReady",
              "newest",
              "allWithinLimit",
              "lowestOrdinal",
              "triggeringPod"
            ],
            "description": "Defaults to triggeringPod for policies and oldestReady for manual captures."
          },
          "ordinals": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "adoption": {
            "type": "string",
            "enum": [
              "followName",
              "pinUID"
            ],
            "default": "followName"
          }
        },
        "required": [],
        "oneOf": [
          {
            "required": [
              "workloadRef"
            ],
            "not": {
              "required": [
                "podSelector"
              ]
            }
          },
          {
            "required": [
              "podSelector"
            ],
            "not": {
              "required": [
                "workloadRef"
              ]
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "ordinals"
              ]
            },
            "then": {
              "required": [
                "workloadRef"
              ],
              "properties": {
                "workloadRef": {
                  "properties": {
                    "kind": {
                      "const": "StatefulSet"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "outputSchema": {
    "allOf": [
      {
        "$ref": "#/$defs/d0"
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "ok"
              },
              "data": {
                "$ref": "#/$defs/d2"
              },
              "data_class": {
                "const": "metadata"
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "pending"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query_handle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "query_handle",
                  "revision"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "error"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "navigation_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "responsible_role": {
                    "enum": [
                      "maintainer",
                      "approver",
                      "administrator",
                      "none"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "status",
              "data"
            ]
          }
        ]
      }
    ],
    "$defs": {
      "d1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "type": "string",
            "format": "uuid"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactID",
          "digest"
        ]
      },
      "d0": {
        "title": "Asservat mcp-result v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "mcp-result/v1"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "pending",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "narrowing_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d1"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "data_class",
          "status",
          "data",
          "truncated",
          "next_cursor",
          "narrowing_hint",
          "warnings",
          "provenance"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "properties": {
                "narrowing_hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "d3": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capture_id": {
            "type": "string",
            "format": "uuid"
          },
          "origin": {
            "enum": [
              "manual",
              "policy",
              "discovery"
            ]
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "phase": {
            "enum": [
              "Pending",
              "AwaitingApproval",
              "Armed",
              "Running",
              "Succeeded",
              "Partial",
              "Failed",
              "Cancelled",
              "Indeterminate"
            ]
          },
          "action_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "kubernetesSnapshot",
                "logs",
                "processSnapshot",
                "fileRead",
                "packetCapture",
                "networkSnapshot",
                "runtimeDiagnostic",
                "kernelCore",
                "liveCore",
                "command",
                "httpDiagnostic",
                "artifactCollect",
                "profile",
                "syscallTrace"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_state": {
            "enum": [
              "pending",
              "available",
              "partial",
              "expired",
              "unavailable"
            ]
          },
          "repeat_state": {
            "enum": [
              "available",
              "requiresSelection",
              "parametersExpired",
              "parametersUnavailable",
              "targetUnavailable"
            ]
          },
          "settings_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "repeated_from_capture_id": {
            "type": "string",
            "format": "uuid"
          },
          "navigation_uri": {
            "type": "string",
            "format": "uri"
          },
          "operation": {
            "enum": [
              "collect",
              "recordingSave"
            ]
          },
          "requester": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "issuer": {
                "type": "string",
                "format": "uri"
              },
              "subject_id": {
                "type": "string",
                "minLength": 1
              },
              "identity_type": {
                "enum": [
                  "human",
                  "service",
                  "policy"
                ]
              }
            },
            "required": [
              "issuer",
              "subject_id",
              "identity_type"
            ]
          }
        },
        "required": [
          "capture_id",
          "origin",
          "accepted_at",
          "summary_expires_at",
          "phase",
          "action_kinds",
          "evidence_state",
          "repeat_state",
          "navigation_uri"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "repeat_state": {
                  "enum": [
                    "available",
                    "requiresSelection"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "settings_expires_at"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "recordingSave"
                }
              },
              "required": [
                "operation"
              ]
            },
            "then": {
              "properties": {
                "origin": {
                  "const": "manual"
                },
                "repeat_state": {
                  "enum": [
                    "requiresSelection",
                    "parametersExpired",
                    "parametersUnavailable",
                    "targetUnavailable"
                  ]
                },
                "action_kinds": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "packetCapture",
                      "syscallTrace"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          }
        ]
      },
      "d2": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "captureHistoryPage"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/d3"
            },
            "minItems": 0
          },
          "ordering": {
            "const": "acceptedAtDescCaptureIDDesc"
          }
        },
        "required": [
          "kind",
          "history",
          "ordering"
        ]
      }
    }
  }
}
