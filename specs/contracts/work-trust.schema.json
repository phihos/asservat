{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/work-trust.schema.json",
  "title": "Protected cluster work-signing trust v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "work-trust/v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "clusterID": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "issuerEpoch": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "publicKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "notBefore": {
            "type": "string",
            "format": "date-time"
          },
          "notAfter": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "publicKey",
          "notBefore",
          "notAfter"
        ]
      }
    }
  },
  "required": [
    "version",
    "revision",
    "clusterID",
    "issuerEpoch",
    "keys"
  ]
}
