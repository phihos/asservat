{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/processing-discovery.schema.json",
  "$defs": {
    "CaseCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "artifact_id"
      ]
    },
    "WorkloadCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "anchor_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "artifact_id",
        "anchor_at"
      ]
    },
    "CaseSearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "purpose_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 12
        },
        "after": {
          "$ref": "https://asservat.io/spec/v1/processing-discovery.schema.json#/$defs/CaseCursor"
        }
      },
      "required": [
        "case_id"
      ]
    },
    "WorkloadSearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "workload_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "acquired_from": {
          "type": "string",
          "format": "date-time"
        },
        "acquired_until": {
          "type": "string",
          "format": "date-time"
        },
        "purpose_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 12
        },
        "after": {
          "$ref": "https://asservat.io/spec/v1/processing-discovery.schema.json#/$defs/WorkloadCursor"
        }
      },
      "required": [
        "cluster_id",
        "namespace_uid",
        "workload_uid",
        "acquired_from",
        "acquired_until"
      ]
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "capture_id": {
          "type": "string",
          "format": "uuid"
        },
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "workload_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "purpose_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "native_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data_class": {
          "enum": [
            "metadata",
            "raw",
            "extract"
          ]
        },
        "origin": {
          "enum": [
            "capture",
            "derived"
          ]
        },
        "anchor_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "delete_by": {
          "type": "string",
          "format": "date-time"
        },
        "custody_state": {
          "enum": [
            "stored_unpublished",
            "deleting"
          ]
        },
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "artifact_id",
        "capture_id",
        "case_id",
        "cluster_id",
        "namespace_uid",
        "workload_uid",
        "purpose_ref",
        "native_type",
        "data_class",
        "origin",
        "anchor_at",
        "expires_at",
        "delete_by",
        "custody_state",
        "parents"
      ]
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "https://asservat.io/spec/v1/processing-discovery.schema.json#/$defs/Candidate"
          }
        },
        "next": {
          "oneOf": [
            {
              "$ref": "https://asservat.io/spec/v1/processing-discovery.schema.json#/$defs/CaseCursor"
            },
            {
              "$ref": "https://asservat.io/spec/v1/processing-discovery.schema.json#/$defs/WorkloadCursor"
            }
          ]
        }
      },
      "required": [
        "candidates"
      ]
    }
  },
  "$ref": "https://asservat.io/spec/v1/processing-discovery.schema.json#/$defs/Page"
}
