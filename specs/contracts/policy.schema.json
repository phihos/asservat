{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/policy.schema.json",
  "title": "Asservat policy v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "asservat.io/v1alpha1"
    },
    "kind": {
      "const": "DebugPolicy"
    },
    "metadata": {
      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/metadata"
    },
    "spec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "https://asservat.io/spec/v1/target.schema.json"
            },
            "detectors": {
              "type": "array",
              "items": {
                "$ref": "https://asservat.io/spec/v1/trigger.schema.json#/$defs/detector"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "when": {
              "$ref": "https://asservat.io/spec/v1/trigger.schema.json#/$defs/expression"
            },
            "recipeRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Optional provenance pin; the hub resolves the recipe by name and records the digest (ADR-335 D4)."
                }
              },
              "required": [
                "name"
              ]
            },
            "budgets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cooldown": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$"
                },
                "burst": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "maxConcurrentActions": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [],
              "description": "Storm protection (maintainer decision, ADR-335 D8); administrator budget policies may only tighten it."
            },
            "retention": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$"
            },
            "suspend": {
              "type": "boolean"
            },
            "sharing": {
              "$ref": "https://asservat.io/spec/v1/sharing-request.schema.json#/$defs/policy"
            },
            "observation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxPods": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "maxPods"
              ],
              "description": "Optional narrowing of the administrator observation ceilings; every authorized matching pod is observed."
            },
            "evaluation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scope": {
                  "enum": [
                    "pod",
                    "workload"
                  ]
                },
                "fireOnActivation": {
                  "type": "boolean"
                },
                "rearmFor": {
                  "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
                }
              },
              "required": []
            },
            "recordingSaves": {
              "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/policyOptIn"
            },
            "automationRef": {
              "type": "object",
              "additionalProperties": false,
              "description": "AccessBinding in the policy's namespace whose automation envelope applies; needed only when several envelopes match.",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "target",
            "detectors",
            "when",
            "recipeRef"
          ]
        },
        {
          "$ref": "https://asservat.io/spec/v1/preset-input.schema.json#/$defs/policy"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "https://asservat.io/spec/v1/target.schema.json"
            },
            "detectors": {
              "type": "array",
              "items": {
                "$ref": "https://asservat.io/spec/v1/trigger.schema.json#/$defs/detector"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "when": {
              "$ref": "https://asservat.io/spec/v1/trigger.schema.json#/$defs/expression"
            },
            "budgets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cooldown": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$"
                },
                "burst": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "maxConcurrentActions": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [],
              "description": "Storm protection (maintainer decision, ADR-335 D8); administrator budget policies may only tighten it."
            },
            "retention": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$"
            },
            "suspend": {
              "type": "boolean"
            },
            "sharing": {
              "$ref": "https://asservat.io/spec/v1/sharing-request.schema.json#/$defs/policy"
            },
            "observation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxPods": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "maxPods"
              ],
              "description": "Optional narrowing of the administrator observation ceilings; every authorized matching pod is observed."
            },
            "evaluation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scope": {
                  "enum": [
                    "pod",
                    "workload"
                  ]
                },
                "fireOnActivation": {
                  "type": "boolean"
                },
                "rearmFor": {
                  "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
                }
              },
              "required": []
            },
            "profileComposition": {
              "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json"
            },
            "recordingSaves": {
              "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/policyOptIn"
            },
            "automationRef": {
              "type": "object",
              "additionalProperties": false,
              "description": "AccessBinding in the policy's namespace whose automation envelope applies; needed only when several envelopes match.",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "target",
            "detectors",
            "when",
            "profileComposition"
          ]
        }
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
