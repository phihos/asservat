{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/policy-authority.schema.json",
  "title": "Team policy authority v1; protected resolution, not client credentials",
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedActions": {
          "type": "array",
          "items": {
            "enum": [
              "kubernetesSnapshot",
              "logs",
              "processSnapshot",
              "fileRead",
              "packetCapture",
              "networkSnapshot",
              "runtimeDiagnostic",
              "kernelCore",
              "liveCore",
              "command",
              "httpDiagnostic",
              "artifactCollect",
              "profile",
              "syscallTrace"
            ],
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "maxLifetimeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxExecutions": {
          "type": "integer",
          "minimum": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxObservedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxObservedEvents": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "allowedActions"
      ],
      "description": "Automation envelope on an AccessBinding (ADR-335 D6). Only allowedActions is required; omitted ceilings are unbounded within the installation's capacity and rate limits. Intrusive actions still need an expiring policy grant. Ceilings are not capped: each is an administrator's own bound, and enum plus uniqueItems bound allowedActions."
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "team"
        },
        "installationID": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/uuid"
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uid": {
              "type": "string",
              "minLength": 1
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "digest": {
              "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
            }
          },
          "required": [
            "uid",
            "generation",
            "digest"
          ]
        },
        "ownerAssignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "Group"
                  },
                  "issuer": {
                    "type": "string",
                    "format": "uri"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "issuer",
                  "id"
                ]
              },
              "role": {
                "const": "workload-maintainer"
              },
              "basisKind": {
                "const": "AccessBinding"
              },
              "basisUID": {
                "type": "string",
                "minLength": 1
              },
              "basisDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "assignmentID": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "subject",
              "role",
              "basisKind",
              "basisUID",
              "basisDigest",
              "assignmentID"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issuedAt": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/timestamp"
        },
        "notAfter": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/timestamp",
          "description": "Absent for an envelope without a lifetime ceiling (ADR-335 D6)."
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxExecutions": {
              "type": "integer",
              "minimum": 1
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxObservedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maxObservedEvents": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "mode",
        "installationID",
        "delegation",
        "ownerAssignments",
        "issuedAt",
        "limits"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "team"
        },
        "executor": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/principal"
        },
        "continuesAfterCreatorLeaves": {
          "const": true
        },
        "notAfter": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/timestamp",
          "description": "Absent for an envelope without a lifetime ceiling (ADR-335 D6)."
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxExecutions": {
              "type": "integer",
              "minimum": 1
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxObservedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maxObservedEvents": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "state": {
          "enum": [
            "Ready",
            "DelegationRequired",
            "Revoked",
            "Expired",
            "OwnerAssignmentChanged",
            "ReapprovalRequired",
            "Unavailable"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "ownerTeams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "Group"
              },
              "issuer": {
                "type": "string",
                "format": "uri"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "issuer",
              "id"
            ]
          }
        }
      },
      "required": [
        "mode",
        "executor",
        "continuesAfterCreatorLeaves",
        "limits",
        "state",
        "reasonCodes",
        "ownerTeams"
      ]
    }
  }
}
