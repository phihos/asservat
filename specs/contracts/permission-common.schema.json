{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/permission-common.schema.json",
  "title": "Asservat permission primitives v1",
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "evidence-reader",
        "workload-maintainer",
        "evidence-owner",
        "action-approver"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "User",
            "Group",
            "Workload"
          ]
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "issuer",
        "id"
      ]
    },
    "namespaceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "description": "Kubernetes namespace name (DNS label)."
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "description": "Kubernetes UID (a UUID; 64 characters leaves room for its textual forms)."
        }
      },
      "required": [
        "name",
        "uid"
      ]
    },
    "workloadRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Deployment",
            "StatefulSet"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "description": "Kubernetes object name (DNS subdomain)."
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "description": "Kubernetes UID (a UUID; 64 characters leaves room for its textual forms)."
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "description": "Workload by kind and name; a recreated workload of the same name keeps its access. Optional uid pins one instance."
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "description": "Label values are at most 63 characters (Kubernetes label syntax). Not capped: the Kubernetes object size limit (about 1.5 MiB in etcd) bounds this list."
        }
      },
      "required": [
        "matchLabels"
      ]
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "administratorManaged",
            "admissionEnforced"
          ]
        },
        "reviewRef": {
          "type": "string",
          "minLength": 1
        },
        "guardRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode"
      ],
      "description": "administratorManaged: the source itself is the administrator's statement. admissionEnforced: the Helm-rendered label ValidatingAdmissionPolicy protects the keys. reviewRef and guardRef are optional notes."
    },
    "metadataMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "annotation",
            "label"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Kubernetes label or annotation key (at most 253 characters)."
        },
        "mode": {
          "type": "string",
          "enum": [
            "groupName",
            "valueMap"
          ]
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "description": "Defaults to the installation's issuer."
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "prefix": {
          "description": "groupName mode: prepended to the value (label values cannot contain /).",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "field",
        "key",
        "mode"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "valueMap"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "minProperties": 1
              }
            },
            "not": {
              "required": [
                "prefix"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "Pending",
            "Ready",
            "Disabled",
            "Stale",
            "UnsafeSource",
            "Rejected"
          ]
        },
        "observedGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "phase",
        "observedGeneration"
      ]
    },
    "accessProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaceUID": {
          "type": "string",
          "minLength": 1,
          "description": "Kubernetes namespace UID."
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "$ref": "https://asservat.io/spec/v1/permission-common.schema.json#/$defs/subject"
              },
              "role": {
                "$ref": "https://asservat.io/spec/v1/permission-common.schema.json#/$defs/role"
              },
              "basisKind": {
                "type": "string",
                "enum": [
                  "AccessBinding",
                  "ClusterAccessBinding",
                  "PermissionSource"
                ]
              },
              "basisUID": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes UID of the basis object."
              },
              "basisDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "assignmentID": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "subject",
              "role",
              "basisKind",
              "basisUID",
              "basisDigest",
              "assignmentID"
            ]
          }
        }
      },
      "required": [
        "namespaceUID",
        "assignments"
      ]
    },
    "clusterRole": {
      "description": "Roles a ClusterAccessBinding may grant; privacy-operator only in the hub cluster.",
      "type": "string",
      "enum": [
        "evidence-reader",
        "workload-maintainer",
        "evidence-owner",
        "action-approver",
        "privacy-operator"
      ]
    },
    "bindingSubject": {
      "description": "Authored subject (ADR-335 D4): a user by username, a group by the name the provider emits (for example /payments) or a workload identity. issuer defaults to the installation's issuer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "User",
            "Group",
            "Workload"
          ]
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ]
    }
  }
}
