{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/api-context-work-trust.schema.json",
  "title": "Protected verify-only API context work trust v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "api-context-work-trust/v1"
    },
    "rootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "installationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "clusterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "issuerEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "enabled": {
      "type": "boolean"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "publicKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "notBefore": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "format": "date-time"
          },
          "notAfter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "publicKey",
          "notBefore",
          "notAfter"
        ]
      }
    }
  },
  "required": [
    "format",
    "rootId",
    "installationId",
    "clusterId",
    "issuerEpoch",
    "revision",
    "enabled",
    "keys"
  ]
}
