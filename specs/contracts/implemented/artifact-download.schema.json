{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/artifact-download.schema.json",
  "title": "Native artifact download control; no file bytes or bearer URLs",
  "oneOf": [
    {
      "$ref": "https://asservat.io/spec/v1/artifact-download.schema.json#/$defs/prepare"
    },
    {
      "$ref": "https://asservat.io/spec/v1/artifact-download.schema.json#/$defs/status"
    }
  ],
  "$defs": {
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "grant_id": {
          "type": "string",
          "format": "uuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "artifact_id",
        "idempotency_key"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "download_id"
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "download_id",
        "idempotency_key"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "Preparing",
            "Ready",
            "Streaming",
            "Completed",
            "Interrupted",
            "Cancelled",
            "Expired",
            "Denied",
            "Failed"
          ]
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        "native_format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_path": {
          "type": "string",
          "pattern": "^/api/v1/downloads/[0-9a-f-]{36}/content$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Effective transfer deadline, no later than the original session deadline or current managed evidence access expiry. A past deadline is valid for terminal status and never renews preparation, transfer or resume authority."
        },
        "managed_read_until": {
          "type": "string",
          "format": "date-time"
        },
        "emitted_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "resume_available": {
          "type": "boolean"
        },
        "local_copy_managed": {
          "const": false
        },
        "handling_notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "coverage_notice": {
          "type": "string",
          "maxLength": 1024
        },
        "etag": {
          "type": "string",
          "pattern": "^\"[A-Za-z0-9_-]{1,120}\"$",
          "description": "Strong opaque native-representation version; use with If-Match when resuming."
        },
        "continue_preparation": {
          "const": true,
          "description": "Only an acknowledged Preparing response to the explicit preparation operation permits bounded automatic continuation with the original key and deadline. Passive status never supplies this instruction."
        }
      },
      "required": [
        "download_id",
        "artifact_id",
        "state",
        "expires_at",
        "managed_read_until",
        "emitted_bytes",
        "resume_available",
        "local_copy_managed",
        "handling_notice"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "Ready",
                  "Streaming",
                  "Interrupted"
                ]
              }
            }
          },
          "then": {
            "required": [
              "content_path"
            ]
          },
          "else": {
            "not": {
              "required": [
                "content_path"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "Ready",
                  "Streaming",
                  "Interrupted"
                ]
              }
            }
          },
          "then": {
            "required": [
              "filename",
              "native_format",
              "size_bytes",
              "sha256",
              "etag",
              "coverage_notice"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "Preparing",
                  "Completed",
                  "Cancelled",
                  "Expired",
                  "Denied",
                  "Failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resume_available": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "continue_preparation"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "Preparing"
              }
            }
          }
        }
      ],
      "dependentRequired": {
        "filename": [
          "native_format",
          "size_bytes",
          "sha256",
          "etag",
          "coverage_notice"
        ],
        "native_format": [
          "filename",
          "size_bytes",
          "sha256",
          "etag",
          "coverage_notice"
        ],
        "size_bytes": [
          "filename",
          "native_format",
          "sha256",
          "etag",
          "coverage_notice"
        ],
        "sha256": [
          "filename",
          "native_format",
          "size_bytes",
          "etag",
          "coverage_notice"
        ],
        "etag": [
          "filename",
          "native_format",
          "size_bytes",
          "sha256",
          "coverage_notice"
        ],
        "coverage_notice": [
          "filename",
          "native_format",
          "size_bytes",
          "sha256",
          "etag"
        ]
      },
      "description": "Current authorized transfer status. Completed records the server transfer outcome, not local file persistence. Terminal status may omit native file metadata and remains readable after the transfer deadline while current evidence metadata authority permits it. Any included native metadata is the complete verified group; status reads never prepare or decrypt a file."
    },
    "cancelReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "Cancelled",
            "AlreadyTerminal"
          ]
        },
        "audit_state": {
          "enum": [
            "pending",
            "recorded",
            "overdue"
          ]
        }
      },
      "required": [
        "download_id",
        "state",
        "audit_state"
      ],
      "description": "A minimal receipt for stopping the original caller/client download, even after evidence access is lost. AlreadyTerminal intentionally hides the finer prior state. No artifact or native metadata. Pending/overdue audit never reverses the enforced stop."
    }
  }
}
