{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/storage-pool.schema.json",
  "title": "Asservat EvidenceStoragePool v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "asservat.io/v1alpha1"
    },
    "kind": {
      "const": "EvidenceStoragePool"
    },
    "metadata": {
      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageProfileRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "objects": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          },
          "required": [
            "bytes",
            "objects"
          ]
        },
        "safetyHeadroom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "objects": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          },
          "required": [
            "bytes",
            "objects"
          ]
        },
        "systemReserve": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "objects": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          },
          "required": [
            "bytes",
            "objects"
          ]
        },
        "sharedBurst": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "objects": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          },
          "required": [
            "bytes",
            "objects"
          ]
        },
        "protectedAllocations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "budgetPolicyRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "workloadSlots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "protectedPerWorkload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1125899906842624
                  },
                  "objects": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  }
                },
                "required": [
                  "bytes",
                  "objects"
                ]
              }
            },
            "required": [
              "budgetPolicyRef",
              "workloadSlots",
              "protectedPerWorkload"
            ]
          }
        },
        "upload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytesPerSecond": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "burstBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            }
          },
          "required": [
            "bytesPerSecond",
            "burstBytes"
          ]
        },
        "maxUploadRequestsPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "capacityAssurance": {
          "enum": [
            "qualifiedReservedBackend",
            "bestEffort"
          ]
        }
      },
      "required": [
        "storageProfileRef",
        "capacity",
        "safetyHeadroom",
        "systemReserve",
        "sharedBurst",
        "protectedAllocations",
        "upload",
        "maxUploadRequestsPerSecond",
        "capacityAssurance"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
