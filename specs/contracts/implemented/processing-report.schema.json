{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/processing-report.schema.json",
  "$defs": {
    "PolicyRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "uid",
        "generation",
        "digest"
      ]
    },
    "ArtifactCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "cluster_id",
        "attempt_id"
      ]
    },
    "ShareCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "id",
        "created_at",
        "ordinal"
      ]
    },
    "OperationCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "id"
      ]
    },
    "IDCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id"
      ]
    },
    "ProcessorCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id"
      ]
    },
    "Query": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "const": "artifacts",
              "default": "artifacts"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "created_before": {
              "type": "string",
              "format": "date-time"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "after": {
              "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/ArtifactCursor"
            }
          },
          "required": [],
          "dependentRequired": {
            "created_before": [
              "policy_digest"
            ],
            "policy_digest": [
              "created_before"
            ],
            "after": [
              "created_before",
              "policy_digest"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "const": "shares"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "created_before": {
              "type": "string",
              "format": "date-time"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "after": {
              "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/ShareCursor"
            }
          },
          "required": [
            "section"
          ],
          "dependentRequired": {
            "created_before": [
              "policy_digest"
            ],
            "policy_digest": [
              "created_before"
            ],
            "after": [
              "created_before",
              "policy_digest"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "const": "downloads"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "created_before": {
              "type": "string",
              "format": "date-time"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "after": {
              "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/IDCursor"
            }
          },
          "required": [
            "section"
          ],
          "dependentRequired": {
            "created_before": [
              "policy_digest"
            ],
            "policy_digest": [
              "created_before"
            ],
            "after": [
              "created_before",
              "policy_digest"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "const": "operations"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "created_before": {
              "type": "string",
              "format": "date-time"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "after": {
              "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/OperationCursor"
            }
          },
          "required": [
            "section"
          ],
          "dependentRequired": {
            "created_before": [
              "policy_digest"
            ],
            "policy_digest": [
              "created_before"
            ],
            "after": [
              "created_before",
              "policy_digest"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "const": "rules"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "created_before": {
              "type": "string",
              "format": "date-time"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "after": {
              "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/IDCursor"
            }
          },
          "required": [
            "section"
          ],
          "dependentRequired": {
            "created_before": [
              "policy_digest"
            ],
            "policy_digest": [
              "created_before"
            ],
            "after": [
              "created_before",
              "policy_digest"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "const": "paths"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "created_before": {
              "type": "string",
              "format": "date-time"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "after": {
              "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/IDCursor"
            }
          },
          "required": [
            "section"
          ],
          "dependentRequired": {
            "created_before": [
              "policy_digest"
            ],
            "policy_digest": [
              "created_before"
            ],
            "after": [
              "created_before",
              "policy_digest"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "const": "processors"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "created_before": {
              "type": "string",
              "format": "date-time"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "after": {
              "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/ProcessorCursor"
            }
          },
          "required": [
            "section"
          ],
          "dependentRequired": {
            "created_before": [
              "policy_digest"
            ],
            "policy_digest": [
              "created_before"
            ],
            "after": [
              "created_before",
              "policy_digest"
            ]
          }
        }
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "capture_id": {
          "type": "string",
          "format": "uuid"
        },
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "workload_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "store_id": {
          "type": "string",
          "format": "uuid"
        },
        "purpose_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "native_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data_class": {
          "enum": [
            "metadata",
            "extract",
            "raw"
          ]
        },
        "privacy_class": {
          "const": "potentialPersonalData"
        },
        "origin": {
          "enum": [
            "capture",
            "derived"
          ]
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "anchor_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_delete_by": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "delete_by": {
          "type": "string",
          "format": "date-time"
        },
        "custody_state": {
          "enum": [
            "stored_unpublished",
            "deleting",
            "deleted"
          ]
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time"
        },
        "deletion_state": {
          "enum": [
            "retained",
            "pending",
            "overdue",
            "deleted"
          ]
        }
      },
      "required": [
        "artifact_id",
        "capture_id",
        "case_id",
        "cluster_id",
        "attempt_id",
        "namespace_uid",
        "workload_uid",
        "store_id",
        "purpose_ref",
        "native_type",
        "data_class",
        "privacy_class",
        "origin",
        "parents",
        "anchor_at",
        "original_expires_at",
        "original_delete_by",
        "expires_at",
        "delete_by",
        "custody_state",
        "deletion_state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "capture"
              }
            }
          },
          "then": {
            "properties": {
              "parents": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "parents": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "custody_state": {
                "const": "deleted"
              }
            }
          },
          "then": {
            "required": [
              "deleted_at"
            ]
          },
          "else": {
            "not": {
              "required": [
                "deleted_at"
              ]
            }
          }
        }
      ]
    },
    "Share": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "share_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "recipient_kind": {
          "enum": [
            "User",
            "Group"
          ]
        },
        "recipient_issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "recorded",
            "expired",
            "revoked"
          ]
        }
      },
      "required": [
        "share_id",
        "artifact_id",
        "recipient_kind",
        "recipient_issuer",
        "recipient_id",
        "ordinal",
        "created_at",
        "expires_at",
        "state"
      ]
    },
    "Download": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principal_kind": {
          "enum": [
            "human",
            "workload"
          ]
        },
        "state": {
          "enum": [
            "Preparing",
            "Ready",
            "Streaming",
            "Interrupted",
            "Completed",
            "Cancelled",
            "Expired",
            "Denied",
            "Failed"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "emitted_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1152921504606846976
        },
        "client_receipt": {
          "const": "unknown"
        }
      },
      "required": [
        "download_id",
        "artifact_id",
        "issuer",
        "subject",
        "client_id",
        "principal_kind",
        "state",
        "created_at",
        "deadline",
        "emitted_bytes",
        "client_receipt"
      ]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "not": {
            "const": "get_processing_report"
          }
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principal_kind": {
          "enum": [
            "human",
            "workload"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "intent_acknowledged": {
          "type": "boolean"
        },
        "outcome_acknowledged": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "unknown",
            "success",
            "denied",
            "invalid",
            "unavailable",
            "interrupted"
          ]
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1152921504606846976
        },
        "client_receipt": {
          "const": "unknown"
        },
        "lane": {
          "enum": [
            "normal",
            "resolution",
            "processing"
          ]
        }
      },
      "required": [
        "operation_id",
        "ordinal",
        "name",
        "issuer",
        "subject",
        "client_id",
        "principal_kind",
        "created_at",
        "intent_acknowledged",
        "outcome_acknowledged",
        "status",
        "client_receipt",
        "lane"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "ordinal": {
                "const": 0
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "artifact_id"
              ]
            }
          },
          "else": {
            "required": [
              "artifact_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome_acknowledged": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "output_bytes"
            ],
            "properties": {
              "intent_acknowledged": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "cluster_id",
        "artifact_id",
        "attempt_id"
      ]
    },
    "Scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "location": {
              "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/Location"
            }
          },
          "required": [
            "kind",
            "location"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "workloadInterval"
            },
            "cluster_id": {
              "type": "string",
              "format": "uuid"
            },
            "namespace_uid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "workload_uid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "acquired_from": {
              "type": "string",
              "format": "date-time"
            },
            "acquired_until": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "cluster_id",
            "namespace_uid",
            "workload_uid",
            "acquired_from",
            "acquired_until"
          ]
        }
      ]
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "state": {
          "enum": [
            "reserved",
            "restricted",
            "released"
          ]
        },
        "scope": {
          "$ref": "https://asservat.io/spec/v1/processing-report.schema.json#/$defs/Scope"
        },
        "administration_until": {
          "type": "string",
          "format": "date-time"
        },
        "retire_by": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "revision",
        "state",
        "scope",
        "administration_until",
        "retire_by"
      ]
    },
    "Path": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "target_cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "store_id": {
          "type": "string",
          "format": "uuid"
        },
        "storage_region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "acquisition_cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "acquisition_region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "connector_cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "connector_region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "hub_cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "hub_region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        }
      },
      "required": [
        "id",
        "target_cluster_id",
        "store_id",
        "storage_region",
        "acquisition_cluster_id",
        "acquisition_region",
        "connector_cluster_id",
        "connector_region",
        "hub_cluster_id",
        "hub_region"
      ]
    },
    "Processor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
