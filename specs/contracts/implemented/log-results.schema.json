{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/log-results.schema.json",
  "title": "Saved raw logs page",
  "type": "object",
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origin_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "container_kind": {
              "enum": [
                "regular",
                "init",
                "ephemeral"
              ]
            },
            "container_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "source": {
              "enum": [
                "current",
                "previous"
              ]
            },
            "stream": {
              "const": "combined"
            },
            "runtime_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "restart_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "origin_id",
            "container_kind",
            "container_name",
            "source",
            "stream",
            "runtime_id",
            "restart_count"
          ]
        },
        "fragment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "line_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "continuation": {
          "type": "boolean"
        },
        "end_line": {
          "type": "boolean"
        },
        "source_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "bytes_base64": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 4,
          "maxLength": 1368,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "origin",
        "fragment",
        "line",
        "offset",
        "line_offset",
        "continuation",
        "end_line",
        "source_time",
        "text",
        "bytes_base64"
      ],
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "bytes_base64": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "text": {
              "type": "null"
            },
            "bytes_base64": {
              "type": "string"
            }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "logs"
        },
        "pod_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "https://asservat.io/spec/v1/log-results.schema.json#/$defs/entry"
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origins": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "complete_origins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "partial_origins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "unavailable_origins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "unknown_timestamp_origins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "gapped_origins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "source_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108864
            },
            "total_fragments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108864
            }
          },
          "required": [
            "origins",
            "complete_origins",
            "partial_origins",
            "unavailable_origins",
            "unknown_timestamp_origins",
            "gapped_origins",
            "source_bytes",
            "total_fragments"
          ]
        },
        "query_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "query_expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "pod_uid",
        "window_start",
        "window_end",
        "entries",
        "coverage",
        "query_observed_at",
        "query_expires_at"
      ]
    }
  },
  "$ref": "https://asservat.io/spec/v1/log-results.schema.json#/$defs/page"
}
