{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/capture-profile.schema.json",
  "title": "Immutable capture profile definition with mutable availability",
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "recipe": {
          "$ref": "https://asservat.io/spec/v1/recipe.schema.json#/properties/spec"
        },
        "editableFields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actionID": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "enum": [
                  "packetPeers",
                  "packetFilter",
                  "packetBefore",
                  "packetAfter",
                  "packetRing",
                  "processSelector",
                  "processBatch",
                  "profileDuration",
                  "syscallFilter",
                  "syscallMode",
                  "syscallBefore",
                  "syscallAfter",
                  "syscallRing",
                  "syscallArguments",
                  "syscallRate",
                  "filePath",
                  "commandArgv",
                  "actionMaxBytes",
                  "actionTimeout",
                  "actionExecutionMode",
                  "logBefore",
                  "logAfter",
                  "logStream"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actionID",
              "field",
              "label"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "displayName",
        "description",
        "recipe",
        "editableFields"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "asservat.io/v1alpha1"
    },
    "kind": {
      "const": "CaptureProfile"
    },
    "metadata": {
      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "definition": {
          "$ref": "https://asservat.io/spec/v1/capture-profile.schema.json#/$defs/definition"
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "deprecated": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "deprecated"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "definition",
        "availability"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
