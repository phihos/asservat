{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/collection-scope.schema.json",
  "title": "Resolved collection approval scope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "collection-scope/v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterID": {
          "type": "string",
          "format": "uuid"
        },
        "namespaceUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "resourceUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "clusterID",
        "namespaceUID",
        "resourceUID"
      ]
    },
    "executor": {
      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/principal"
    },
    "collection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "DebugPolicy"
            },
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "https://asservat.io/spec/v1/target.schema.json"
                },
                "detectors": {
                  "type": "array",
                  "items": {
                    "$ref": "https://asservat.io/spec/v1/trigger.schema.json#/$defs/detector"
                  },
                  "maxItems": 16,
                  "minItems": 1,
                  "uniqueItems": true
                },
                "when": {
                  "$ref": "https://asservat.io/spec/v1/trigger.schema.json#/$defs/expression"
                },
                "recipeRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "name",
                    "digest"
                  ]
                },
                "budgets": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cooldown": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$",
                      "maxLength": 16
                    },
                    "burst": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "maxOccurrencesPerHour": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "maxConcurrentActions": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    }
                  },
                  "required": [
                    "cooldown",
                    "burst",
                    "maxOccurrencesPerHour",
                    "maxConcurrentActions"
                  ]
                },
                "retention": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$",
                  "maxLength": 16
                },
                "observation": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "allAuthorized"
                    },
                    "maxPods": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "evaluation": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "enum": [
                        "pod",
                        "workload"
                      ]
                    },
                    "fireOnActivation": {
                      "type": "boolean"
                    },
                    "rearmFor": {
                      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
                    }
                  },
                  "required": [
                    "scope",
                    "fireOnActivation",
                    "rearmFor"
                  ]
                },
                "recordingSaves": {
                  "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/policyOptIn"
                }
              },
              "required": [
                "target",
                "detectors",
                "when",
                "recipeRef",
                "budgets",
                "retention",
                "observation"
              ]
            }
          },
          "required": [
            "kind",
            "spec"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "DebugCapture"
            },
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "https://asservat.io/spec/v1/target.schema.json"
                },
                "recipeRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "name",
                    "digest"
                  ]
                },
                "caseID": {
                  "type": "string",
                  "format": "uuid"
                },
                "deadline": {
                  "type": "string",
                  "format": "date-time"
                },
                "retention": {
                  "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
                }
              },
              "required": [
                "target",
                "recipeRef",
                "deadline"
              ]
            }
          },
          "required": [
            "kind",
            "spec"
          ]
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "recipe",
              "collectionCeiling",
              "retention",
              "endpointTemplate",
              "runtimePack",
              "preset",
              "projection",
              "approvalPolicy",
              "captureProfile",
              "collector"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "$ref": "https://asservat.io/spec/v1/collection-scope.schema.json#/properties/source",
            "description": "Source object of an organization or namespace captureProfile dependency. A release-embedded builtin profile (ADR-243) has none; its profileComposition provenance names the builtin catalog."
          }
        },
        "required": [
          "role",
          "digest"
        ]
      },
      "minItems": 1,
      "maxItems": 64
    },
    "profileComposition": {
      "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json#/$defs/provenance"
    },
    "podBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "podUID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "nodeUID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "nodeBootID": {
            "type": "string",
            "format": "uuid"
          },
          "executionClass": {
            "const": "kubernetesAPI",
            "description": "Explicit regional Kubernetes API acquisition; omission is the historical node execution profile."
          }
        },
        "required": [
          "podUID"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "executionClass"
              ],
              "properties": {
                "executionClass": {
                  "const": "kubernetesAPI"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "nodeUID"
                    ]
                  },
                  {
                    "required": [
                      "nodeBootID"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "nodeUID",
                "nodeBootID"
              ]
            }
          }
        ]
      }
    },
    "effectiveRetention": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "purposeRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "privacyClass": {
            "enum": [
              "unknown",
              "potentialPersonalData",
              "personalData",
              "specialCategoryPossible",
              "verifiedNonPersonal"
            ]
          },
          "evidenceType": {
            "enum": [
              "coreDump",
              "heapDump",
              "packetCapture",
              "syscallTrace",
              "logs",
              "files",
              "profile",
              "commandOutput",
              "context",
              "other"
            ]
          },
          "requestedAgeSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 315360000
          },
          "maximumAgeSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 315360000
          },
          "deletionBudgetSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "policyRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "generation": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "uid",
                "generation",
                "digest"
              ]
            }
          }
        },
        "required": [
          "actionID",
          "purposeRef",
          "privacyClass",
          "evidenceType",
          "requestedAgeSeconds",
          "maximumAgeSeconds",
          "deletionBudgetSeconds",
          "policyRefs"
        ]
      },
      "description": "Resolved per-action retention and source identities; required by newly implemented compilers. Historical design fixtures without this field are not accepted execution inputs."
    },
    "policyAuthority": {
      "$ref": "https://asservat.io/spec/v1/policy-authority.schema.json#/$defs/accepted"
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "executor",
    "collection",
    "dependencies"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "collection": {
            "properties": {
              "kind": {
                "const": "DebugCapture"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "podBindings"
        ]
      },
      "else": {
        "not": {
          "required": [
            "podBindings"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "collection": {
            "properties": {
              "kind": {
                "const": "DebugPolicy"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "policyAuthority"
        ],
        "properties": {
          "executor": {
            "properties": {
              "identityType": {
                "const": "workload"
              },
              "clientID": {
                "const": "policy-executor"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "policyAuthority"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "podBindings"
        ],
        "properties": {
          "podBindings": {
            "contains": {
              "required": [
                "executionClass"
              ],
              "properties": {
                "executionClass": {
                  "const": "kubernetesAPI"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "effectiveRetention"
        ],
        "properties": {
          "podBindings": {
            "maxItems": 1
          },
          "collection": {
            "properties": {
              "kind": {
                "const": "DebugCapture"
              },
              "spec": {
                "properties": {
                  "recipeRef": {
                    "properties": {
                      "name": {
                        "const": "builtin-pod-status-v1"
                      }
                    }
                  },
                  "target": {
                    "properties": {
                      "maxPods": {
                        "const": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "effectiveRetention": {
            "maxItems": 1,
            "items": {
              "properties": {
                "actionID": {
                  "const": "pod-status"
                },
                "privacyClass": {
                  "const": "potentialPersonalData"
                },
                "evidenceType": {
                  "const": "context"
                }
              }
            }
          }
        },
        "not": {
          "required": [
            "profileComposition"
          ]
        }
      }
    }
  ]
}
