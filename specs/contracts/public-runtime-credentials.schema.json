{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/public-runtime-credentials.schema.json",
  "title": "Immutable public runtime role provenance",
  "description": "Protected hub or publisher projection paired with its fixed runtime credentials. Original claims are historical role identity only; no source, recovery or operation authority. Startup requires its exact ordered compartment and authenticates every SQL role, ACL and provenance before any listener bind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "input",
    "rootUID",
    "setupID",
    "roles"
  ],
  "properties": {
    "format": {
      "const": "asservat-public-runtime-credentials/v1"
    },
    "input": {
      "$ref": "https://asservat.io/spec/v1/public-runtime-roles.schema.json"
    },
    "rootUID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "setupID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "roles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "claim",
          "receipt"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "hub-runtime",
              "capture-intent-read",
              "worker-config-read",
              "capacity-profile-read",
              "capture-admit",
              "capture-journal",
              "capture-ack",
              "publication-gate",
              "context-verify",
              "context-verification-audit",
              "context-publish",
              "publisher-identity-read",
              "publisher-retention-read"
            ]
          },
          "claim": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/claim"
          },
          "receipt": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/receipt"
          }
        }
      },
      "oneOf": [
        {
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "properties": {
              "purpose": {
                "enum": [
                  "hub-runtime",
                  "capture-intent-read",
                  "worker-config-read",
                  "capacity-profile-read",
                  "capture-admit",
                  "capture-journal",
                  "capture-ack"
                ]
              }
            }
          }
        },
        {
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "properties": {
              "purpose": {
                "enum": [
                  "publication-gate",
                  "context-verify",
                  "context-verification-audit",
                  "context-publish",
                  "publisher-identity-read",
                  "publisher-retention-read"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
