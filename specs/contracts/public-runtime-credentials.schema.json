{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/public-runtime-credentials.schema.json",
  "title": "Immutable public runtime role provenance",
  "description": "Protected hub or publisher projection paired with its fixed runtime credentials. Original claims are historical role identity only; no source, recovery or operation authority. Startup requires its exact ordered compartment and authenticates every SQL role, ACL and provenance before any listener bind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "input",
    "rootUID",
    "setupID",
    "roles"
  ],
  "properties": {
    "format": {
      "const": "asservat-public-runtime-credentials/v1"
    },
    "input": {
      "$ref": "https://asservat.io/spec/v1/public-runtime-roles.schema.json"
    },
    "rootUID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "setupID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "roles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 44,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "claim",
          "receipt"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "identity-read",
              "browser-settings",
              "browser-session",
              "browser-cleanup",
              "refresh-admit",
              "refresh-owner",
              "refresh-read",
              "hub-metadata-read",
              "capture-intent-read",
              "download-source",
              "download-plan",
              "worker-config-read",
              "audit-normal-journal",
              "audit-normal-ack",
              "audit-resolution-journal",
              "audit-resolution-ack",
              "capacity-profile-read",
              "capture-admit",
              "capture-journal",
              "capture-ack",
              "capture-preview",
              "capture-resolution",
              "api-execution",
              "download-session",
              "download-audit",
              "download-worker",
              "download-worker-audit",
              "download-worker-identity",
              "worker-enrollment",
              "worker-enrollment-audit",
              "worker-enrollment-activate",
              "worker-owner",
              "native-owner",
              "download-key-bind",
              "native-key-bind",
              "download-stop",
              "download-stop-writer",
              "download-stop-ack",
              "fleet-bootstrap-reserve",
              "fleet-bootstrap-record",
              "fleet-bootstrap-audit",
              "fleet-bootstrap-activate",
              "regional-capacity",
              "processing-decision",
              "publication-gate",
              "context-verify",
              "context-verification-audit",
              "context-publish",
              "publisher-identity-read",
              "publisher-retention-read"
            ]
          },
          "claim": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/claim"
          },
          "receipt": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/receipt"
          }
        }
      },
      "oneOf": [
        {
          "minItems": 44,
          "maxItems": 44,
          "items": {
            "properties": {
              "purpose": {
                "enum": [
                  "identity-read",
                  "browser-settings",
                  "browser-session",
                  "browser-cleanup",
                  "refresh-admit",
                  "refresh-owner",
                  "refresh-read",
                  "hub-metadata-read",
                  "capture-intent-read",
                  "download-source",
                  "download-plan",
                  "worker-config-read",
                  "audit-normal-journal",
                  "audit-normal-ack",
                  "audit-resolution-journal",
                  "audit-resolution-ack",
                  "capacity-profile-read",
                  "capture-admit",
                  "capture-journal",
                  "capture-ack",
                  "capture-preview",
                  "capture-resolution",
                  "api-execution",
                  "download-session",
                  "download-audit",
                  "download-worker",
                  "download-worker-audit",
                  "download-worker-identity",
                  "worker-enrollment",
                  "worker-enrollment-audit",
                  "worker-enrollment-activate",
                  "worker-owner",
                  "native-owner",
                  "download-key-bind",
                  "native-key-bind",
                  "download-stop",
                  "download-stop-writer",
                  "download-stop-ack",
                  "fleet-bootstrap-reserve",
                  "fleet-bootstrap-record",
                  "fleet-bootstrap-audit",
                  "fleet-bootstrap-activate",
                  "regional-capacity",
                  "processing-decision"
                ]
              }
            }
          }
        },
        {
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "properties": {
              "purpose": {
                "enum": [
                  "publication-gate",
                  "context-verify",
                  "context-verification-audit",
                  "context-publish",
                  "publisher-identity-read",
                  "publisher-retention-read"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
