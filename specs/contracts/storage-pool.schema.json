{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/storage-pool.schema.json",
  "title": "Asservat EvidenceStoragePool v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "asservat.io/v1alpha1"
    },
    "kind": {
      "const": "EvidenceStoragePool"
    },
    "metadata": {
      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageProfileRef": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Usable bytes after the backend full threshold and replication overhead."
            }
          },
          "required": [
            "bytes"
          ]
        },
        "capacityAssurance": {
          "enum": [
            "qualifiedReservedBackend",
            "bestEffort"
          ]
        }
      },
      "required": [
        "capacity"
      ],
      "description": "Usable evidence capacity of one storage profile (REQ-CAP-004). System reserve, burst and per-workload allocations are derived, not configured."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
