{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/artifact-download.schema.json",
  "title": "Native artifact download control; no file bytes or bearer URLs",
  "oneOf": [
    {
      "$ref": "https://asservat.io/spec/v1/artifact-download.schema.json#/$defs/prepare"
    },
    {
      "$ref": "https://asservat.io/spec/v1/artifact-download.schema.json#/$defs/status"
    }
  ],
  "$defs": {
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "enum": [
            "bundle",
            "file"
          ],
          "default": "bundle",
          "description": "Core artifacts only: bundle is the debugger-ready tar (core, executable and libraries under sysroot/, debug files, gdb.cmd, dlv.sh for Go, README.txt, SHA256SUMS); file is the bare core."
        }
      },
      "required": [
        "artifact_id",
        "idempotency_key"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "download_id"
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "download_id",
        "idempotency_key"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "Ready",
            "Completed",
            "Failed",
            "Cancelled"
          ],
          "description": "An interrupted connection leaves the session Ready; resume with HTTP Range until access_until. Completed, Failed and Cancelled are terminal."
        },
        "filename": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
          "description": "<workload>-<pod>-<time>.<ext> from recorded provenance (core bundle: .core.tar)."
        },
        "native_format": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Verified size from the catalog; present in every status while the caller may read the artifact's metadata."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Verified full-file SHA-256 from the catalog; present in every status."
        },
        "content_path": {
          "type": "string",
          "pattern": "^/api/v1/downloads/[0-9a-f-]{36}/content$"
        },
        "emitted_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "local_copy_managed": {
          "const": false
        },
        "handling_notice": {
          "type": "string",
          "minLength": 1
        },
        "coverage_notice": {
          "type": "string"
        },
        "etag": {
          "type": "string",
          "pattern": "^\"[A-Za-z0-9_-]{1,120}\"$",
          "description": "Strong opaque native-representation version; use with If-Match when resuming."
        },
        "failure_reason": {
          "enum": [
            "Expired",
            "Denied",
            "Integrity",
            "Deleted",
            "Unavailable"
          ]
        },
        "representation": {
          "enum": [
            "bundle",
            "file"
          ]
        },
        "browser_url": {
          "type": "string",
          "pattern": "^/downloads/[0-9a-f-]{36}$",
          "description": "Console page that downloads this session in the signed-in browser of the same human without another consent or approval."
        },
        "access_until": {
          "type": "string",
          "format": "date-time",
          "description": "AccessUntil: the artifact's access end (retention, share or grant end), never extended by status reads. Resumes are allowed until then; the caller's token lifetime does not shorten a started response (ADR-312)."
        }
      },
      "required": [
        "download_id",
        "artifact_id",
        "state",
        "size_bytes",
        "sha256",
        "access_until",
        "emitted_bytes",
        "local_copy_managed",
        "handling_notice"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "Ready"
              }
            }
          },
          "then": {
            "required": [
              "content_path",
              "browser_url",
              "filename",
              "native_format",
              "etag",
              "coverage_notice"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "content_path"
                  ]
                },
                {
                  "required": [
                    "browser_url"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "Failed"
              }
            }
          },
          "then": {
            "required": [
              "failure_reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "failure_reason"
              ]
            }
          }
        }
      ],
      "dependentRequired": {
        "filename": [
          "native_format",
          "etag",
          "coverage_notice"
        ],
        "native_format": [
          "filename",
          "etag",
          "coverage_notice"
        ],
        "etag": [
          "filename",
          "native_format",
          "coverage_notice"
        ],
        "coverage_notice": [
          "filename",
          "native_format",
          "etag"
        ]
      },
      "description": "Current authorized transfer status. Prepare returns Ready with the catalog's verified metadata in the same request. Ready carries content_path and browser_url; terminal states carry neither. Completed records the server transfer outcome, not local file persistence. Status reads never decrypt a file."
    },
    "cancelReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "Cancelled",
            "AlreadyTerminal"
          ]
        }
      },
      "required": [
        "download_id",
        "state"
      ],
      "description": "A minimal receipt for stopping the original caller/client download, even after evidence access is lost. AlreadyTerminal hides the finer prior state. No artifact or native metadata. The audit row is written in the same transaction (ADR-330 D6)."
    }
  }
}
