{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/browser-settings.schema.json",
  "title": "Protected browser session settings v1",
  "description": "Content of browser.json in the Helm-rendered settings ConfigMap. No credentials or public configuration API. The hub watches the ConfigMap; a change applies to new sessions and shortens existing ones to the new maxLifetimeSeconds. Current user permissions remain independently required.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "browser-settings/v1"
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "clientID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "maxLifetimeSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "maxLogins": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maxSessions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "maxLogoutEvents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    }
  },
  "required": [
    "schemaVersion",
    "issuer",
    "clientID",
    "origin",
    "maxLifetimeSeconds",
    "maxLogins",
    "maxSessions",
    "maxLogoutEvents"
  ]
}
