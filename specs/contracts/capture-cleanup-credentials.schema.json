{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/capture-cleanup-credentials.schema.json",
  "title": "Fixed worker capture cleanup credential provenance",
  "description": "Exactly three purpose-separated role receipts in compiled order. No password, SQL administrator, source writer or public compartment credential. Runtime independently verifies original actual roles, ACLs, incarnation and current private root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "input",
    "rootUID",
    "setupID",
    "captureSetup",
    "roles"
  ],
  "properties": {
    "format": {
      "const": "asservat-capture-cleanup-credentials/v1"
    },
    "input": {
      "$ref": "https://asservat.io/spec/v1/public-runtime-roles.schema.json"
    },
    "rootUID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "setupID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "captureSetup": {
      "$ref": "https://asservat.io/spec/v1/capacity-root-setup-claim.schema.json#/$defs/receipt"
    },
    "roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "claim",
          "receipt"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "capture-cleanup",
              "capture-verifier",
              "capture-finalizer"
            ]
          },
          "claim": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/claim"
          },
          "receipt": {
            "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/roles/items/properties/receipt"
          }
        }
      }
    }
  }
}
