          "properties": {
            "actionID": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "const": "logAfter"
            },
            "value": {
              "type": "string",
              "pattern": "^(0s|[1-9][0-9]*(ms|s|m|h|d))$"
            }
          },
          "required": [
