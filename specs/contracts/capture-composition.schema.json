          "properties": {
            "actionID": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "const": "filePath"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "actionID",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actionID": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "const": "commandArgv"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 131072,
                "description": "Linux MAX_ARG_STRLEN (131072 bytes) per argument."
              },
              "minItems": 1
            }
          },
          "required": [
            "actionID",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actionID": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "const": "actionMaxBytes"
            },
            "value": {
