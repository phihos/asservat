    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$"
        },
        "profileRef": {
          "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json#/$defs/profileRef"
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json#/$defs/override"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "profileRef"
      ]
    },
    "actionAlias": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "componentID": {
          "type": "string",
          "minLength": 1
        },
        "localActionID": {
          "type": "string",
          "minLength": 1
        },
        "actionID": {
          "type": "string",
          "pattern": "^a[a-f0-9]{24}$"
        },
        "deduplicated": {
          "type": "boolean"
        }
      },
      "required": [
        "componentID",
        "localActionID",
        "actionID",
        "deduplicated"
      ]
    },
    "resolvedProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "componentID": {
          "type": "string",
          "minLength": 1
        },
        "profileRef": {
          "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json#/$defs/profileRef"
        },
        "sourceUID": {
          "type": "string",
          "minLength": 1
        },
        "definitionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceClusterID": {
          "type": "string",
          "format": "uuid"
        },
        "sourceNamespaceUID": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "componentID",
        "profileRef",
        "definitionDigest"
      ],
      "description": "Pinned resolved profile. A builtin definition is embedded in the release binary (ADR-243) and is identified by its definition digest alone; organization and namespace definitions name their source cluster, namespace and object.",
      "allOf": [
        {
          "if": {
            "properties": {
              "profileRef": {
                "properties": {
                  "catalog": {
                    "const": "builtin"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sourceUID"
                  ]
                },
                {
                  "required": [
                    "sourceClusterID"
                  ]
                },
                {
                  "required": [
                    "sourceNamespaceUID"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "sourceUID",
              "sourceClusterID",
              "sourceNamespaceUID"
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authored": {
          "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json"
        },
        "resolvedProfiles": {
          "type": "array",
          "items": {
            "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json#/$defs/resolvedProfile"
          },
          "minItems": 1
        },
        "actionMap": {
          "type": "array",
          "items": {
            "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json#/$defs/actionAlias"
          },
          "minItems": 1
        }
      },
      "required": [
        "authored",
        "resolvedProfiles",
        "actionMap"
      ]
