{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/owner-credentials.schema.json",
  "title": "Private mounted owner provider credentials",
  "description": "Separate fixed SQL (16 KiB) and storage (32 KiB) credential files. Runtime enforces byte lengths and current projection per request/new SQL connection. Secret input; never log values. Not Helm values or permission configuration.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]+(?![\\s\\S])"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessKeyID",
        "secretAccessKey",
        "sessionToken"
      ],
      "properties": {
        "accessKeyID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
        },
        "secretAccessKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
        },
        "sessionToken": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
        }
      }
    }
  ]
}
