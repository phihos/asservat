{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/recorder-preview.schema.json",
  "title": "Reviewed recorder and profile plan",
  "description": "Canonical recorder and profile plan whose SHA-256 is the execution digest. Acceptance requires the target collector capability and all current authority. Packet filters and syscall argument program, definition and accounting pins are resolved independently of the authored recipe and included in the reviewed scope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "recorder-preview/v1"
    },
    "acceptance": {
      "enum": [
        "recorderUnavailable",
        "nodeRecorder"
      ],
      "description": "recorderUnavailable: the target has no supported mechanism for this plan. nodeRecorder: the target collector reports the required mechanism; request_capture still checks current authority and any required approval."
    },
    "source": {
      "$ref": "https://asservat.io/spec/v1/collection-scope.schema.json#/properties/source"
    },
    "executor": {
      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/principal"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "workloadRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apiVersion": {
              "enum": [
                "apps/v1",
                "v1"
              ]
            },
            "kind": {
              "enum": [
                "Deployment",
                "StatefulSet",
                "Pod"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "uid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "apiVersion",
            "kind",
            "name",
            "uid"
          ]
        },
        "podUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "namespace",
        "workloadRef",
        "podUID"
      ]
    },
    "recipeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^composition-[a-f0-9]{24}$"
        },
        "digest": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
        }
      },
      "required": [
        "name",
        "digest"
      ]
    },
    "recipe": {
      "$ref": "https://asservat.io/spec/v1/recipe.schema.json#/properties/spec"
    },
    "profileComposition": {
      "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json#/$defs/provenance"
    },
    "lifecycle": {
      "$ref": "https://asservat.io/spec/v1/action-lifecycle.schema.json#/$defs/plan"
    },
    "filters": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "linkType": {
            "const": "EN10MB"
          },
          "snaplen": {
            "const": 65535
          },
          "encoding": {
            "const": "pcap-cbpf/v1"
          },
          "program": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              ],
              "minItems": 4,
              "maxItems": 4
            },
            "description": "Classic BPF instructions (code, jt, jf, k) as emitted by libpcap pcap_compile."
          },
          "programDigest": {
            "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash",
            "description": "SHA-256 over the instructions as little-endian struct sock_filter bytes."
          }
        },
        "required": [
          "actionID",
          "expression",
          "linkType",
          "snaplen",
          "encoding",
          "program",
          "programDigest"
        ]
      }
    },
    "effectiveRetention": {
      "$ref": "https://asservat.io/spec/v1/collection-scope.schema.json#/properties/effectiveRetention"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "approval": {
      "description": "ADR-249: present only when the plan needs an individual approval (adHocCapture AccessGrant) before any observation. Part of the execution digest.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataClass": {
          "enum": [
            "metadata",
            "extract",
            "raw"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actionID": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "code": {
                "enum": [
                  "rawBytePredicate",
                  "rawPackets",
                  "httpHeaders",
                  "syscallArguments",
                  "liveProfile",
                  "recordingApprovalRequired"
                ]
              }
            },
            "required": [
              "actionID",
              "code"
            ]
          }
        },
        "observationLimits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSessionSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "maxObservedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            },
            "maxBytesPerSecond": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824
            },
            "maxConcurrentSessions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxObservedEvents": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          },
          "required": [
            "maxSessionSeconds",
            "maxObservedBytes",
            "maxBytesPerSecond",
            "maxConcurrentSessions"
          ]
        }
      },
      "required": [
        "dataClass",
        "reasons"
      ]
    },
    "profileEndpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "sourceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "sourceKind": {
            "enum": [
              "templateBinding",
              "administratorProfile"
            ]
          },
          "addressMode": {
            "enum": [
              "targetLoopback",
              "podIP"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "declaredPortName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15
          },
          "pathPolicy": {
            "const": "go-pprof/v1"
          },
          "tls": {
            "type": "boolean"
          },
          "credential": {
            "type": "boolean"
          },
          "definitionDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "endpointDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "actionID",
          "sourceRef",
          "sourceName",
          "sourceKind",
          "addressMode",
          "port",
          "pathPolicy",
          "tls",
          "credential",
          "definitionDigest",
          "endpointDigest",
          "resolvedAt"
        ]
      }
    },
    "argumentPrograms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "names": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "programDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "definitionDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "accountingRule": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxProbeBytes": {
            "enum": [
              256,
              512
            ]
          },
          "maxBytesPerEvent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "maxBytesPerSecond": {
            "const": 16777216
          },
          "captureBuffers": {
            "type": "boolean"
          }
        },
        "required": [
          "actionID",
          "names",
          "programDigest",
          "definitionDigest",
          "accountingRule",
          "maxProbeBytes",
          "maxBytesPerEvent",
          "maxBytesPerSecond",
          "captureBuffers"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "acceptance",
    "source",
    "executor",
    "target",
    "recipeRef",
    "recipe",
    "profileComposition",
    "lifecycle",
    "filters",
    "effectiveRetention",
    "deadline"
  ]
}
