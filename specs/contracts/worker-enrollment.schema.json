{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/worker-enrollment.schema.json",
  "title": "Private download worker enrollment v1",
  "description": "TLS 1.3 POST /internal/download-worker/v1/enroll with dedicated Pod-bound bearer token. No human credentials, authority or callback address on this wire. Runtime verifies DER, exact CSR key, identity, certificate periods and combined 32 KiB certificate bytes; shape validation alone grants no authority. Body ceilings: request 16 KiB, response 48 KiB.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "installationID",
        "sessionID",
        "workerID",
        "nonce",
        "csr"
      ],
      "properties": {
        "format": {
          "const": "asservat-worker-enrollment/v1"
        },
        "installationID": {
          "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
        },
        "sessionID": {
          "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
        },
        "workerID": {
          "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
        },
        "csr": {
          "type": "string",
          "minLength": 44,
          "maxLength": 10924,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "installationID",
        "sessionID",
        "workerID",
        "nonce",
        "certificate",
        "chain"
      ],
      "properties": {
        "format": {
          "const": "asservat-worker-enrollment/v1"
        },
        "installationID": {
          "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
        },
        "sessionID": {
          "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
        },
        "workerID": {
          "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
        },
        "certificate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 21848,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
        },
        "chain": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 21848,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
          }
        }
      }
    }
  ]
}
