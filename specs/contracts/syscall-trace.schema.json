{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/syscall-trace.schema.json",
  "title": "Bounded pod-wide syscall acquisition parameters",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "processes": {
      "const": "allPodProcesses"
    },
    "mode": {
      "enum": [
        "metadata",
        "arguments"
      ]
    },
    "before": {
      "anyOf": [
        {
          "const": "0s"
        },
        {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
        }
      ]
    },
    "after": {
      "anyOf": [
        {
          "const": "0s"
        },
        {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
        }
      ]
    },
    "syscalls": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "all"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "include"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_]{1,64}$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "names"
          ]
        }
      ]
    },
    "result": {
      "enum": [
        "all",
        "errors"
      ]
    },
    "ring": {
      "$ref": "https://asservat.io/spec/v1/packet-capture.schema.json#/properties/ring"
    },
    "maxEventsPerSecond": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Reviewed observation rate; the shipped default is derived from measured per-node collector event throughput. With the ring, it bounds every trace; there is no lifetime event total (ADR-335 D6)."
    },
    "maxTrackedThreads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Sizes the eBPF per-thread map (memory per tracked thread); derived from the collector map memory budget."
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytesPerEvent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "captureBuffers": {
          "type": "boolean"
        }
      },
      "required": [
        "maxBytesPerEvent",
        "captureBuffers"
      ]
    }
  },
  "required": [
    "processes",
    "mode",
    "before",
    "after",
    "syscalls",
    "result",
    "ring",
    "maxEventsPerSecond",
    "maxTrackedThreads"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "arguments"
          }
        }
      },
      "then": {
        "required": [
          "arguments"
        ]
      },
      "else": {
        "not": {
          "required": [
            "arguments"
          ]
        }
      }
    }
  ]
}
