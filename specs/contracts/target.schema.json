{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/target.schema.json",
  "title": "Asservat target v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "description": "Defaults to the object's own namespace; must equal it when given."
    },
    "workloadRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "apps/v1",
            "v1"
          ],
          "description": "Optional; derived from the kind."
        },
        "kind": {
          "type": "string",
          "enum": [
            "Deployment",
            "StatefulSet",
            "Pod"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Optional pin with adoption: pinUID; otherwise provenance only."
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Pod"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "apiVersion": {
                "const": "v1"
              }
            }
          },
          "else": {
            "properties": {
              "apiVersion": {
                "const": "apps/v1"
              }
            }
          }
        }
      ]
    },
    "podSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          }
        }
      },
      "required": [
        "matchLabels"
      ]
    },
    "maxPods": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Maximum pods collected per occurrence; never the monitoring coverage limit.",
      "default": 1
    },
    "selection": {
      "type": "string",
      "enum": [
        "oldestReady",
        "newest",
        "allWithinLimit",
        "lowestOrdinal",
        "triggeringPod"
      ],
      "description": "Defaults to triggeringPod for policies and oldestReady for manual captures."
    },
    "ordinals": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "adoption": {
      "type": "string",
      "enum": [
        "followName",
        "pinUID"
      ],
      "default": "followName"
    }
  },
  "required": [],
  "oneOf": [
    {
      "required": [
        "workloadRef"
      ],
      "not": {
        "required": [
          "podSelector"
        ]
      }
    },
    {
      "required": [
        "podSelector"
      ],
      "not": {
        "required": [
          "workloadRef"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "ordinals"
        ]
      },
      "then": {
        "required": [
          "workloadRef"
        ],
        "properties": {
          "workloadRef": {
            "properties": {
              "kind": {
                "const": "StatefulSet"
              }
            }
          }
        }
      }
    }
  ]
}
