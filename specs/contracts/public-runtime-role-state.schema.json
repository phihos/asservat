{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json",
  "title": "Private public runtime SQL role creation state",
  "description": "At most 48KiB under actual protected Secret UID/resourceVersion CAS. Exactly one ordered entry per compiled purpose. Original setup is thirty minutes; each first SQL claim retains at most five seconds. Unknown claims/outcomes permit exact role lookup only. Relational validation enforces unique passwords, claim IDs, OIDs and immutable role provenance. No credentials enter public status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "input",
    "operationID",
    "createdAt",
    "until",
    "roles",
    "mac"
  ],
  "properties": {
    "format": {
      "const": "asservat-public-runtime-role-state/v1"
    },
    "input": {
      "$ref": "https://asservat.io/spec/v1/public-runtime-roles.schema.json"
    },
    "operationID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "until": {
      "type": "string",
      "format": "date-time"
    },
    "roles": {
      "type": "array",
      "minItems": 79,
      "maxItems": 79,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "password"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "identity-read",
              "browser-settings",
              "browser-session",
              "browser-cleanup",
              "refresh-admit",
              "refresh-owner",
              "refresh-read",
              "hub-metadata-read",
              "capture-intent-read",
              "download-source",
              "download-plan",
              "worker-config-read",
              "audit-normal-journal",
              "audit-normal-ack",
              "audit-resolution-journal",
              "audit-resolution-ack",
              "capacity-profile-read",
              "capture-admit",
              "capture-journal",
              "capture-ack",
              "capture-preview",
              "capture-resolution",
              "api-execution",
              "download-session",
              "download-audit",
              "download-worker",
              "download-worker-audit",
              "download-worker-identity",
              "worker-enrollment",
              "worker-enrollment-audit",
              "worker-enrollment-activate",
              "worker-owner",
              "native-owner",
              "download-key-bind",
              "native-key-bind",
              "download-stop",
              "download-stop-writer",
              "download-stop-ack",
              "fleet-bootstrap-reserve",
              "fleet-bootstrap-record",
              "fleet-bootstrap-audit",
              "fleet-bootstrap-activate",
              "regional-capacity",
              "processing-decision",
              "capture-cleanup",
              "capture-verifier",
              "capture-finalizer",
              "connector-source",
              "connector-journal",
              "connector-ack",
              "connector-read",
              "cluster-credential",
              "connector-owner-read",
              "publication-gate",
              "context-verify",
              "context-verification-audit",
              "context-publish",
              "publisher-identity-read",
              "publisher-retention-read",
              "connector-cleanup",
              "connector-verifier",
              "connector-finalizer",
              "capacity",
              "capacity-capture",
              "permission-accept",
              "permission-audit",
              "retention-source",
              "retention-source-audit",
              "retention-catchup",
              "retention-lifecycle-audit",
              "worker-config-observe",
              "worker-config-audit",
              "context-cleanup",
              "context-cleanup-audit",
              "context-cleanup-finalize",
              "key-configuration",
              "key-wrap",
              "key-verify",
              "key-acquisition"
            ]
          },
          "password": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "claim": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operationID",
              "claimedAt",
              "until",
              "databaseOID",
              "postmasterAt"
            ],
            "properties": {
              "operationID": {
                "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
              },
              "claimedAt": {
                "type": "string",
                "format": "date-time"
              },
              "until": {
                "type": "string",
                "format": "date-time"
              },
              "databaseOID": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "postmasterAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleName",
              "roleOID",
              "layoutDigest"
            ],
            "properties": {
              "roleName": {
                "type": "string",
                "pattern": "^as_[0-9a-f]{32}_pub_[0-9]{2}$"
              },
              "roleOID": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "layoutDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "dependentRequired": {
          "receipt": [
            "claim"
          ]
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationID",
        "claimedAt",
        "until"
      ],
      "properties": {
        "operationID": {
          "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
        },
        "claimedAt": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        },
        "secretUID": {
          "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
        }
      }
    },
    "mac": {
      "$ref": "https://asservat.io/spec/v1/public-audit-keys.schema.json#/$defs/material"
    },
    "capacitySetup": {
      "$ref": "https://asservat.io/spec/v1/capacity-root-setup-claim.schema.json"
    },
    "federationProjection": {
      "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/projection"
    },
    "keyServiceProjection": {
      "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/projection"
    },
    "publisherProjection": {
      "$ref": "https://asservat.io/spec/v1/public-runtime-role-state.schema.json#/properties/projection"
    }
  }
}
