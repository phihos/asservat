{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/api-context-exchange.schema.json",
  "title": "Private live API context JSON frame bodies v1",
  "description": "The binary frame kind and bounded five-byte length prefix are separately checked. Signed work is the compact JWS of api-context-work, not a JSON frame body in this union.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "api-context-exchange/v1"
        },
        "channel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rootId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            },
            "exchangeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            },
            "challenge": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            },
            "hub": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "installationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "clusterId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "issuerEpoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "podUID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "processEpoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                }
              },
              "required": [
                "installationId",
                "clusterId",
                "issuerEpoch",
                "podUID",
                "processEpoch"
              ]
            },
            "connector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "installationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "clusterId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "issuerEpoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "peerId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "podUID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "processEpoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "leafDigest": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "installationId",
                "clusterId",
                "issuerEpoch",
                "peerId",
                "podUID",
                "processEpoch",
                "leafDigest"
              ]
            },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "namespaceUID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "accountUID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "podUID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "processEpoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                },
                "startupDigest": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "imageDigest": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "namespaceUID",
                "accountUID",
                "podUID",
                "processEpoch",
                "startupDigest",
                "imageDigest"
              ]
            }
          },
          "required": [
            "rootId",
            "exchangeId",
            "challenge",
            "hub",
            "connector",
            "executor"
          ]
        },
        "standbyUntil": {
          "type": "string",
          "format": "date-time",
          "description": "Original connector conversation expiry, capped by the local native/request end; availability only, never peer or work authority."
        }
      },
      "required": [
        "format",
        "channel",
        "standbyUntil"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "api-context-exchange/v1"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "challenge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        }
      },
      "required": [
        "format",
        "exchangeId",
        "captureId",
        "sequence",
        "challenge"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "api-context-exchange/v1"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "challenge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "clientId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "kind": {
              "const": "human"
            }
          },
          "required": [
            "issuer",
            "subject",
            "clientId",
            "kind"
          ]
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "uid",
            "generation",
            "digest"
          ]
        },
        "scopes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "verifiedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "format": "date-time"
        }
      },
      "required": [
        "format",
        "exchangeId",
        "captureId",
        "sequence",
        "challenge",
        "actor",
        "policy",
        "scopes",
        "groups",
        "verifiedAt",
        "validUntil"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "api-context-exchange/v1"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "state": {
          "enum": [
            "StoredPendingVerification",
            "AlreadyStarted",
            "PreparationUncertain",
            "Unavailable"
          ]
        }
      },
      "required": [
        "format",
        "exchangeId",
        "captureId",
        "state"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "api-context-exchange/v1"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        "state": {
          "const": "received"
        }
      },
      "required": [
        "format",
        "exchangeId",
        "captureId",
        "state"
      ]
    }
  ]
}
