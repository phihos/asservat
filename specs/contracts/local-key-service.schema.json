{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/local-key-service.schema.json",
  "title": "Private authenticated local key RPC v1",
  "description": "TLS 1.3 mutual authentication by service role; the AEAD binding names the artifact. This schema is not a grant. Closed operation-specific shapes; decoded limits and canonical base64 are runtime checks. No secrets in logs.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationID",
        "purpose",
        "keyID"
      ],
      "properties": {
        "installationID": {
          "$ref": "https://asservat.io/spec/v1/local-key-secret.schema.json#/properties/installationID"
        },
        "purpose": {
          "$ref": "https://asservat.io/spec/v1/local-key-secret.schema.json#/properties/purpose"
        },
        "keyID": {
          "$ref": "https://asservat.io/spec/v1/local-key-secret.schema.json#/properties/keyID"
        }
      }
    },
    "sealed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "ciphertext"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^asservat-local-keyset/v1/"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 4,
          "maxLength": 8192,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "scope",
        "authorityID",
        "operation"
      ],
      "properties": {
        "format": {
          "const": "asservat-local-key-rpc/v1"
        },
        "scope": {
          "$ref": "https://asservat.io/spec/v1/local-key-service.schema.json#/$defs/scope"
        },
        "authorityID": {
          "$ref": "https://asservat.io/spec/v1/local-key-secret.schema.json#/properties/installationID"
        },
        "operation": {
          "enum": [
            "wrap",
            "unwrap"
          ]
        },
        "binding": {
          "type": "string",
          "minLength": 4,
          "maxLength": 2732,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
        },
        "input": {
          "type": "string",
          "minLength": 4,
          "maxLength": 21848,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
        },
        "sealed": {
          "$ref": "https://asservat.io/spec/v1/local-key-service.schema.json#/$defs/sealed"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "wrap"
              }
            }
          },
          "then": {
            "required": [
              "binding",
              "input"
            ],
            "properties": {
              "sealed": false,
              "input": {
                "type": "string",
                "minLength": 4,
                "maxLength": 5464,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "unwrap"
              }
            }
          },
          "then": {
            "required": [
              "binding",
              "sealed"
            ],
            "properties": {
              "input": false
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "operation",
        "requestSHA256"
      ],
      "properties": {
        "format": {
          "const": "asservat-local-key-rpc/v1"
        },
        "operation": {
          "enum": [
            "wrap",
            "unwrap"
          ]
        },
        "requestSHA256": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
        },
        "sealed": {
          "$ref": "https://asservat.io/spec/v1/local-key-service.schema.json#/$defs/sealed"
        },
        "output": {
          "type": "string",
          "minLength": 4,
          "maxLength": 5464,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "wrap"
              }
            }
          },
          "then": {
            "required": [
              "sealed"
            ],
            "properties": {
              "output": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "unwrap"
              }
            }
          },
          "then": {
            "required": [
              "output"
            ],
            "properties": {
              "sealed": false
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "https://asservat.io/spec/v1/local-key-service.schema.json#/$defs/request"
    },
    {
      "$ref": "https://asservat.io/spec/v1/local-key-service.schema.json#/$defs/response"
    }
  ]
}
