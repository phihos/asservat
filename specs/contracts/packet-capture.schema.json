{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/packet-capture.schema.json",
  "title": "Bounded packet action parameters",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "networkHeaders"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "httpHeaders"
            },
            "protocol": {
              "const": "http1"
            },
            "projectionRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^v[1-9][0-9]*$"
                }
              },
              "required": [
                "name",
                "version"
              ]
            },
            "maxFlows": {
              "type": "integer",
              "minimum": 1,
              "description": "Optional; the tracked-flow bound is maxReassemblyBytes \u00f7 maxReassemblyBytesPerFlow, and a given value must not exceed that quotient."
            },
            "maxHeaderBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768,
              "default": 32768,
              "description": "Common HTTP server header limits (nginx large_client_header_buffers 4 \u00d7 8 KiB) bound one request header block."
            },
            "maxReassemblyBytesPerFlow": {
              "type": "integer",
              "minimum": 1,
              "default": 65536,
              "description": "Default 2 \u00d7 maxHeaderBytes, so one complete header block plus its segment overlap fits."
            },
            "maxReassemblyBytes": {
              "type": "integer",
              "minimum": 1,
              "default": 16777216,
              "description": "Per-target reassembly memory budget; the default 16 MiB is derived from the node collector memory limit together with the ring and frozen budgets."
            },
            "idleTimeout": {
              "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
            }
          },
          "required": [
            "kind",
            "protocol",
            "projectionRef",
            "maxHeaderBytes",
            "maxReassemblyBytesPerFlow",
            "maxReassemblyBytes",
            "idleTimeout"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rawPackets"
            },
            "snaplen": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "protocolSnaplen": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "protocol": {
                    "enum": [
                      "tcp",
                      "udp",
                      "icmp"
                    ]
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "required": [
                  "protocol",
                  "bytes"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "snaplen"
          ]
        }
      ]
    },
    "before": {
      "type": "string",
      "pattern": "^(0s|[1-9][0-9]*(ms|s|m|h|d))$",
      "maxLength": 16
    },
    "after": {
      "type": "string",
      "pattern": "^(0s|[1-9][0-9]*(ms|s|m|h|d))$",
      "maxLength": 16
    },
    "filter": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "No length cap on the text; the bound is the compiled classic BPF program, which must fit the kernel limit BPF_MAXINSNS (4096 instructions), checked at compile, and the enclosing Kubernetes object size."
    },
    "ring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAge": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "segmentBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxSegments": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991,
          "description": "Derived bound: ring maxBytes \u00f7 segmentBytes; at least 2 so the ring can rotate."
        },
        "medium": {
          "enum": [
            "memory",
            "encryptedDisk"
          ]
        },
        "storageProfileRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        }
      },
      "required": [
        "maxAge",
        "maxBytes",
        "segmentBytes",
        "maxSegments",
        "medium"
      ]
    },
    "peers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cidrs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "cidrs"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "podSelector": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "namespace": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63
                      },
                      "matchLabels": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 63
                        }
                      }
                    },
                    "required": [
                      "namespace",
                      "matchLabels"
                    ]
                  }
                },
                "required": [
                  "podSelector"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resourceRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "Pod",
                          "Deployment",
                          "StatefulSet",
                          "Service"
                        ]
                      },
                      "namespace": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                      },
                      "serviceMode": {
                        "enum": [
                          "backends",
                          "virtualIP",
                          "both"
                        ]
                      },
                      "readyOnly": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "kind",
                      "namespace",
                      "name"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "kind": {
                              "const": "Service"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "serviceMode",
                            "readyOnly"
                          ]
                        },
                        "else": {
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "serviceMode"
                                ]
                              },
                              {
                                "required": [
                                  "readyOnly"
                                ]
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "resourceRef"
                ]
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp",
            "icmp",
            "any"
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resolution": {
          "enum": [
            "frozen",
            "follow"
          ]
        },
        "maxEndpoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "entries",
        "protocol",
        "resolution",
        "maxEndpoints"
      ]
    },
    "maxFrozenBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "At most the ring maxBytes; derived from the node collector memory/scratch allocation (budget node maxFrozenBytes), not a fixed constant."
    },
    "maxConcurrentSnapshots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Bounded by the node frozen byte budget (node maxFrozenBytes \u00f7 ring maxBytes) and the trigger rate limits."
    }
  },
  "required": [
    "profile",
    "before",
    "after",
    "ring",
    "peers",
    "maxFrozenBytes",
    "maxConcurrentSnapshots"
  ]
}
