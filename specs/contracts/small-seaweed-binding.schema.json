{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/small-seaweed-binding.schema.json",
  "title": "Original bundled object store initialization intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "requestID",
    "initialization",
    "iamSecretUID",
    "storageUseUntil"
  ],
  "properties": {
    "format": {
      "const": "asservat-small-seaweed-binding/v1"
    },
    "requestID": {
      "type": "string",
      "format": "uuid"
    },
    "initialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backendID",
        "installationID",
        "initializationID",
        "stateSecretUID",
        "pvcUID",
        "endpoint",
        "image",
        "bucket",
        "pending"
      ],
      "properties": {
        "backendID": {
          "type": "string",
          "format": "uuid"
        },
        "installationID": {
          "type": "string",
          "format": "uuid"
        },
        "initializationID": {
          "type": "string",
          "format": "uuid"
        },
        "stateSecretUID": {
          "type": "string",
          "format": "uuid"
        },
        "pvcUID": {
          "type": "string",
          "format": "uuid"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"
        },
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "pending": {
          "type": "boolean"
        }
      }
    },
    "iamSecretUID": {
      "type": "string",
      "format": "uuid"
    },
    "storageUseUntil": {
      "type": "string",
      "format": "date-time"
    }
  }
}
