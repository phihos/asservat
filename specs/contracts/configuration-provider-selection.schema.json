{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/configuration-provider-selection.schema.json",
  "title": "Original configuration provider selection",
  "description": "Pre-resource original auth mount/accessor and dedicated audit Secret identity. Empty protected Secret identity can be allocated before source UID exists; no content readiness, credential, provider authority or current observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authMount",
    "authMountAccessor",
    "auditCredentials"
  ],
  "properties": {
    "authMount": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+(?![\\s\\S])",
      "not": {
        "const": "token"
      }
    },
    "authMountAccessor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+(?![\\s\\S])"
    },
    "auditCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "uid"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^asservat-[0-9a-f]{32}-worker-providers(?![\\s\\S])"
        },
        "uid": {
          "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
        }
      }
    },
    "cleanupAudit": {
      "$ref": "#/$defs/transit"
    },
    "workerConfigurationAudit": {
      "$ref": "#/$defs/transit"
    },
    "contextDeletionSigning": {
      "$ref": "#/$defs/transit"
    }
  },
  "$defs": {
    "transit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount",
        "key"
      ],
      "properties": {
        "mount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+(?![\\s\\S])",
          "not": {
            "enum": [
              "sys",
              "auth"
            ]
          }
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+(?![\\s\\S])"
        }
      }
    }
  },
  "dependentRequired": {
    "cleanupAudit": [
      "contextDeletionSigning"
    ]
  }
}
