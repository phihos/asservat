{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/recording-save.schema.json",
  "title": "Recording save scopes and projections v1",
  "$defs": {
    "policyOptIn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [],
      "description": "Defaults to true for a policy with ongoing actions (invalid without one). Shown on the policy grant review; not part of the collection execution digest (REQ-SAV-001)."
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterID": {
          "type": "string",
          "format": "uuid"
        },
        "namespaceUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "policyUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "executionDigest": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
        }
      },
      "required": [
        "clusterID",
        "namespaceUID",
        "policyUID",
        "executionDigest"
      ]
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recording_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Opaque, principal-bound handle for preview_capture(recording_handles) and watch_live(action=open, source_handles)."
        },
        "owner_kind": {
          "enum": [
            "policy",
            "manualSession"
          ]
        },
        "policy_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "capture_id": {
          "type": "string",
          "format": "uuid",
          "description": "Manual-session source: the capture that owns it."
        },
        "pod_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "kind": {
          "enum": [
            "packetCapture",
            "syscallTrace"
          ]
        },
        "state": {
          "enum": [
            "Unknown",
            "Ready",
            "Armed",
            "Warming",
            "Degraded",
            "Stopped",
            "Expired",
            "Unavailable"
          ]
        },
        "history": {
          "enum": [
            "Unknown",
            "Full",
            "Partial",
            "None"
          ]
        },
        "maximum_before": {
          "anyOf": [
            {
              "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
            },
            {
              "const": "0s"
            }
          ]
        },
        "save_eligible": {
          "type": "boolean"
        },
        "save_via": {
          "enum": [
            "recordingSave",
            "captureOutcome",
            "unavailable"
          ]
        },
        "live_projections": {
          "type": "array",
          "items": {
            "$ref": "https://asservat.io/spec/v1/live-watch.schema.json#/$defs/projection"
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Live projections watch_live can open on this source; empty when live viewing is unavailable."
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "uniqueItems": true,
          "description": "Actionable blocker codes, for example NotSaveEnabled, LiveViewDisabled or SourceStopped."
        },
        "incident_pod_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "available_before_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "hard_end": {
          "type": "string",
          "format": "date-time",
          "description": "Source hard end; watches and saves end by then."
        },
        "execution_authority": {
          "$ref": "https://asservat.io/spec/v1/policy-authority.schema.json#/$defs/summary"
        },
        "policy_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Provenance only."
        },
        "pod_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Provenance only."
        }
      },
      "required": [
        "recording_handle",
        "owner_kind",
        "pod_name",
        "action_id",
        "kind",
        "state",
        "history",
        "maximum_before",
        "save_eligible",
        "save_via",
        "live_projections",
        "blockers",
        "incident_pod_cap"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "owner_kind": {
                "const": "policy"
              }
            },
            "required": [
              "owner_kind"
            ]
          },
          "then": {
            "required": [
              "policy_name"
            ]
          },
          "else": {
            "required": [
              "capture_id"
            ],
            "properties": {
              "save_eligible": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "save_eligible": {
                "const": true
              }
            },
            "required": [
              "save_eligible"
            ]
          },
          "then": {
            "properties": {
              "save_via": {
                "const": "recordingSave"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceSessionID": {
          "type": "string",
          "format": "uuid"
        },
        "podUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "nodeUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "nodeBootID": {
          "type": "string",
          "format": "uuid"
        },
        "actionID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "kind": {
          "enum": [
            "packetCapture",
            "syscallTrace"
          ]
        },
        "sourceDefinitionDigest": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
        },
        "retainedAudienceDigest": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
        },
        "before": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
        },
        "after": {
          "const": "0s"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sourceSessionID",
        "podUID",
        "nodeUID",
        "nodeBootID",
        "actionID",
        "kind",
        "sourceDefinitionDigest",
        "retainedAudienceDigest",
        "before",
        "after",
        "maxBytes"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "recording-save/v1"
        },
        "operation": {
          "const": "recordingSave"
        },
        "captureID": {
          "type": "string",
          "format": "uuid"
        },
        "requester": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/principal"
        },
        "executor": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/principal"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clusterID": {
              "type": "string",
              "format": "uuid"
            },
            "namespaceUID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "policyUID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "executionDigest": {
              "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
            }
          },
          "required": [
            "clusterID",
            "namespaceUID",
            "policyUID",
            "executionDigest"
          ]
        },
        "workloadUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceSessionID": {
                "type": "string",
                "format": "uuid"
              },
              "podUID": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "nodeUID": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "nodeBootID": {
                "type": "string",
                "format": "uuid"
              },
              "actionID": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "kind": {
                "enum": [
                  "packetCapture",
                  "syscallTrace"
                ]
              },
              "sourceDefinitionDigest": {
                "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
              },
              "retainedAudienceDigest": {
                "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
              },
              "before": {
                "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
              },
              "after": {
                "const": "0s"
              },
              "maxBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sourceSessionID",
              "podUID",
              "nodeUID",
              "nodeBootID",
              "actionID",
              "kind",
              "sourceDefinitionDigest",
              "retainedAudienceDigest",
              "before",
              "after",
              "maxBytes"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "incidentPodLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "finalizeTimeout": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "collectionCeiling",
                  "retention"
                ]
              },
              "digest": {
                "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
              }
            },
            "required": [
              "role",
              "digest"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "operation",
        "captureID",
        "requester",
        "executor",
        "policy",
        "workloadUID",
        "sources",
        "incidentPodLimit",
        "finalizeTimeout",
        "dependencies"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "recordingPage"
        },
        "recordings": {
          "type": "array",
          "items": {
            "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/recording"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "capture_enabled": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "recordings",
        "capture_enabled",
        "expires_at"
      ]
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "recordingSavePreview"
        },
        "operation": {
          "const": "recordingSave"
        },
        "plan_digest": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash",
          "description": "Digest of the resolved recording-save/v1 plan. Submit it as request_capture expected_plan_digest with the same preview request and an idempotency key."
        },
        "selected_recordings": {
          "type": "array",
          "items": {
            "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/recording"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recording_handle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "before": {
                "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
              },
              "after": {
                "const": "0s"
              }
            },
            "required": [
              "recording_handle",
              "before",
              "after"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "capture_assessment": {
          "$ref": "https://asservat.io/spec/v1/capture-assessment.schema.json#/$defs/assessment"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 0,
          "uniqueItems": true,
          "description": "Blocker codes; NoCurrentSource when a repeated save finds no matching running source (follow navigation_uri to list_recordings)."
        },
        "navigation_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "capture_enabled": {
          "type": "boolean"
        },
        "incident_pod_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "operation",
        "plan_digest",
        "selected_recordings",
        "windows",
        "capture_assessment",
        "blockers",
        "navigation_uri",
        "capture_enabled",
        "incident_pod_cap"
      ]
    },
    "settingsRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "recordingSaveSettings"
        },
        "operation": {
          "const": "recordingSave"
        },
        "capture_id": {
          "type": "string",
          "format": "uuid"
        },
        "cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "settings_digest": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
        },
        "original_execution_digest": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "https://asservat.io/spec/v1/target.schema.json"
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clusterID": {
                  "type": "string",
                  "format": "uuid"
                },
                "namespaceUID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "policyUID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "executionDigest": {
                  "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/hash"
                }
              },
              "required": [
                "clusterID",
                "namespaceUID",
                "policyUID",
                "executionDigest"
              ]
            },
            "action_windows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "actionID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  },
                  "before": {
                    "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
                  }
                },
                "required": [
                  "actionID",
                  "before"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "target",
            "policy",
            "action_windows"
          ]
        },
        "navigation_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      },
      "required": [
        "kind",
        "operation",
        "capture_id",
        "cluster_id",
        "namespace_uid",
        "accepted_at",
        "expires_at",
        "settings_digest",
        "original_execution_digest",
        "settings",
        "navigation_uri"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/scope"
    },
    {
      "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/page"
    },
    {
      "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/preview"
    },
    {
      "$ref": "https://asservat.io/spec/v1/recording-save.schema.json#/$defs/settingsRecord"
    }
  ]
}
