{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/budget-policy.schema.json",
  "title": "Asservat EvidenceBudgetPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "asservat.io/v1alpha1"
    },
    "kind": {
      "const": "EvidenceBudgetPolicy"
    },
    "metadata": {
      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0,
          "description": "The matching policy with the highest priority applies; ties are broken by policy name."
        },
        "poolRef": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {},
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  }
                }
              },
              "required": [
                "matchLabels"
              ]
            },
            "clusters": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "description": "Cluster names; omitted, every cluster."
            }
          },
          "required": [],
          "description": "Omitted, every namespace except system namespaces, the release namespace and namespaces labelled asservat.io/evidence: disabled."
        },
        "namespaceEnvelope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxStoredBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxObjects": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": []
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protected": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "objects": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "share": {
                  "type": "string",
                  "pattern": "^(100|[1-9]?[0-9])(\\.[0-9])?%$",
                  "description": "Percentage of the pool's usable capacity (ADR-335 D2)."
                }
              },
              "required": [],
              "oneOf": [
                {
                  "required": [
                    "bytes"
                  ],
                  "not": {
                    "required": [
                      "share"
                    ]
                  }
                },
                {
                  "required": [
                    "share"
                  ],
                  "not": {
                    "required": [
                      "bytes"
                    ]
                  }
                }
              ],
              "description": "Default share 2 % (capacity.workloadShare); objects derived when omitted."
            },
            "hardLimit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "objects": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "share": {
                  "type": "string",
                  "pattern": "^(100|[1-9]?[0-9])(\\.[0-9])?%$",
                  "description": "Percentage of the pool's usable capacity (ADR-335 D2)."
                }
              },
              "required": [],
              "oneOf": [
                {
                  "required": [
                    "bytes"
                  ],
                  "not": {
                    "required": [
                      "share"
                    ]
                  }
                },
                {
                  "required": [
                    "share"
                  ],
                  "not": {
                    "required": [
                      "bytes"
                    ]
                  }
                }
              ],
              "description": "Default share 10 % (capacity.workloadLimit)."
            },
            "contextReserve": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "objects": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": []
            },
            "dump": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "burst": {
                  "const": 1
                },
                "minimumIntervalSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": []
            },
            "maxConcurrentExpensive": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "upload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bytesPerSecond": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "burstBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": []
            },
            "maxSpoolBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "onFull": {
              "enum": [
                "RejectNewExpensive",
                "DeleteOldestEligibleInAccount"
              ]
            },
            "maxActiveSources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inputBytesPerSecond": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inputBurstBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": []
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxConcurrentExpensive": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "upload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bytesPerSecond": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "burstBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": []
            },
            "maxSpoolBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxRingBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Derived from the node collector memory/scratch allocation; ring and frozen budgets share it."
            },
            "maxFrozenBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "impactProfileRef": {
              "type": "string",
              "minLength": 1
            },
            "pressureTriggers": {
              "description": "Linux PSI triggers (/proc/pressure/<resource>, 'some|full <stall> <window>'). A delivered trigger event trips the breaker for new expensive work.",
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resource": {
                    "enum": [
                      "cpu",
                      "memory",
                      "io"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "some",
                      "full"
                    ]
                  },
                  "stallMicroseconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000000
                  },
                  "windowMicroseconds": {
                    "type": "integer",
                    "minimum": 500000,
                    "maximum": 10000000
                  }
                },
                "required": [
                  "resource",
                  "kind",
                  "stallMicroseconds",
                  "windowMicroseconds"
                ]
              }
            },
            "recoverySeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 60,
              "description": "The breaker closes after this long without a new trip event."
            },
            "maxActiveSources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inputBytesPerSecond": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inputBurstBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": []
        }
      },
      "required": []
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "description": ""
}
