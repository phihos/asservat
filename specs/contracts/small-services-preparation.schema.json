{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/small-services-preparation.schema.json",
  "title": "Finite bundled service preparation public input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "asservat-small-services/v1"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 63
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 30
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "rootsPEM": {
          "type": "string",
          "maxLength": 32768
        }
      },
      "required": [
        "endpoint"
      ]
    },
    "postgres": {
      "type": "boolean"
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 63
        },
        "secretName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "hostname": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "realm": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{1,128}$"
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "consoleClientID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "browserAudience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mcpClientID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mcpRedirectURIs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]{0,251}[a-zA-Z0-9])?$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,62}$"
            },
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,62}$"
            }
          },
          "required": [
            "host",
            "port",
            "database",
            "username"
          ]
        }
      },
      "required": [
        "namespace",
        "secretName",
        "hostname",
        "realm",
        "origin",
        "consoleClientID",
        "browserAudience",
        "mcpClientID",
        "mcpRedirectURIs",
        "database"
      ]
    },
    "keycloakExternalDatabase": {
      "type": "boolean"
    },
    "objectStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "asservat-small-seaweed/v1"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 63
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 30
        },
        "image": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "format",
        "namespace",
        "name",
        "image"
      ]
    }
  },
  "required": [
    "format",
    "namespace",
    "name",
    "kubernetes",
    "postgres"
  ]
}
