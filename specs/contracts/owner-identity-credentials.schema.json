{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/owner-identity-credentials.schema.json",
  "title": "Immutable owner identity role provenance",
  "description": "Public provenance paired with one shared owner SQL credential. Before SQL use, startup proves original mounted objects and current native protection. It then authenticates and verifies each exact role, ACL and claim under the original deadline. Historical receipts alone never authorize startup.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "input",
    "rootUID",
    "setupID",
    "roles"
  ],
  "properties": {
    "format": {
      "const": "asservat-owner-identity-credentials/v1"
    },
    "input": {
      "$ref": "https://asservat.io/spec/v1/owner-identity-roles.schema.json"
    },
    "rootUID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "setupID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "claim",
          "receipt"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "owner-runtime"
            ]
          },
          "claim": {
            "$ref": "https://asservat.io/spec/v1/owner-identity-role-state.schema.json#/properties/roles/items/properties/claim"
          },
          "receipt": {
            "$ref": "https://asservat.io/spec/v1/owner-identity-role-state.schema.json#/properties/roles/items/properties/receipt"
          }
        }
      }
    }
  }
}
