{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/owner-identity-role-state.schema.json",
  "title": "Private original owner role creation journal",
  "description": "Private Secret, at most 32KiB. Exact ordered four-role material and at most five-second first SQL claims. Setup cannot outlive original resource setup. Unknown writes allow exact lookup only; no credential material is public status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "input",
    "operationID",
    "createdAt",
    "until",
    "roles"
  ],
  "properties": {
    "format": {
      "const": "asservat-owner-identity-role-state/v1"
    },
    "input": {
      "$ref": "https://asservat.io/spec/v1/owner-identity-roles.schema.json"
    },
    "operationID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "until": {
      "type": "string",
      "format": "date-time"
    },
    "roles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "password"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "enrollment",
              "audit",
              "activation",
              "registry"
            ]
          },
          "password": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "claim": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operationID",
              "claimedAt",
              "until",
              "databaseOID",
              "postmasterAt"
            ],
            "properties": {
              "operationID": {
                "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
              },
              "claimedAt": {
                "type": "string",
                "format": "date-time"
              },
              "until": {
                "type": "string",
                "format": "date-time"
              },
              "databaseOID": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "postmasterAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleName",
              "roleOID",
              "layoutDigest"
            ],
            "properties": {
              "roleName": {
                "type": "string",
                "pattern": "^as_[0-9a-f]{32}_own_0[0-3]$"
              },
              "roleOID": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "layoutDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "dependentRequired": {
          "receipt": [
            "claim"
          ]
        }
      }
    }
  }
}
