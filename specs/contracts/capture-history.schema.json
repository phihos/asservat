{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/capture-history.schema.json",
  "title": "Bounded capture history and authorized settings projections; strings are untrusted data",
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "enum": [
            "manual",
            "policy",
            "discovery"
          ]
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "phase": {
          "enum": [
            "Pending",
            "Validating",
            "AwaitingApproval",
            "Armed",
            "Queued",
            "Running",
            "Finalizing",
            "Succeeded",
            "Partial",
            "Failed",
            "Cancelled",
            "Indeterminate"
          ]
        },
        "action_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "kubernetesSnapshot",
              "logs",
              "processSnapshot",
              "fileRead",
              "packetCapture",
              "networkSnapshot",
              "runtimeDiagnostic",
              "kernelCore",
              "liveCore",
              "command",
              "httpDiagnostic",
              "artifactCollect",
              "profile",
              "syscallTrace"
            ]
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "evidence_state": {
          "enum": [
            "pending",
            "available",
            "partial",
            "expired",
            "unavailable"
          ]
        },
        "repeat_state": {
          "enum": [
            "available",
            "requiresSelection",
            "parametersExpired",
            "parametersUnavailable",
            "targetUnavailable"
          ]
        },
        "settings_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "repeated_from_capture_id": {
          "type": "string",
          "format": "uuid"
        },
        "navigation_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "operation": {
          "enum": [
            "collect",
            "recordingSave"
          ]
        },
        "requester": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "subject_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "identity_type": {
              "enum": [
                "human",
                "service",
                "policy"
              ]
            }
          },
          "required": [
            "issuer",
            "subject_id",
            "identity_type"
          ]
        }
      },
      "required": [
        "capture_id",
        "origin",
        "accepted_at",
        "summary_expires_at",
        "phase",
        "action_kinds",
        "evidence_state",
        "repeat_state",
        "navigation_uri"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "repeat_state": {
                "enum": [
                  "available",
                  "requiresSelection"
                ]
              }
            }
          },
          "then": {
            "required": [
              "settings_expires_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "recordingSave"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "origin": {
                "const": "manual"
              },
              "repeat_state": {
                "enum": [
                  "requiresSelection",
                  "parametersExpired",
                  "parametersUnavailable",
                  "targetUnavailable"
                ]
              },
              "action_kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "packetCapture",
                    "syscallTrace"
                  ]
                },
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "captureHistoryPage"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "https://asservat.io/spec/v1/capture-history.schema.json#/$defs/entry"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "ordering": {
          "const": "acceptedAtDescCaptureIDDesc"
        }
      },
      "required": [
        "kind",
        "history",
        "ordering"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "https://asservat.io/spec/v1/target.schema.json"
        },
        "recipe_spec": {
          "$ref": "https://asservat.io/spec/v1/recipe.schema.json#/properties/spec"
        },
        "dependency_pins": {
          "$ref": "https://asservat.io/spec/v1/collection-scope.schema.json#/properties/dependencies"
        },
        "requested_retention": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
        },
        "profile_composition": {
          "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json#/$defs/provenance"
        },
        "original_effective_retention": {
          "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
        }
      },
      "required": [
        "target",
        "recipe_spec",
        "dependency_pins"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "captureSettings"
        },
        "capture_id": {
          "type": "string",
          "format": "uuid"
        },
        "cluster_id": {
          "type": "string",
          "format": "uuid"
        },
        "namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "settings_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_execution_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "settings": {
          "$ref": "https://asservat.io/spec/v1/capture-history.schema.json#/$defs/settings"
        },
        "navigation_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      },
      "required": [
        "kind",
        "capture_id",
        "cluster_id",
        "namespace_uid",
        "accepted_at",
        "expires_at",
        "settings_digest",
        "original_execution_digest",
        "settings",
        "navigation_uri"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "https://asservat.io/spec/v1/capture-history.schema.json#/$defs/page"
    },
    {
      "$ref": "https://asservat.io/spec/v1/capture-history.schema.json#/$defs/record"
    }
  ]
}
