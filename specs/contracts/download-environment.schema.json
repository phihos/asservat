{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/download-environment.schema.json",
  "title": "Protected ordinary context download environment",
  "description": "Private administrator policy; observed content is not protected source acceptance or processing completeness. Exact admitted deployment paths are independently pinned. Empty clients, paths or regions explicitly deny. Kubernetes admission protection and durable processing decisions are mandatory. Optional liveRead separately enables approved transient source projections with finite scope ceilings; missing disables live. It grants no native-download or original observation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "rootID",
    "installationID",
    "recoveryEpoch",
    "revision",
    "suspended",
    "permittedRegions",
    "paths",
    "clients",
    "operators"
  ],
  "properties": {
    "format": {
      "const": "asservat-download-environment/v1"
    },
    "rootID": {
      "type": "string",
      "format": "uuid"
    },
    "installationID": {
      "type": "string",
      "format": "uuid"
    },
    "recoveryEpoch": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "suspended": {
      "type": "boolean"
    },
    "permittedRegions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "https://asservat.io/spec/v1/download-environment.schema.json#/$defs/path"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "clients": {
      "type": "array",
      "items": {
        "$ref": "https://asservat.io/spec/v1/download-environment.schema.json#/$defs/client"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "operators": {
      "type": "array",
      "items": {
        "$ref": "https://asservat.io/spec/v1/download-environment.schema.json#/$defs/operator"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "liveRead": {
      "$ref": "https://asservat.io/spec/v1/download-environment.schema.json#/$defs/liveRead"
    },
    "processors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://asservat.io/spec/v1/download-environment.schema.json#/$defs/processingOrganization"
      },
      "minItems": 0,
      "description": "Optional operator declarations for inventory reporting only. Omission means declarations were not supplied; an empty array explicitly declares none. These values grant no access or processing authority."
    },
    "installedPaths": {
      "type": "boolean",
      "description": "Helm-native: paths are the reader's installed (derived) paths; the document lists none."
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "generation",
        "sha256"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetClusterID",
        "storeID",
        "storageRegion",
        "acquisitionClusterID",
        "acquisitionRegion",
        "connectorClusterID",
        "connectorRegion",
        "hubClusterID",
        "hubRegion",
        "workerConfiguration",
        "hubConfiguration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "targetClusterID": {
          "type": "string",
          "format": "uuid"
        },
        "storeID": {
          "type": "string",
          "format": "uuid"
        },
        "storageRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "acquisitionClusterID": {
          "type": "string",
          "format": "uuid"
        },
        "acquisitionRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "connectorClusterID": {
          "type": "string",
          "format": "uuid"
        },
        "connectorRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "hubClusterID": {
          "type": "string",
          "format": "uuid"
        },
        "hubRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "workerConfiguration": {
          "$ref": "https://asservat.io/spec/v1/download-environment.schema.json#/$defs/revision"
        },
        "hubConfiguration": {
          "$ref": "https://asservat.io/spec/v1/download-environment.schema.json#/$defs/revision"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "id",
        "kind",
        "dataClasses",
        "privacyClasses",
        "evidenceTypes",
        "purposes",
        "pathIDs"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "human",
            "workload"
          ]
        },
        "dataClasses": {
          "type": "array",
          "items": {
            "enum": [
              "metadata",
              "extract",
              "raw"
            ]
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        },
        "privacyClasses": {
          "type": "array",
          "items": {
            "enum": [
              "potentialPersonalData"
            ]
          },
          "minItems": 0,
          "maxItems": 1,
          "uniqueItems": true
        },
        "evidenceTypes": {
          "type": "array",
          "items": {
            "enum": [
              "context",
              "packetCapture",
              "syscallTrace",
              "profile",
              "logs"
            ]
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        },
        "purposes": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "pathIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "installedPaths": {
          "type": "boolean",
          "description": "Helm-native: the client's pathIDs are every installed path; it lists none."
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "clientID",
        "kind",
        "id"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "clientID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "User",
            "Group"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "liveRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projections",
        "clients",
        "ceilings",
        "root"
      ],
      "properties": {
        "projections": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "packetMetadata",
              "syscallMetadata",
              "httpHeaders"
            ]
          }
        },
        "clients": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuer",
              "id",
              "kind",
              "pathIDs"
            ],
            "properties": {
              "issuer": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "enum": [
                  "human",
                  "workload"
                ]
              },
              "pathIDs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "ceilings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clusterID",
              "bytesPerSecond",
              "maxRowsPerBatch",
              "maxBufferBytes",
              "replaySeconds"
            ],
            "properties": {
              "clusterID": {
                "type": "string",
                "format": "uuid"
              },
              "namespaceUID": {
                "type": "string",
                "format": "uuid"
              },
              "workloadUID": {
                "type": "string",
                "format": "uuid"
              },
              "bytesPerSecond": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Per-watch rate; the default is derived from the connector link bandwidth and the hub-api memory request divided by the expected concurrent watches."
              },
              "maxRowsPerBatch": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "maxBufferBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Per-watch transient buffer; bounds replay. Derived from the hub-api memory request \u00f7 expected concurrent watches."
              },
              "replaySeconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Replay window; the buffer (maxBufferBytes) bounds what is actually kept."
              }
            },
            "dependentRequired": {
              "workloadUID": [
                "namespaceUID"
              ]
            }
          }
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytesPerSecond",
            "burstBytes"
          ],
          "properties": {
            "bytesPerSecond": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "burstBytes": {
              "type": "integer",
              "minimum": 24576,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "processingOrganization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "activities",
        "regions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
          }
        },
        "regions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
          }
        }
      }
    }
  }
}
