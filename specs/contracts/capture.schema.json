{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/capture.schema.json",
  "title": "Asservat capture v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "asservat.io/v1alpha1"
    },
    "kind": {
      "const": "DebugCapture"
    },
    "metadata": {
      "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/metadata"
    },
    "spec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "https://asservat.io/spec/v1/target.schema.json"
            },
            "recipeRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Optional provenance pin; the hub resolves the recipe by name and records the digest (ADR-335 D4)."
                }
              },
              "required": [
                "name"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Optional; shown to approvers."
            },
            "caseID": {
              "type": "string",
              "format": "uuid"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1,
              "description": "Browser/MCP replay key; Kubernetes writes use the object UID and generation."
            },
            "deadline": {
              "type": "string",
              "format": "date-time",
              "description": "Optional; omitted, the hub computes it at acceptance from the requested durations."
            },
            "sharing": {
              "$ref": "https://asservat.io/spec/v1/sharing-request.schema.json#/$defs/capture"
            },
            "resultAccess": {
              "$ref": "https://asservat.io/spec/v1/investigation-access.schema.json#/$defs/request"
            },
            "retention": {
              "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
            }
          },
          "required": [
            "target",
            "recipeRef"
          ]
        },
        {
          "$ref": "https://asservat.io/spec/v1/preset-input.schema.json#/$defs/capture"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "https://asservat.io/spec/v1/target.schema.json"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Optional; shown to approvers."
            },
            "caseID": {
              "type": "string",
              "format": "uuid"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1,
              "description": "Browser/MCP replay key; Kubernetes writes use the object UID and generation."
            },
            "deadline": {
              "type": "string",
              "format": "date-time",
              "description": "Optional; omitted, the hub computes it at acceptance from the requested durations."
            },
            "sharing": {
              "$ref": "https://asservat.io/spec/v1/sharing-request.schema.json#/$defs/capture"
            },
            "profileComposition": {
              "$ref": "https://asservat.io/spec/v1/capture-composition.schema.json"
            },
            "resultAccess": {
              "$ref": "https://asservat.io/spec/v1/investigation-access.schema.json#/$defs/request"
            },
            "retention": {
              "$ref": "https://asservat.io/spec/v1/common.schema.json#/$defs/duration"
            }
          },
          "required": [
            "target",
            "profileComposition"
          ]
        }
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
