{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/worker-control.schema.json",
  "title": "Pinned acquisition worker startup control",
  "description": "Immutable worker.json. Credential-only v1 or explicit native v2. Public CA DER only, 32 KiB combined across all trust sets, 64 KiB JSON. Exact digest, current trust and accepted profile required; no authority from shape validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "installationID",
    "clusterID",
    "endpoint",
    "serverRoots",
    "issuerRoots"
  ],
  "properties": {
    "format": {
      "enum": [
        "asservat-worker-control/v1",
        "asservat-worker-control/v2"
      ]
    },
    "installationID": {
      "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
    },
    "clusterID": {
      "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
    },
    "endpoint": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^/@?#\\s]+/?(?![\\s\\S])"
    },
    "address": {
      "description": "Optional connectivity-only host:port dialed for endpoint (ADR-204 decision 9). TLS name and HTTP authority remain the endpoint's. Omit rather than send an empty string; runtime also requires a port of 1-65535.",
      "type": "string",
      "maxLength": 262,
      "pattern": "^(?:[^/\\\\@?#%\\[\\]\\s:]{1,253}|\\[[0-9A-Fa-f:.]+\\]):[1-9][0-9]{0,4}(?![\\s\\S])"
    },
    "serverRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 21848,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
      }
    },
    "issuerRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 21848,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exchangeEndpoint",
        "exchangeServerRoots",
        "objectStore",
        "keyService"
      ],
      "properties": {
        "format": {
          "const": "asservat-context-native-startup/v1"
        },
        "exchangeEndpoint": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^/@?#\\s]+/internal/download-native/v1/worker(?![\\s\\S])"
        },
        "exchangeAddress": {
          "description": "Optional connectivity-only host:port dialed for exchangeEndpoint, with the meaning of the top-level address.",
          "type": "string",
          "maxLength": 262,
          "pattern": "^(?:[^/\\\\@?#%\\[\\]\\s:]{1,253}|\\[[0-9A-Fa-f:.]+\\]):[1-9][0-9]{0,4}(?![\\s\\S])"
        },
        "exchangeServerRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 21848,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
          }
        },
        "objectStore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "endpoint",
            "region",
            "bucket",
            "serverRoots",
            "credentialSecretName",
            "credentialSecretUID"
          ],
          "properties": {
            "id": {
              "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
            },
            "endpoint": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://[^/@?#\\s]+/?(?![\\s\\S])"
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}(?![\\s\\S])"
            },
            "bucket": {
              "type": "string",
              "minLength": 3,
              "maxLength": 63,
              "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](?![\\s\\S])"
            },
            "serverRoots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 4,
                "maxLength": 21848,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
              }
            },
            "credentialSecretName": {
              "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/name"
            },
            "credentialSecretUID": {
              "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
            }
          }
        },
        "keyService": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "serverRoots",
            "scope"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://[^/@?#\\s]+/?(?![\\s\\S])"
            },
            "serverRoots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 4,
                "maxLength": 21848,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
              }
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "installationID",
                "purpose",
                "keyID"
              ],
              "properties": {
                "installationID": {
                  "$ref": "https://asservat.io/spec/v1/worker-configuration.schema.json#/$defs/uuid"
                },
                "purpose": {
                  "const": "artifact"
                },
                "keyID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "format": {
          "const": "asservat-worker-control/v1"
        }
      },
      "not": {
        "required": [
          "native"
        ]
      }
    },
    {
      "properties": {
        "format": {
          "const": "asservat-worker-control/v2"
        }
      },
      "required": [
        "native"
      ]
    }
  ]
}
