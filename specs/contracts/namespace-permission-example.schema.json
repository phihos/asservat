{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/namespace-permission-example.schema.json",
  "title": "Bounded illustrative Namespace metadata; not the Kubernetes API schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "v1"
    },
    "kind": {
      "const": "Namespace"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ]
}
