{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/initial-provider-material.schema.json",
  "title": "Immutable private initial provider material",
  "description": "At most 8 KiB, independently pinned bootstrap Secret. Issuer remains outside activation Pod. Storage use-until is a local use bound, not proof of external credential expiry or revocation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "installationID",
    "requestID",
    "issuerToken",
    "storage",
    "storageUseUntil"
  ],
  "properties": {
    "format": {
      "const": "asservat-initial-provider-material/v1"
    },
    "installationID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "requestID": {
      "$ref": "https://asservat.io/spec/v1/owner-configuration.schema.json#/$defs/uuid"
    },
    "issuerToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[!-~]+$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessKeyID",
        "secretAccessKey",
        "sessionToken"
      ],
      "properties": {
        "accessKeyID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[!-~]+$"
        },
        "secretAccessKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[!-~]+$"
        },
        "sessionToken": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096,
          "pattern": "^[!-~]*$"
        }
      }
    },
    "storageUseUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "registryConfig": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5464,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "Canonical base64 of at most 4096 bytes normalized single-registry Docker config, permitted only by the original dockerconfigjson/v1 workload capability. Counts toward the unchanged aggregate 8 KiB material limit. Never public, logged or mounted into activation."
    }
  }
}
