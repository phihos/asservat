{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asservat.io/spec/v1/local-key-secret.schema.json",
  "title": "Private local key-service Secret payload v1",
  "description": "Sensitive installation-owned Secret payload, never Helm values or a public API. Purpose/scope must match independent protected configuration. Runtime additionally requires distinct key versions/material and a present active version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "installationID", "purpose", "keyID", "activeVersion", "keys"],
  "properties": {
    "format": {"const": "asservat-local-keys/v1"},
    "installationID": {
      "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {"const": "00000000-0000-0000-0000-000000000000"}
    },
    "purpose": {"enum": ["artifact", "audit", "browser-credentials", "policy-submission"]},
    "keyID": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$"},
    "activeVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "material"],
        "properties": {
          "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "material": {
            "type": "string", "minLength": 44, "maxLength": 44,
            "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$",
            "not": {"const": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="},
            "description": "Canonical base64 of 32 random bytes; encryption key or purpose-specific Ed25519 seed. Never copy a published fixture into an installation."
          }
        }
      }
    }
  }
}
